{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      // `@/kit/*` falls through to `@maipai/ui`'s own `src/` after Home's
      // own residual kit (assistant-ui, the couple of pieces that stay
      // Home-specific): `@maipai/ui`'s source is subpath-imported
      // directly (no dist build, per its own no-barrel convention), so
      // its internal files still use ITS OWN tsconfig's `@/kit/*` alias
      // (`../../commons/ui/tsconfig.json`) - a single `tsc` run has one
      // `paths` table for the whole program, so this repo's copy has to
      // know both meanings, tried in order. The fallback goes through
      // `./node_modules/@maipai/ui/src/*` (the installed symlink), not
      // a raw relative path straight into `../../commons/ui/src/*`: a
      // raw relative path opens the file from OUTSIDE bun's own
      // dependency graph entirely, and commons/ui's own `@types/react`
      // (a separate devDependency install, a different physical copy
      // than Home's) then wins the walk-up lookup instead of the one
      // the installed `@maipai/ui` package already unifies with Home's,
      // causing "two different types with this name exist" on every
      // ref-typed prop (found live building this exact fallback).
      "@/kit/*": ["./src/kit/*", "./node_modules/@maipai/ui/src/*"],
      // CHAT-SDK-01: the vendored assistant-ui Elements (`@maipai/ui`'s
      // own `src/elements/`) use `@/elements/*` the same way - their
      // own registry's vendoring convention (checked live: 8 files, all
      // under `src/elements/`), not this repo's. A single `paths`
      // target is enough here, unlike `@/kit/*`'s two-target fallback
      // above: Home has no `src/elements/` of its own (checked live)
      // for this to collide with, so there is only one meaning to
      // resolve, ever - `vite.config.ts`'s `kitElementsAliasPlugin` is
      // Rolldown's side of the identical mapping (it also handles a
      // parallel `@/components/*` the registry's other flavors use
      // elsewhere, unused in this kit's own vendored tree today - no
      // `paths` entry for it here until something actually needs one).
      "@/elements/*": ["./node_modules/@maipai/ui/src/elements/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests"]
}
