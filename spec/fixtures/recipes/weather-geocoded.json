{
  "description": "The real backend/packages/weather/recipe.json (2026-09-05, the first real plugin built on host.fetch): geocode a place name, then forecast its coordinates, using response shapes captured from a real Open-Meteo call.",
  "recipe": {
    "id": "weather",
    "inputs": [{ "name": "place", "selector": "text" }],
    "steps": [
      {
        "op": "fetch",
        "as": "geo",
        "url": "https://geocoding-api.open-meteo.com/v1/search?count=1&name={place}",
        "method": "GET"
      },
      { "op": "pick", "as": "lat", "from": "geo", "path": "results.0.latitude" },
      { "op": "pick", "as": "lon", "from": "geo", "path": "results.0.longitude" },
      { "op": "pick", "as": "place_name", "from": "geo", "path": "results.0.name" },
      {
        "op": "fetch",
        "as": "wx",
        "url": "https://api.open-meteo.com/v1/forecast?latitude={lat}&longitude={lon}&current=temperature_2m&temperature_unit=fahrenheit",
        "method": "GET"
      },
      { "op": "pick", "as": "temp", "from": "wx", "path": "current.temperature_2m" },
      {
        "op": "format",
        "as": "reply",
        "text": "It's {temp} degrees in {place_name}.",
        "speech": "It's {temp} degrees in {place_name} right now."
      }
    ]
  },
  "inputs": { "place": "Seattle" },
  "host_setup": {
    "fetch": {
      "https://geocoding-api.open-meteo.com/v1/search?count=1&name=Seattle": {
        "results": [
          { "id": 5809844, "name": "Seattle", "latitude": 47.60621, "longitude": -122.33207, "country": "United States" }
        ]
      },
      "https://api.open-meteo.com/v1/forecast?latitude=47.60621&longitude=-122.33207&current=temperature_2m&temperature_unit=fahrenheit": {
        "current": { "time": "2026-09-05T05:30", "temperature_2m": 57.3 }
      }
    }
  },
  "expected": {
    "reply": {
      "text": "It's 57.3 degrees in Seattle.",
      "speech": "It's 57.3 degrees in Seattle right now."
    },
    "actions": [],
    "scheduled_jobs": [],
    "home_calls": [],
    "memory_added": []
  }
}
