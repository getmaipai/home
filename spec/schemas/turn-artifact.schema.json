{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getmaipai.github.io/home/spec/schemas/turn-artifact.schema.json",
  "title": "TurnArtifact",
  "description": "COMP-01's immutable details document for one assistant turn. The section is built from retained typed outcomes, not model prose. A changed evidence version creates a new revision; an existing revision is never edited in place.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "turn_id",
    "revision",
    "evidence_version",
    "section",
    "sources",
    "provenance",
    "created_at",
    "hlc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^doc-[a-z0-9]{6,}$",
      "description": "Stable identity for this document revision. A later revision has a new id."
    },
    "turn_id": {
      "type": "string",
      "pattern": "^turn-[a-z0-9]{6,}$",
      "description": "The assistant turn whose retained outcomes produced this document."
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "One-based revision number for a living document on the same subject."
    },
    "evidence_version": {
      "type": "string",
      "minLength": 1,
      "description": "Stable version of the retained outcome evidence used to build this revision."
    },
    "section": {
      "oneOf": [
        { "$ref": "#/$defs/lookup" },
        { "$ref": "#/$defs/card" },
        { "$ref": "#/$defs/procedure" },
        { "$ref": "#/$defs/comparison" }
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "source.schema.json" },
      "description": "The citation snapshots available to this document. Child-band delivery strips this list without widening the content ceiling."
    },
    "provenance": {
      "type": "string",
      "minLength": 1,
      "description": "Free-text provenance for the build, such as the composer run or the originating outcome."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "hlc": {
      "type": "string",
      "pattern": "^[0-9]+:[0-9]+:[a-z0-9]{6,}$",
      "description": "Hybrid logical clock: wall_ms:counter:node (7.3)."
    }
  },
  "$defs": {
    "source_id": {
      "type": "string",
      "pattern": "^src-[a-z0-9]{6,}$",
      "description": "The id of a citation in the document's top-level sources array."
    },
    "artifact_subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^subject-[a-z0-9]{6,}$" },
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "artifact_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "value"],
      "properties": {
        "subject_id": { "type": "string", "pattern": "^subject-[a-z0-9]{6,}$" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "artifact_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attribute", "values"],
      "properties": {
        "attribute": { "type": "string", "minLength": 1 },
        "values": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/artifact_value" }
        }
      }
    },
    "lookup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "query", "results"],
      "properties": {
        "type": { "const": "lookup" },
        "query": {
          "type": "string",
          "minLength": 1,
          "description": "The bounded lookup expression that produced the result list."
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "title": "LookupResult",
            "additionalProperties": false,
            "required": ["title", "line", "source_id"],
            "properties": {
              "title": { "type": "string", "minLength": 1 },
              "line": {
                "type": "string",
                "minLength": 1,
                "description": "One source-backed line for the result, never a model-authored paragraph."
              },
              "source_id": { "$ref": "#/$defs/source_id" }
            }
          }
        }
      }
    },
    "card": {
      "oneOf": [
        { "$ref": "#/$defs/film_card" },
        { "$ref": "#/$defs/person_card" },
        { "$ref": "#/$defs/place_card" }
      ]
    },
    "film_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "name", "year", "director", "genres", "source_id"],
      "properties": {
        "type": { "const": "card" },
        "kind": { "const": "film" },
        "name": { "type": "string", "minLength": 1 },
        "year": { "type": ["integer", "null"], "minimum": 1888, "default": null },
        "director": { "type": ["string", "null"], "minLength": 1, "default": null },
        "genres": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "source_id": { "$ref": "#/$defs/source_id" }
      }
    },
    "person_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "name", "occupation", "known_for", "source_id"],
      "properties": {
        "type": { "const": "card" },
        "kind": { "const": "person" },
        "name": { "type": "string", "minLength": 1 },
        "occupation": { "type": ["string", "null"], "minLength": 1, "default": null },
        "known_for": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "default": []
        },
        "source_id": { "$ref": "#/$defs/source_id" }
      }
    },
    "place_card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "kind", "name", "region", "country", "source_id"],
      "properties": {
        "type": { "const": "card" },
        "kind": { "const": "place" },
        "name": { "type": "string", "minLength": 1 },
        "region": { "type": ["string", "null"], "minLength": 1, "default": null },
        "country": { "type": ["string", "null"], "minLength": 1, "default": null },
        "source_id": { "$ref": "#/$defs/source_id" }
      }
    },
    "procedure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "steps"],
      "properties": {
        "type": { "const": "procedure" },
        "title": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "title": "ProcedureStep",
            "additionalProperties": false,
            "required": ["position", "instruction", "quantities"],
            "properties": {
              "position": { "type": "integer", "minimum": 1 },
              "instruction": { "type": "string", "minLength": 1 },
              "quantities": {
                "type": "array",
                "items": {
                  "type": "object",
                  "title": "ProcedureQuantity",
                  "additionalProperties": false,
                  "required": ["amount", "unit", "item"],
                  "properties": {
                    "amount": { "type": ["number", "string"], "minLength": 1 },
                    "unit": { "type": "string", "minLength": 1 },
                    "item": { "type": "string", "minLength": 1 }
                  }
                },
                "default": []
              }
            }
          }
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "title", "subjects", "rows"],
      "properties": {
        "type": { "const": "comparison" },
        "title": { "type": "string", "minLength": 1 },
        "subjects": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/artifact_subject" }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/artifact_row" }
        }
      }
    }
  }
}
