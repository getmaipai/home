{
  "name": "@maipai/home-backend",
  "version": "0.1.0",
  "private": true,
  "description": "MaiPai Home hub server: identity and sign-in, people, the household API. See docs/dev.md.",
  "license": "AGPL-3.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "gen:settings": "bun run scripts/gen-settings-registry.ts",
    "gen:api-docs": "bun run scripts/gen-api-docs.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@maipai/spec": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@scalar/hono-api-reference": "^0.12.0",
    "ajv": "^8.20.0",
    "drizzle-orm": "^0.44.6",
    "hono": "^4.10.7",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.6",
    "typescript": "^5.9.3",
    "@types/bun": "^1.3.0"
  }
}
