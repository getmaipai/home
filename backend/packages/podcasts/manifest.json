  "description": "Listen to the shows your home follows: new episodes play right away from the show, and a copy saved on the hub plays with the internet off.",
  "routing": {
    "examples": [
      "open podcasts",
      "play the newest episode of my podcast",
      "continue my podcast",
      "what is in my podcast queue",
      "which podcast episodes are saved on the hub"
    ],
    "patterns": []
  },
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
