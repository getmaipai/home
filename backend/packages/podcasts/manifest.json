      "groups": [
        {
          "label": "Podcasts",
          "sections": [
            "speed",
            "storage"
          ]
        }
      ],
      "sections": [
        {
          "id": "speed",
          "label": "Podcast speed",
          "icon": "gauge",
          "kind": "link",
          "href": "/settings/account/voice",
          "keywords": [
            "playback",
            "speed",
            "faster",
            "slower"
          ]
        },
        {
          "id": "storage",
          "label": "Saved episodes and storage",
          "icon": "hard-drive",
          "kind": "link",
          "href": "/settings/home/storage",
          "min_role": "admin",
          "keywords": [
            "saved copies",
            "episodes",
            "trash"
          ]
        }
      ]
    }
