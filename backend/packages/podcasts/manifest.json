        "icon": "headphones",
        "nav": true,
        "kind": "schema",
        "module": "episodes"
      },
      {
        "id": "queue",
        "label": "Queue",
        "icon": "list",
        "nav": true,
        "kind": "schema",
        "module": "queue"
      },
      {
        "id": "saved",
        "label": "Saved",
        "icon": "hard-drive",
        "nav": true,
        "kind": "schema",
        "module": "saved"
      },
      {
        "id": "play",
        "label": "Listen",
        "icon": "play",
        "nav": false,
