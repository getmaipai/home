{
  "type": "page",
  "id": "podcasts-history",
  "title": "History",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Recently played",
      "bind": {
        "source": "package",
        "path": "episodes",
        "params": {
          "scope": "history"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_meta_field": "duration_s",
      "item_media_field": "thumbnail",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "density": "default",
      "on_select": {
        "navigate": {
          "to": "/apps/podcasts/episode",
          "state": {
            "id": "{id}"
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "history",
        "text": "You have not played any episodes yet."
      }
    }
  ]
}
