{
  "type": "page",
  "id": "play",
  "title": "Listen",
  "body": [
    {
      "type": "split_view",
      "aside_label": "Up next",
      "main": [
        {
          "type": "player",
          "bind": {
            "source": "package",
            "path": "item",
            "params": {
              "scope": "item",
              "id": "$state.id"
            }
          },
          "kind": "audio",
          "autoplay_next": true,
          "details": true,
          "details_show": ["title", "facts", "description", "chapters"],
          "actions": [
            {
              "label": "Add to queue",
              "icon": "list-video",
              "field": "queued",
              "on_label": "In your queue",
              "action": {
                "call": {
                  "target": "/api/plugins/podcasts/queue",
                  "args": {
                    "media_id": "{id}",
                    "on": "{on}"
                  }
                }
              }
            },
            {
              "label": "Save on the hub",
              "icon": "hard-drive",
              "field": "saved",
              "on_label": "Saved on the hub",
              "action": {
                "call": {
                  "target": "/api/plugins/podcasts/save",
                  "args": {
                    "media_id": "{id}",
                    "on": "{on}"
                  }
                }
              }
            },
            {
              "label": "Bookmark",
              "icon": "bookmark",
              "action": {
                "call": {
                  "target": "/api/plugins/podcasts/bookmark",
                  "args": {
                    "media_id": "{id}"
                  }
                }
              }
            }
          ],
          "on_progress": {
            "call": {
              "target": "/api/plugins/podcasts/progress",
              "args": {
                "media_id": "{id}",
                "position_s": "{position_s}",
                "duration_s": "{duration_s}",
                "reason": "{reason}"
              }
            }
          },
          "on_next": {
            "play": {
              "media_id": "{id}"
            }
          },
          "empty_state": {
            "type": "empty_state",
            "icon": "headphones",
            "text": "This episode is not here any more. Go back to Podcasts and pick another."
          },
          "fields": {
            "description": "description",
            "facts": "facts"
          },
          "edit": {
            "label": "Edit",
            "title": "Edit episode",
            "visible_field": "can_edit",
            "cover_choices_field": "cover_choices",
            "fields": [
              {
                "name": "title",
                "kind": "text",
                "label": "Title"
              },
              {
                "name": "description",
                "kind": "textarea",
                "label": "Description"
              },
              {
                "name": "cover",
                "kind": "cover",
                "label": "Cover"
              }
            ],
            "on_save": {
              "call": {
                "target": "/api/plugins/podcasts/actions/edit",
                "args": {
                  "id": "{id}",
                  "title": "{title}",
                  "description": "{description}",
                  "artwork": "{cover}"
                }
              }
            },
            "on_upload": {
              "call": {
                "target": "/api/plugins/podcasts/actions/cover",
                "args": {
                  "id": "{id}",
                  "file": "{file}"
                }
              }
            }
          }
        }
      ],
      "aside": [
        {
          "type": "media_shelf",
          "heading": "Up next",
          "bind": {
            "source": "package",
            "path": "up-next",
            "params": {
              "id": "$state.id"
            }
          },
          "item_key_field": "id",
          "item_label_field": "title",
          "item_subtitle_field": "{channel}",
          "item_media_field": "thumbnail",
          "item_progress_field": "progress",
          "item_badge_field": "copy_label",
          "item_meta_field": "duration_s",
          "aspect": "square",
          "variant": "plain",
          "orientation": "vertical",
          "hide_when_empty": true,
          "on_select": {
            "play": {
              "media_id": "{id}"
            }
          }
        }
      ],
      "aside_sheet": "phone"
    }
  ]
}
