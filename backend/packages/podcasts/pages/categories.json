{
  "type": "page",
  "id": "categories",
  "title": "Categories",
  "body": [
    {
      "type": "list",
      "bind": { "source": "package", "path": "directory", "params": { "scope": "categories" } },
      "item_key_field": "id",
      "item_label_field": "title",
      "row_action": { "icon": "arrow-right", "label": "Browse {title}", "action": { "navigate": { "to": "/apps/podcasts/search", "state": { "genre": "{id}", "category": "{title}" } } } },
      "empty_state": { "type": "empty_state", "icon": "compass", "text": "Podcast categories are unavailable right now.", "action": { "navigate": { "to": "/apps/podcasts/search" } }, "action_label": "Search podcasts" }
    }
  ]
}
