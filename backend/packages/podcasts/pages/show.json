{
  "type": "page",
  "id": "show",
  "title": "Podcast show",
  "body": [
    {
      "type": "list",
      "bind": {
        "source": "package",
        "path": "directory",
        "params": {
          "scope": "show",
          "id": "$state.id"
        }
      },
      "hide_when_empty": true,
      "item_key_field": "id",
      "item_label_field": "description",
      "item_badge_field": "action_label",
      "row_action": {
        "icon": "play",
        "label": "{action_label}",
        "action": {
          "call": {
            "target": "/api/plugins/podcasts/shows/{production_id}/episodes",
            "args": {}
          }
        }
      }
    },
    {
      "type": "billboard",
      "bind": {
        "source": "package",
        "path": "directory",
        "params": {
          "scope": "show",
          "id": "$state.id",
          "follow": "no"
        }
      },
      "label": "Podcasts",
      "size": "hero",
      "autoplay": false,
      "item_key_field": "id",
      "item_title_field": "title",
      "item_subtitle_field": "{author} · {genre}",
      "item_art_field": "thumbnail",
      "primary": {
        "label": "Follow",
        "icon": "plus",
        "action": {
          "call": {
            "target": "/api/plugins/podcasts/directory/add",
            "args": {
              "url": "{feed_url}"
            }
          }
        }
      },
      "hide_when_empty": true,
      "secondary": []
    },
    {
      "type": "billboard",
      "bind": {
        "source": "package",
        "path": "directory",
        "params": {
          "scope": "show",
          "id": "$state.id",
          "follow": "yes"
        }
      },
      "label": "Podcasts",
      "size": "hero",
      "autoplay": false,
      "item_key_field": "id",
      "item_title_field": "title",
      "item_subtitle_field": "{author} · {genre}",
      "item_art_field": "thumbnail",
      "primary": {
        "label": "Following",
        "icon": "check",
        "action": {
          "confirm": {
            "prompt": "Stop following {title}? Saved episodes stay on the hub and the show moves to Unfollowed in Shows.",
            "on_confirm": {
              "call": {
                "target": "/api/plugins/podcasts/directory/remove",
                "args": {
                  "source_id": "{id}"
                }
              }
            }
          }
        }
      },
      "hide_when_empty": true,
      "secondary": []
    },
    {
      "type": "media_shelf",
      "heading": "About",
      "bind": {
        "source": "package",
        "path": "directory",
        "params": {
          "scope": "show",
          "id": "$state.id"
        }
      },
      "item_key_field": "id",
      "item_label_field": "description",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "hide_when_empty": true,
      "item_media_field": "thumbnail",
      "density": "compact"
    },
    {
      "type": "media_shelf",
      "heading": "On the hub",
      "bind": {
        "source": "package",
        "path": "directory",
        "params": {
          "scope": "show-saved",
          "id": "$state.id"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_media_field": "thumbnail",
      "item_subtitle_field": "{description}",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "density": "compact",
      "hide_when_empty": true,
      "row_actions": [
        {
          "icon": "download",
          "label": "Save new episodes",
          "label_field": "auto_label",
          "show_when_field": "can_manage",
          "action": {
            "call": {
              "target": "/api/plugins/podcasts/show-auto",
              "args": {
                "source_id": "{id}",
                "on": "{auto_next}"
              }
            }
          }
        },
        {
          "icon": "check",
          "label": "Mark all played",
          "action": {
            "call": {
              "target": "/api/plugins/podcasts/played-all",
              "args": {
                "source_id": "{id}",
                "on": true
              },
              "success_label": "Marked all as played"
            }
          }
        },
        {
          "icon": "circle-dot",
          "label": "Mark all unplayed",
          "action": {
            "call": {
              "target": "/api/plugins/podcasts/played-all",
              "args": {
                "source_id": "{id}",
                "on": false
              },
              "success_label": "Marked all as unplayed"
            }
          }
        }
      ]
    },
    {
      "type": "picker",
      "state": "order",
      "label": "Order",
      "variant": "pill",
      "placeholder": "Latest",
      "leading": [
        {
          "value": "latest",
          "label": "Latest"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "seasons",
          "label": "Seasons"
        }
      ]
    },
    {
      "type": "section",
      "condition": "order == 'seasons'",
      "children": [
        {
          "type": "picker",
          "state": "season",
          "label": "Season",
          "variant": "pill",
          "placeholder": "Newest season",
          "bind": {
            "source": "package",
            "path": "directory",
            "params": {
              "scope": "show-seasons",
              "id": "$state.id"
            }
          },
          "item_key_field": "id",
          "item_label_field": "label"
        }
      ]
    },
    {
      "type": "media_shelf",
      "heading": "Episodes",
      "bind": {
        "source": "package",
        "path": "directory",
        "params": {
          "scope": "show-episodes",
          "id": "$state.id",
          "sort": "$state.order",
          "season": "$state.season"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{date} · {description}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "item_badge_field": "unplayed",
      "aspect": "wide",
      "variant": "plain",
      "orientation": "vertical",
      "on_select": {
        "navigate": {
          "to": "/apps/podcasts/episode",
          "state": {
            "id": "{id}"
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "headphones",
        "text": "No episodes here yet. A followed show checks for new ones about every hour; Latest shows every episode it has.",
        "action": {
          "navigate": {
            "to": "/apps/podcasts/shows"
          }
        },
        "action_label": "Open Shows"
      },
      "row_actions": [
        {
          "icon": "play",
          "label": "Play",
          "action": {
            "play": {
              "media_id": "{id}"
            }
          }
        },
        {
          "icon": "list-video",
          "label": "Add to queue",
          "label_field": "queue_label",
          "show_when_field": "can_act",
          "action": {
            "call": {
              "target": "/api/plugins/podcasts/queue",
              "args": {
                "media_id": "{id}",
                "on": "{queue_next}"
              }
            }
          }
        },
        {
          "icon": "check",
          "label": "Mark played",
          "label_field": "played_label",
          "show_when_field": "can_act",
          "action": {
            "call": {
              "target": "/api/plugins/podcasts/played",
              "args": {
                "media_id": "{id}",
                "on": "{played_next}"
              }
            }
          }
        }
      ],
      "item_badge_presentation": "dot"
    }
  ]
}
