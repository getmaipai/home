{
  "type": "page",
  "id": "episodes",
  "title": "Episodes",
  "body": [
    {
      "type": "picker",
      "state": "show",
      "label": "Show",
      "placeholder": "All shows",
      "bind": {
        "source": "package",
        "path": "channels"
      },
      "item_key_field": "id",
      "item_label_field": "label"
    },
    {
      "type": "search",
      "state": "transcript_q",
      "label": "Search transcripts",
      "placeholder": "Search transcripts"
    },
    {
      "type": "media_shelf",
      "heading": "Episodes",
      "bind": {
        "source": "package",
        "path": "episodes",
        "params": {
          "channel": "$state.show"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "badge",
      "item_meta_field": "duration_s",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "headphones",
        "text": "No episodes yet. Follow a show and its episodes appear here.",
        "action": {
          "navigate": {
            "to": "/apps/podcasts/search"
          }
        },
        "action_label": "Find shows"
      },
      "row_actions": [
        {
          "icon": "list-video",
          "label": "Add to queue",
          "label_field": "queue_label",
          "action": {
            "call": {
              "target": "/api/plugins/podcasts/queue",
              "args": {
                "media_id": "{id}",
                "on": "{queue_next}"
              }
            }
          }
        },
        {
          "icon": "check",
          "label": "Mark played",
          "label_field": "played_label",
          "action": {
            "call": {
              "target": "/api/plugins/podcasts/played",
              "args": {
                "media_id": "{id}",
                "on": "{played_next}"
              }
            }
          }
        }
      ]
    },
    {
      "type": "media_shelf",
      "heading": "Transcript matches",
      "bind": {
        "source": "package",
        "path": "episodes",
        "params": {
          "query": "$state.transcript_q"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "summary",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "hide_when_empty": true,
      "on_select": {
        "play": {
          "media_id": "{id}",
          "position_s": "{start_s}"
        }
      }
    }
  ]
}
