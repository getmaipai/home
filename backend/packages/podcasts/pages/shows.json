{
  "type": "page",
  "id": "shows",
  "title": "Shows",
  "body": [
    {
      "type": "picker",
      "state": "follow",
      "label": "Shows",
      "variant": "pill",
      "placeholder": "Followed",
      "leading": [
        {
          "value": "followed",
          "label": "Followed"
        },
        {
          "value": "unfollowed",
          "label": "Unfollowed"
        },
        {
          "value": "downloaded",
          "label": "Downloaded"
        }
      ]
    },
    {
      "type": "media_shelf",
      "heading": "Shows",
      "bind": {
        "source": "package",
        "path": "shows",
        "params": {
          "scope": "$state.follow"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{summary}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "on_select": {
        "navigate": {
          "to": "/apps/podcasts/show",
          "state": {
            "id": "{id}"
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "mic",
        "text": "No shows here. Follow a show from Podcasts, or make your own with New show.",
        "action": {
          "navigate": {
            "to": "/apps/podcasts/new-show"
          }
        },
        "action_label": "New show"
      }
    }
  ]
}
