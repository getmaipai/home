{
  "type": "page",
  "id": "saved",
  "title": "Saved",
  "tone": "cinema",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Saved on the hub",
      "bind": {
        "source": "package",
        "path": "saved"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "hard-drive",
        "text": "Nothing saved yet. Choose Save on the hub on an episode to keep a copy that plays without the internet."
      }
    },
    {
      "type": "media_shelf",
      "heading": "Bookmarks",
      "bind": {
        "source": "package",
        "path": "bookmarks"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "hide_when_empty": true,
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      }
    }
  ]
}
