{
  "id": "weather",
  "inputs": [
    {
      "name": "place",
      "selector": "text",
      "required": false
    },
    {
      "name": "latitude",
      "selector": "number",
      "required": false
    },
    {
      "name": "longitude",
      "selector": "number",
      "required": false
    },
    {
      "name": "unit",
      "selector": "select",
      "required": false
    }
  ],
  "steps": [
    {
      "op": "fetch",
      "as": "geo",
      "url": "https://geocoding-api.open-meteo.com/v1/search?count=1&name={place}",
      "method": "GET",
      "unless_set": "latitude"
    },
    {
      "op": "pick",
      "as": "place_name",
      "from": "geo",
      "path": "results.0.name",
      "unless_set": "latitude"
    },
    {
      "op": "pick",
      "as": "latitude",
      "from": "geo",
      "path": "results.0.latitude",
      "unless_set": "latitude"
    },
    {
      "op": "pick",
      "as": "longitude",
      "from": "geo",
      "path": "results.0.longitude",
      "unless_set": "longitude"
    },
    {
      "op": "pick",
      "as": "place_name",
      "from": "place",
      "unless_set": "place_name"
    },
    {
      "op": "lookup",
      "as": "unit",
      "from": "latitude",
      "table": {},
      "default": "fahrenheit",
      "unless_set": "unit"
    },
    {
      "op": "fetch",
      "as": "wx",
      "url": "https://api.open-meteo.com/v1/forecast?latitude={latitude}&longitude={longitude}&current=temperature_2m,weather_code,is_day,apparent_temperature,relative_humidity_2m,precipitation,wind_speed_10m,wind_direction_10m,pressure_msl,visibility&hourly=temperature_2m,precipitation_probability&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,sunrise,sunset,uv_index_max&forecast_days=10&forecast_hours=24&timezone=auto&temperature_unit={unit}",
      "method": "GET"
    },
    {
      "op": "pick",
      "as": "temp",
      "from": "wx",
      "path": "current.temperature_2m"
    },
    {
      "op": "pick",
      "as": "code",
      "from": "wx",
      "path": "current.weather_code"
    },
    {
      "op": "lookup",
      "as": "conditions",
      "from": "code",
      "table": {
        "0": "clear",
        "1": "mostly clear",
        "2": "partly cloudy",
        "3": "overcast",
        "45": "foggy",
        "48": "foggy",
        "51": "drizzly",
        "53": "drizzly",
        "55": "drizzly",
        "56": "freezing drizzle",
        "57": "freezing drizzle",
        "61": "rainy",
        "63": "rainy",
        "65": "heavy rain",
        "66": "freezing rain",
        "67": "freezing rain",
        "71": "snowy",
        "73": "snowy",
        "75": "heavy snow",
        "77": "snow grains",
        "80": "showers",
        "81": "showers",
        "82": "heavy showers",
        "85": "snow showers",
        "86": "snow showers",
        "95": "thunderstorms",
        "96": "thunderstorms with hail",
        "99": "thunderstorms with hail"
      },
      "default": "mixed"
    },
    {
      "op": "pick",
      "as": "high",
      "from": "wx",
      "path": "daily.temperature_2m_max.0"
    },
    {
      "op": "pick",
      "as": "low",
      "from": "wx",
      "path": "daily.temperature_2m_min.0"
    },
    {
      "op": "pick",
      "as": "rain_chance",
      "from": "wx",
      "path": "daily.precipitation_probability_max.0"
    },
    {
      "op": "pick",
      "as": "hour_temps",
      "from": "wx",
      "path": "hourly.temperature_2m"
    },
    {
      "op": "pick",
      "as": "day_dates",
      "from": "wx",
      "path": "daily.time"
    },
    {
      "op": "pick",
      "as": "day_highs",
      "from": "wx",
      "path": "daily.temperature_2m_max"
    },
    {
      "op": "pick",
      "as": "day_lows",
      "from": "wx",
      "path": "daily.temperature_2m_min"
    },
    {
      "op": "pick",
      "as": "day_rain",
      "from": "wx",
      "path": "daily.precipitation_probability_max"
    },
    {
      "op": "pick",
      "as": "is_day",
      "from": "wx",
      "path": "current.is_day"
    },
    { "op": "pick", "as": "feels_like", "from": "wx", "path": "current.apparent_temperature" },
    { "op": "pick", "as": "humidity", "from": "wx", "path": "current.relative_humidity_2m" },
    { "op": "pick", "as": "precipitation", "from": "wx", "path": "current.precipitation" },
    { "op": "pick", "as": "wind_speed", "from": "wx", "path": "current.wind_speed_10m" },
    { "op": "pick", "as": "wind_direction", "from": "wx", "path": "current.wind_direction_10m" },
    { "op": "pick", "as": "pressure", "from": "wx", "path": "current.pressure_msl" },
    { "op": "pick", "as": "visibility", "from": "wx", "path": "current.visibility" },
    { "op": "pick", "as": "sunrise", "from": "wx", "path": "daily.sunrise.0" },
    { "op": "pick", "as": "sunset", "from": "wx", "path": "daily.sunset.0" },
    { "op": "pick", "as": "uv_index", "from": "wx", "path": "daily.uv_index_max.0" },
    { "op": "pick", "as": "timezone", "from": "wx", "path": "timezone" },
    {
      "op": "pick",
      "as": "hour_times",
      "from": "wx",
      "path": "hourly.time"
    },
    {
      "op": "pick",
      "as": "hour_pop",
      "from": "wx",
      "path": "hourly.precipitation_probability"
    },
    {
      "op": "pick",
      "as": "day_codes",
      "from": "wx",
      "path": "daily.weather_code"
    },
    {
      "op": "lookup",
      "as": "rain_pct",
      "from": "rain_chance",
      "table": {
        "": ""
      }
    },
    {
      "op": "lookup",
      "as": "rain_words",
      "from": "rain_chance",
      "table": {
        "": "no rain forecast for today"
      },
      "default": "% chance of rain"
    },
    {
      "op": "format",
      "as": "reply",
      "text": "It's {temp} degrees and {conditions} in {place_name}. Today: high {high}, low {low}, {rain_pct}{rain_words}.",
      "speech": "It's {temp} degrees and {conditions} in {place_name} right now. Today's high is {high}, the low {low}, {rain_pct}{rain_words}.",
      "data": {
        "place": "{place_name}",
        "temperature": "{temp}",
        "conditions": "{conditions}",
        "high": "{high}",
        "low": "{low}",
        "precipitation_chance": "{rain_chance}",
        "unit": "{unit}",
        "forecast_dates": "{day_dates}",
        "forecast_highs": "{day_highs}",
        "forecast_lows": "{day_lows}",
        "forecast_rain_chance": "{day_rain}",
        "block_hour_temps": "{hour_temps}",
        "block_day_dates": "{day_dates}",
        "block_day_highs": "{day_highs}",
        "block_day_lows": "{day_lows}",
        "block_day_rain": "{day_rain}",
        "block_code": "{code}",
        "block_is_day": "{is_day}",
        "block_hour_times": "{hour_times}",
        "block_hour_pop": "{hour_pop}",
        "block_day_codes": "{day_codes}",
        "block_detail_feels_like": "{feels_like}",
        "block_detail_humidity": "{humidity}",
        "block_detail_precipitation": "{precipitation}",
        "block_detail_wind_speed": "{wind_speed}",
        "block_detail_wind_direction": "{wind_direction}",
        "block_detail_pressure": "{pressure}",
        "block_detail_visibility": "{visibility}",
        "block_detail_sunrise": "{sunrise}",
        "block_detail_sunset": "{sunset}",
        "block_detail_uv_index": "{uv_index}",
        "block_detail_timezone": "{timezone}"
      }
    }
  ]
}
