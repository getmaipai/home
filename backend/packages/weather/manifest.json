{
  "id": "weather",
  "version": "0.1.0",
  "kind": "plugin",
  "category": "Utilities",
  "display": "Weather",
  "description": "Real current temperature for a named place (2026-09-05: the first real plugin built on host.fetch), via Open-Meteo's free, no-key geocoding and forecast APIs.",
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "what's the weather in Seattle",
      "how's the weather in Chicago",
      "what's the weather like in Portland",
      "weather in Denver",
      "how's the weather in Miami today"
    ],
    "patterns": ["what's the weather in *", "weather in *", "how's the weather in *", "what's the weather like in *"]
  },
  "args": {
    "type": "object",
    "required": ["place"],
    "properties": {
      "place": { "type": "string", "minLength": 1 }
    }
  },
  "requires": [],
  "optional": [],
  "platforms": ["home"],
  "min_role": "child",
  "consequential": false,
  "offline": "unavailable",
  "config": [],
  "data_sources": [
    {
      "id": "open-meteo",
      "destination": "Open-Meteo (open-meteo.com), a free public weather API",
      "when": "each time the family asks for the weather somewhere",
      "what": "the place name spoken in the request (e.g. 'Seattle')",
      "who": "Open-Meteo",
      "opt_in": true,
      "retention": "unknown, see Open-Meteo's own policy"
    }
  ],
  "permissions": ["net:geocoding-api.open-meteo.com", "net:api.open-meteo.com"],
  "notifications": [],
  "backup": "exclude",
  "background": false,
  "contributes": [],
  "pages": [],
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze"
}
