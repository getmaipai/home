{
  "id": "weather",
  "version": "0.1.1",
  "kind": "plugin",
  "category": "Utilities",
  "display": "Weather",
  "description": "Get the weather for a named place: temperature, conditions, today's high and low, and the chance of rain.",
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "what's the weather in Seattle",
      "how's the weather in Chicago",
      "what's the weather like in Portland",
      "weather in Denver",
      "how's the weather in Miami today",
      "is it going to rain in Portland today"
    ],
    "patterns": []
  },
  "args": {
    "type": "object",
    "required": [
      "place"
    ],
    "properties": {
      "place": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "requires": [],
  "optional": [],
  "platforms": [
    "home",
    "bot"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "unavailable",
  "returns_blocks": ["spec_sheet", "chart", "data_table"],
  "config": [],
  "data_sources": [
    {
      "id": "open-meteo",
      "attribution": "Weather data by Open-Meteo.com (CC BY 4.0)",
      "hosts": ["geocoding-api.open-meteo.com", "api.open-meteo.com"],
      "destination": "Open-Meteo (open-meteo.com), a free public weather API",
      "when": "each time the family asks for the weather somewhere, and about once an hour in the background for your home place",
      "what": "the place name (the one spoken in the request, or your home place for the hourly refresh)",
      "who": "Open-Meteo",
      "opt_in": true,
      "retention": "unknown, see Open-Meteo's own policy"
    }
  ],
  "permissions": [
    "net:geocoding-api.open-meteo.com",
    "net:api.open-meteo.com"
  ],
  "notifications": [],
  "cache": {
    "key_template": "weather:{place}",
    "ttl_s": 1800,
    "stale_ok_s": 3600,
    "max_bytes": 4096
  },
  "warm": {
    "schedule": "every:1h",
    "keys": [
      {
        "place": "__HOME_PLACE__"
      }
    ]
  },
  "backup": "exclude",
  "background": false,
  "contributes": {
    "widgets": [
      {
        "id": "current",
        "title": "Weather",
        "size": "card",
        "refresh_s": 1800,
        "inputs": {
          "place": "__HOME_PLACE__"
        }
      }
    ]
  },
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "recipe_fixture",
    "fixture": "tests/smoke.json"
  },
  "incognito": "unaffected",
  "offer": {
    "mode": "base",
    "priority": 8
  }
}
