{
  "id": "weather",
  "version": "0.3.5",
  "kind": "plugin",
  "category": "Utilities",
  "display": "Weather",
  "description": "Get the weather for a named place or your own default place, in chat or in the Weather app.",
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "what's the weather in Seattle",
      "how's the weather in Chicago",
      "what's the weather like in Portland",
      "weather in Denver",
      "how's the weather in Miami today",
      "is it going to rain in Portland today"
    ],
    "patterns": []
  },
  "args": {
    "type": "object",
    "required": [],
    "properties": {
      "place": {
        "type": "string",
        "minLength": 1,
        "grounded": "conversation"
      }
    }
  },
  "requires": [],
  "optional": [],
  "platforms": [
    "home",
    "bot"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "unavailable",
  "returns_blocks": ["weather_card", "spec_sheet", "chart", "data_table"],
  "config": [
    {
      "key": "weather.places",
      "scope": "person",
      "selector": "location",
      "range": { "multiple": true, "allow_current": false },
      "default": [],
      "label": "Weather places",
      "help": "Places saved for weather answers.",
      "level": "basic",
      "lives_in": "weather",
      "honoured_by": ["home"]
    },
    {
      "key": "weather.unit",
      "scope": "person",
      "selector": "select",
      "range": { "options": ["fahrenheit", "celsius"] },
      "default": "fahrenheit",
      "label": "Temperature unit",
      "help": "Whether weather shows degrees Fahrenheit or Celsius.",
      "level": "basic",
      "copy": {
        "does": "Chooses degrees Fahrenheit or Celsius for weather answers and the Weather app.",
        "options": {
          "fahrenheit": "Degrees Fahrenheit, like 72 F.",
          "celsius": "Degrees Celsius, like 22 C."
        }
      },
      "lives_in": "weather",
      "honoured_by": ["home"]
    },
    {
      "key": "weather.default_place",
      "scope": "person",
      "selector": "location",
      "range": { "multiple": false, "allow_current": true },
      "default": "current",
      "label": "Weather default place",
      "help": "The place weather uses when you do not name one.",
      "level": "basic",
      "lives_in": "weather",
      "honoured_by": ["home"]
    }
  ],
  "data_sources": [
    {
      "id": "open-meteo",
      "attribution": "Weather data by Open-Meteo.com (CC BY 4.0)",
      "hosts": ["geocoding-api.open-meteo.com", "api.open-meteo.com"],
      "destination": "Open-Meteo (open-meteo.com), a free public weather API",
      "when": "each time the family asks for the weather somewhere or opens a place in the Weather app, and about once an hour in the background for your home place",
      "what": "the place name you spoke or your saved place name; with Current location on, your device coordinates rounded to about 1 km (about 10 km for a child), sent for that request only and never stored; your home place name for the hourly refresh",
      "who": "Open-Meteo",
      "opt_in": true,
      "retention": "unknown, see Open-Meteo's own policy"
    }
  ],
  "permissions": [
    "net:geocoding-api.open-meteo.com",
    "net:api.open-meteo.com",
    "net:api.weather.gov"
  ],
  "notifications": [
    {
      "id": "weather.alert",
      "level": "time_sensitive",
      "audience": "household",
      "template": "{event}: {headline}",
      "configurable": true,
      "default_channels": ["in_app"]
    }
  ],
  "cache": {
    "key_template": "weather:{place}",
    "ttl_s": 1800,
    "stale_ok_s": 3600,
    "max_bytes": 4096
  },
  "warm": {
    "schedule": "every:1h",
    "keys": [
      {
        "place": "__HOME_PLACE__"
      }
    ]
  },
  "backup": "exclude",
  "background": false,
  "contributes": {
    "pages": [
      { "id": "index", "label": "Weather", "icon": "cloud-sun", "nav": true, "kind": "schema", "module": "index", "pinned_by_default": true, "pin_order": 10, "keywords": ["forecast", "rain", "snow", "temperature", "outside", "hourly"] }
    ],
    "data": [
      { "id": "places", "surface": "weather", "rows": "places" },
      { "id": "forecast", "surface": "weather", "refresh_s": 1800 }
    ],
    "settings_area": {
      "id": "weather",
      "title": "Weather",
      "app": "/apps/weather",
      "audience": { "min_role": "child" },
      "groups": [{ "label": "Weather", "sections": ["places"] }],
      "sections": [
        {
          "id": "places",
          "label": "Places",
          "icon": "map-pin",
          "kind": "keys",
          "cards": [{ "label": "Places", "group": "weather", "scope": "person" }],
          "keywords": ["location", "city", "home", "current location", "saved places"]
        }
      ]
    },
    "widgets": [
      {
        "id": "current",
        "title": "Weather",
        "size": "card",
        "refresh_s": 1800,
        "inputs": {
          "place": "__HOME_PLACE__"
        }
      }
    ]
  },
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "recipe_fixture",
    "fixture": "tests/smoke.json"
  },
  "incognito": "unaffected",
  "offer": {
    "mode": "base",
    "priority": 8
  }
}
