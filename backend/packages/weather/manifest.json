{
  "id": "weather",
  "version": "0.1.0",
  "kind": "plugin",
  "category": "Utilities",
  "display": "Weather",
  "description": "Get the weather for a named place: temperature, conditions, today's high and low, and the chance of rain.",
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "what's the weather in Seattle",
      "how's the weather in Chicago",
      "what's the weather like in Portland",
      "weather in Denver",
      "how's the weather in Miami today",
      "is it going to rain in Portland today"
    ],
    "patterns": ["what's the weather in *", "weather in *", "how's the weather in *", "what's the weather like in *", "is it going to rain in *", "will it rain in *"]
  },
  "args": {
    "type": "object",
    "required": ["place"],
    "properties": {
      "place": { "type": "string", "minLength": 1 }
    }
  },
  "requires": [],
  "optional": [],
  "platforms": ["home", "bot"],
  "min_role": "child",
  "consequential": false,
  "offline": "unavailable",
  "config": [],
  "data_sources": [
    {
      "id": "open-meteo",
      "destination": "Open-Meteo (open-meteo.com), a free public weather API",
      "when": "each time the family asks for the weather somewhere",
      "what": "the place name spoken in the request (e.g. 'Seattle')",
      "who": "Open-Meteo",
      "opt_in": true,
      "retention": "unknown, see Open-Meteo's own policy"
    }
  ],
  "permissions": ["net:geocoding-api.open-meteo.com", "net:api.open-meteo.com"],
  "notifications": [],
  "cache": { "key_template": "weather:{place}", "ttl_s": 1800, "stale_ok_s": 3600, "max_bytes": 4096 },
  "warm": { "schedule": "every:1h", "keys": [{ "place": "Seattle" }] },
  "backup": "exclude",
  "background": false,
  "contributes": {
    "widgets": [{ "id": "current", "title": "Weather", "size": "card", "refresh_s": 1800, "inputs": { "place": "Seattle" } }]
  },
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": { "kind": "recipe_fixture", "fixture": "tests/smoke.json" }
}
