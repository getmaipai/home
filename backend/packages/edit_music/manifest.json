{
  "id": "edit_music",
  "version": "0.1.0",
  "kind": "plugin",
  "category": "Media",
  "display": "Edit a Song",
  "description": "Change a song made here or brought in.",
  "offer": {
    "mode": "conditional",
    "gate": "musicEditAllowed",
    "bench_row": "music-edit-tool",
    "reason": "a household member on their own written screen with music enabled and an available Stack music model; minors may edit only their own songs made in this chat"
  },
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "make it slower",
      "change the chorus to be about waffles",
      "make it instrumental",
      "extend it by twenty seconds",
      "trim the first five seconds",
      "give me another take",
      "split this into stems",
      "make it reggae",
      "remove vocals",
      "remove the vocals from this",
      "keep only the drums and bass",
      "just the vocals",
      "make it karaoke",
      "mute the drums",
      "have the companion sing it",
      "make this sound like Nova singing"
    ],
    "patterns": []
  },
  "args": {
    "type": "object",
    "required": [
      "track",
      "change"
    ],
    "properties": {
      "description": {
        "type": "string",
        "grounded": false,
        "description": "Never claim a song exists without calling this tool.",
        "minLength": 3,
        "maxLength": 1200
      },
      "lyrics": {
        "type": "string",
        "grounded": false,
        "maxLength": 4000
      },
      "title": {
        "type": "string",
        "grounded": false,
        "minLength": 1,
        "maxLength": 200
      },
      "bpm": {
        "type": "number",
        "minimum": 20,
        "maximum": 300
      },
      "key": {
        "type": "string",
        "grounded": false,
        "maxLength": 20,
        "pattern": "^[A-G][#b]?\\s?(major|minor|maj|min|m)?$"
      },
      "track": {
        "type": "string",
        "grounded": false,
        "description": "attached, latest or an id.",
        "minLength": 1,
        "maxLength": 80
      },
      "voice": {
        "type": "string",
        "grounded": false
      },
      "change": {
        "type": "string",
        "description": "parts: set one of keep or drop. voice_swap: set voice.",
        "enum": [
          "remake",
          "restyle",
          "instrumental",
          "rewrite_section",
          "extend",
          "variation",
          "trim",
          "fade",
          "loudness",
          "make_full",
          "make_quick",
          "stems",
          "parts",
          "voice_swap"
        ]
      },
      "parts": {
        "type": "object",
        "properties": {
          "keep": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vocals",
                "drums",
                "bass",
                "other"
              ]
            },
            "minItems": 1
          },
          "drop": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vocals",
                "drums",
                "bass",
                "other"
              ]
            },
            "minItems": 1
          }
        }
      },
      "section": {
        "type": "string",
        "grounded": false,
        "maxLength": 80
      },
      "from_s": {
        "type": "number",
        "minimum": 0
      },
      "to_s": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "seconds": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "at": {
        "type": "string",
        "enum": [
          "start",
          "end"
        ]
      },
      "where": {
        "type": "string",
        "enum": [
          "in",
          "out",
          "both"
        ]
      },
      "strength": {
        "type": "number",
        "minimum": 0.3,
        "maximum": 1
      },
      "lufs": {
        "type": "number",
        "minimum": -70,
        "maximum": -5
      }
    }
  },
  "incognito": "ephemeral",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "full",
  "config": [],
  "data_sources": [],
  "permissions": [],
  "notifications": [],
  "backup": "exclude",
  "background": false,
  "contributes": {},
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "recipe_fixture",
    "fixture": "tests/smoke.json"
  }
}
