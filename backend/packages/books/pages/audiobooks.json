{
  "type": "page",
  "id": "audiobooks",
  "title": "Audiobooks",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Audiobooks",
      "bind": {
        "source": "package",
        "path": "audiobooks"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "aspect": "square",
      "variant": "plain",
      "on_select": {
        "navigate": {
          "to": "/apps/books/detail",
          "state": {
            "id": "{id}"
          }
        }
      },
      "layout": "grid",
      "empty_state": {
        "type": "empty_state",
        "icon": "book-open",
        "text": "No audiobooks yet."
      }
    }
  ]
}
