{
  "id": "edit_video",
  "version": "0.11.0",
  "kind": "plugin",
  "category": "Media",
  "display": "Change a Video",
  "description": "Change a video made here: remix, trim, join, film, mix, continue, reframe, grade, speed, captions, effects.",
  "offer": {
    "mode": "conditional",
    "gate": "videoEditAllowed",
    "bench_row": "video-edit-tool",
    "reason": "adult on their own written screen with video on; this chat already holds a finished video (a cut, a join or a voice or song over it needs only the video editor on this computer)"
  },
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "do another one",
      "make it anime",
      "same video but at night",
      "make it max quality",
      "try that again with a slow camera move",
      "make it longer",
      "cut the first two seconds",
      "put my voice over it",
      "add some music to the video",
      "join these two videos",
      "keep going from where it ended",
      "continue this video",
      "extend this video",
      "redo it from 3 seconds in",
      "make my production Summer at the Lake into a movie"
    ],
    "patterns": []
  },
  "args": {
    "type": "object",
    "required": [
      "change"
    ],
    "properties": {
      "clip": {
        "type": "string",
        "maxLength": 80,
        "grounded": false,
        "description": "\"latest\" or a video id. Needed except for film."
      },
      "change": {
        "type": "string",
        "enum": [
          "another_take",
          "remix",
          "make_it_max",
          "trim",
          "join",
          "film",
          "mix",
          "continue",
          "extend",
          "retake",
          "reframe",
          "grade",
          "film_look",
          "cut_to_beat",
          "letterbox",
          "speed",
          "captions",
          "effect",
          "upscale",
          "remove_background",
          "title_card",
          "credits",
          "spatial_sound"
        ],
        "description": "remix: again with changes. another_take: same again. trim: from_s, to_s. join: clips. film: production, no clip. mix: sound. extend, retake: Max only. cut_to_beat: track, clips, beats_per_cut 1|2|4|8, length_s 5-60. spatial_sound: sound follows who talks on screen. grade: warmth, brightness, contrast, saturation, grain, vignette, only if asked. Each keeps the first video. A video exists only if you called this tool in this reply."
      },
      "prompt": {
        "type": "string",
        "minLength": 3,
        "maxLength": 1200,
        "grounded": false,
        "description": "remix, continue, retake: full new description; spoken lines in quotes, one speaker at a time."
      },
      "look": {
        "type": "string",
        "enum": [
          "natural",
          "classic-cartoon",
          "anime",
          "3d-animated",
          "film",
          "70s_color",
          "noir",
          "teal_orange",
          "bleach_bypass",
          "technicolor",
          "faded_vintage",
          "cool_thriller"
        ]
      },
      "camera": {
        "type": "string",
        "enum": [
          "dolly-in",
          "slow-orbit",
          "handheld",
          "slow-motion",
          "time-lapse",
          "aerial",
          "close-up",
          "still"
        ]
      },
      "voices": {
        "type": "string",
        "enum": [
          "clean",
          "full"
        ]
      },
      "tier": {
        "type": "string",
        "enum": [
          "standard",
          "boost",
          "max"
        ]
      },
      "seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      },
      "keep_seed": {
        "type": "boolean",
        "description": "remix: stay close to the first."
      },
      "from_s": {
        "type": "number",
        "minimum": 0,
        "maximum": 600,
        "description": "trim: where the kept part starts. retake: start time."
      },
      "to_s": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 600
      },
      "clips": {
        "type": "array",
        "minItems": 2,
        "maxItems": 6,
        "items": {
          "type": "string",
          "maxLength": 80
        },
        "description": "join: 2-6 of the person's video ids or \"latest\", in order."
      },
      "sound": {
        "type": "string",
        "enum": [
          "voice",
          "music"
        ]
      },
      "line": {
        "type": "string",
        "minLength": 1,
        "maxLength": 600,
        "grounded": false
      },
      "voice": {
        "type": "string",
        "maxLength": 80,
        "grounded": false
      },
      "track": {
        "type": "string",
        "maxLength": 80,
        "grounded": false
      },
      "make_music": {
        "type": "string",
        "maxLength": 600,
        "grounded": false,
        "description": "mix music: describe new music; leave track out."
      },
      "level": {
        "type": "string",
        "enum": [
          "quiet",
          "soft",
          "balanced",
          "loud",
          "very_loud"
        ]
      },
      "start_s": {
        "type": "number",
        "minimum": 0,
        "maximum": 600
      },
      "transition": {
        "type": "string",
        "enum": [
          "cut",
          "crossfade",
          "fade",
          "dissolve",
          "speckle",
          "wipeleft",
          "wiperight",
          "wipeup",
          "wipedown",
          "slideleft",
          "slideright",
          "slideup",
          "slidedown",
          "circleopen",
          "circleclose",
          "radial",
          "smoothleft",
          "smoothright",
          "fadeblack",
          "fadewhite",
          "zoomin",
          "pixelize"
        ]
      },
      "transition_s": {
        "type": "number",
        "minimum": 0.3,
        "maximum": 1.0
      },
      "title": {
        "type": "string",
        "maxLength": 120,
        "grounded": false
      },
      "subtitle": {
        "type": "string",
        "maxLength": 160,
        "grounded": false
      },
      "credits": {
        "type": "array",
        "maxItems": 60,
        "items": {
          "type": "object",
          "properties": {
            "role": {
              "type": "string",
              "maxLength": 40
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 60
            }
          },
          "required": [
            "name"
          ]
        }
      },
      "credits_title": {
        "type": "string",
        "maxLength": 120,
        "grounded": false
      },
      "styles": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": "Saved style names, only if named; [] removes."
      },
      "strength": {
        "oneOf": [
          {
            "type": "string",
            "enum": [
              "less",
              "normal",
              "more"
            ]
          },
          {
            "type": "number",
            "minimum": 0.2,
            "maximum": 1
          }
        ],
        "grounded": false
      },
      "aspect": {
        "type": "string",
        "enum": [
          "9:16",
          "1:1",
          "16:9",
          "4:5"
        ]
      },
      "background": {
        "type": "string",
        "grounded": false,
        "description": "What fills behind the subject: black, white, green, blur, transparent or hex."
      },
      "surround": {
        "type": "boolean",
        "description": "spatial_sound: also make a 5.1 file."
      },
      "fill": {
        "type": "string",
        "enum": [
          "crop",
          "blur"
        ]
      },
      "warmth": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "brightness": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "contrast": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "saturation": {
        "type": "number",
        "minimum": -1,
        "maximum": 1
      },
      "grain": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "vignette": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "factor": {
        "type": "number",
        "minimum": 0.25,
        "maximum": 4,
        "description": "speed: 0.5 is half, 2 is double."
      },
      "captions": {
        "type": "array",
        "maxItems": 40,
        "items": {
          "type": "object",
          "required": [
            "from_s",
            "to_s",
            "text"
          ],
          "properties": {
            "from_s": {
              "type": "number",
              "minimum": 0
            },
            "to_s": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "text": {
              "type": "string",
              "maxLength": 160
            }
          }
        }
      },
      "position": {
        "type": "string",
        "enum": [
          "bottom",
          "middle",
          "top"
        ]
      },
      "production": {
        "type": "string",
        "maxLength": 160,
        "grounded": false,
        "description": "film: Production id or its exact title."
      },
      "preset": {
        "type": "string",
        "enum": [
          "70s_color",
          "noir",
          "teal_orange",
          "bleach_bypass",
          "technicolor",
          "faded_vintage",
          "cool_thriller"
        ]
      },
      "ratio": {
        "type": "string",
        "enum": [
          "2.39:1",
          "2:1",
          "1.85:1",
          "1.33:1"
        ]
      },
      "letterbox": {
        "type": "string",
        "enum": [
          "2.39:1",
          "2:1",
          "1.85:1",
          "1.33:1"
        ]
      },
      "effect": {
        "type": "string",
        "enum": [
          "speed_ramp",
          "reverse",
          "freeze",
          "loop",
          "fps_boost",
          "flip",
          "rotate",
          "sharpen",
          "denoise",
          "pip",
          "kenburns"
        ]
      },
      "amount": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "times": {
        "type": "integer",
        "minimum": 2,
        "maximum": 6
      },
      "fps": {
        "type": "integer",
        "enum": [
          30,
          48,
          60
        ]
      },
      "direction": {
        "type": "string",
        "enum": [
          "horizontal",
          "vertical"
        ]
      },
      "degrees": {
        "type": "integer",
        "enum": [
          90,
          180,
          270
        ]
      },
      "from_factor": {
        "type": "number",
        "minimum": 0.25,
        "maximum": 4,
        "description": "speed_ramp, kenburns start."
      },
      "to_factor": {
        "type": "number",
        "minimum": 0.25,
        "maximum": 4,
        "description": "speed_ramp, kenburns end."
      },
      "at_s": {
        "type": "number",
        "minimum": 0,
        "maximum": 600
      },
      "over_s": {
        "type": "number",
        "minimum": 0.3,
        "maximum": 10
      },
      "hold_s": {
        "type": "number",
        "minimum": 0.5,
        "maximum": 5
      },
      "corner": {
        "type": "string",
        "enum": [
          "top_left",
          "top_right",
          "bottom_left",
          "bottom_right"
        ]
      },
      "size": {
        "type": "number",
        "minimum": 0.15,
        "maximum": 0.5
      },
      "with_clip": {
        "type": "string",
        "maxLength": 80,
        "grounded": false
      }
    }
  },
  "incognito": "ephemeral",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "adult",
  "consequential": false,
  "offline": "full",
  "config": [],
  "data_sources": [],
  "permissions": [],
  "notifications": [],
  "backup": "exclude",
  "background": false,
  "contributes": {},
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "recipe_fixture",
    "fixture": "tests/smoke.json"
  }
}
