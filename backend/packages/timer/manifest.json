{
  "id": "timer",
  "version": "0.2.0",
  "kind": "plugin",
  "category": "Utilities",
  "display": "Timers",
  "description": "Set a timer for a length of time.",
  "offer": {"mode":"base","priority":7},
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "set a timer for ten minutes",
      "set a timer for 5 minutes",
      "set a timer for an hour",
      "set a timer for 30 seconds",
      "set a timer for 2 hours",
      "wake me at 6:30",
      "set an alarm for 7 tomorrow called gym",
      "wake me tomorrow at 6",
      "set an alarm for noon",
      "wake me in 20 minutes",
      "cancel my alarm at 6:30",
      "what alarms do I have",
      "how long is left on my timer",
      "how much time is left",
      "what timers do I have",
      "is my timer still going"
    ],
    "patterns": [
      "set a timer for *",
      "wake me *",
      "set an alarm *",
      "cancel my alarm *",
      "cancel my * alarm",
      "what alarms do I have",
      "how long is left on my timer",
      "how much time is left",
      "what timers do I have",
      "is my timer still going"
    ]
  },
  "args": {
    "type": "object",
    "required": ["expression"],
    "properties": {
      "expression": { "type": "string", "minLength": 1 }
    }
  },
  "incognito": "unaffected",
  "requires": [],
  "optional": [],
  "platforms": ["home"],
  "min_role": "child",
  "consequential": false,
  "offline": "full",
  "returns_blocks": ["schedule_card", "confirmation"],
  "config": [],
  "data_sources": [],
  "permissions": ["timers:write", "reminders:write"],
  "notifications": [
    {
      "id": "timer.done",
      "level": "passive",
      "audience": "person",
      "template": "Your {duration_text} timer is up.",
      "configurable": true,
      "default_channels": ["in_app"]
    },
    {
      "id": "alarm.due",
      "level": "time_sensitive",
      "audience": "person",
      "template": "Alarm: {task}",
      "configurable": true,
      "default_channels": ["in_app"]
    }
  ],
  "backup": "exclude",
  "background": false,
  "contributes": {},
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": { "kind": "recipe_fixture", "fixture": "tests/smoke.json" }
}
