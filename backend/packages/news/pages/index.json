{
  "type": "page",
  "id": "news-index",
  "title": "Today",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Today's briefing",
      "bind": {
        "source": "package",
        "path": "briefing-item"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "hide_when_empty": true
    },
    {
      "type": "list",
      "bind": {
        "source": "package",
        "path": "briefing"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "row_action": {
        "icon": "mic",
        "label": "{action_label}",
        "action": {
          "call": {
            "target": "/api/plugins/news/actions/make_briefing",
            "args": {
              "title": "Morning briefing",
              "format_id": "{format_id}",
              "audience": "{audience}",
              "cast": "invent",
              "sources": [
                {
                  "kind": "news"
                },
                {
                  "kind": "weather"
                },
                {
                  "kind": "household"
                }
              ],
              "schedule": {
                "every": "1d",
                "at": "07:00"
              }
            }
          }
        }
      }
    },
    {
      "type": "search",
      "state": "q",
      "placeholder": "Search News",
      "submit": {
        "navigate": {
          "to": "/apps/news/search",
          "state": {
            "q": "{q}"
          }
        }
      }
    },
    {
      "type": "answer_blocks",
      "bind": {
        "source": "package",
        "path": "today",
        "params": {
          "topic": "$state.topic"
        }
      },
      "kinds": [
        "story_feed"
      ],
      "actions": {
        "open": {
          "navigate": {
            "to": "/apps/news/story",
            "state": {
              "id": "{item_id}"
            }
          }
        },
        "save": {
          "call": {
            "target": "/api/plugins/news/actions/save",
            "args": {
              "item_id": "{item_id}",
              "on": "{on}"
            }
          }
        },
        "follow": {
          "call": {
            "target": "/api/plugins/news/actions/follow",
            "args": {
              "kind": "{channel_kind}",
              "key": "{channel_key}",
              "on": "{on}"
            }
          }
        },
        "open_channel": {
          "navigate": {
            "to": "/apps/news/channel",
            "state": {
              "kind": "{channel_kind}",
              "key": "{channel_key}"
            }
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "newspaper",
        "text": "No stories yet. Check back soon."
      },
      "filter_state": "topic"
    }
  ]
}
