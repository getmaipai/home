{
  "type": "page",
  "id": "news-channel",
  "title": "Channel",
  "body": [
    {
      "type": "answer_blocks",
      "bind": {
        "source": "package",
        "path": "channel",
        "params": {
          "kind": "$state.kind",
          "key": "$state.key"
        }
      },
      "kinds": [
        "story_feed"
      ],
      "actions": {
        "open": {
          "navigate": {
            "to": "/apps/news/story",
            "state": {
              "id": "{item_id}"
            }
          }
        },
        "save": {
          "call": {
            "target": "/api/plugins/news/actions/save",
            "args": {
              "item_id": "{item_id}",
              "on": "{on}"
            }
          }
        },
        "follow": {
          "call": {
            "target": "/api/plugins/news/actions/follow",
            "args": {
              "kind": "{channel_kind}",
              "key": "{channel_key}",
              "on": "{on}"
            }
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "newspaper",
        "text": "No stories yet. Check back soon."
      }
    }
  ]
}
