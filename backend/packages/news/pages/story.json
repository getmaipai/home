{
  "type": "page",
  "id": "news-story",
  "title": "Story",
  "body": [
    {
      "type": "search",
      "state": "q",
      "placeholder": "Search News",
      "submit": {
        "navigate": {
          "to": "/apps/news/search",
          "state": {
            "q": "{q}"
          }
        }
      }
    },
    {
      "type": "answer_blocks",
      "bind": {
        "source": "package",
        "path": "story",
        "params": {
          "id": "$state.id"
        }
      },
      "kinds": [
        "article"
      ],
      "actions": {
        "open": {
          "navigate": {
            "to": "/apps/news/story",
            "state": {
              "id": "{item_id}"
            }
          }
        },
        "save": {
          "call": {
            "target": "/api/plugins/news/actions/save",
            "args": {
              "item_id": "{item_id}",
              "on": "{on}"
            }
          }
        },
        "listen": {
          "play": {
            "media_id": "story"
          }
        },
        "summarize": {
          "call": {
            "target": "/api/plugins/news/actions/summarize",
            "args": {
              "id": "{item_id}"
            }
          }
        },
        "discuss": {
          "navigate": {
            "to": "/apps/news/discuss",
            "state": {
              "id": "{story_id}"
            }
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "newspaper",
        "text": "This story is not available."
      }
    },
    {
      "type": "answer_blocks",
      "bind": {
        "source": "package",
        "path": "more",
        "params": {
          "id": "$state.id"
        }
      },
      "kinds": [
        "story_feed"
      ],
      "actions": {
        "open": {
          "navigate": {
            "to": "/apps/news/story",
            "state": {
              "id": "{item_id}"
            }
          }
        },
        "save": {
          "call": {
            "target": "/api/plugins/news/actions/save",
            "args": {
              "item_id": "{item_id}",
              "on": "{on}"
            }
          }
        }
      }
    }
  ]
}
