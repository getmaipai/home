{
  "id": "trivia",
  "inputs": [],
  "steps": [
    {
      "op": "fetch",
      "as": "result",
      "url": "https://opentdb.com/api.php?amount=1&type=multiple",
      "method": "GET"
    },
    { "op": "pick", "as": "question", "from": "result", "path": "results.0.question" },
    { "op": "pick", "as": "answer", "from": "result", "path": "results.0.correct_answer" },
    {
      "op": "format",
      "as": "reply",
      "text": "{question} The answer: {answer}.",
      "speech": "{question} ... The answer: {answer}."
    }
  ]
}
