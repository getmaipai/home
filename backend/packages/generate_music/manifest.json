{
  "id": "generate_music",
  "version": "0.1.3",
  "kind": "plugin",
  "category": "Media",
  "display": "Make a Song",
  "description": "Make a song or sound effect, kind sound.",
  "offer": {
    "mode": "conditional",
    "gate": "musicAllowed",
    "bench_row": "music-tool",
    "reason": "adult on their own written screen with music enabled and an available Stack music model"
  },
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "make a folk song about Saturday pancakes",
      "write and sing a chorus about rain",
      "make a minute of piano music",
      "create an instrumental for reading",
      "make a song with these lyrics",
      "write a jazz tune with an original voice",
      "write me a song about bananas",
      "compose a heavy metal song",
      "sing me a song",
      "can you write a song for my dad's birthday"
    ],
    "patterns": []
  },
  "args": {
    "type": "object",
    "required": [
      "description"
    ],
    "properties": {
      "description": {
        "type": "string",
        "minLength": 3,
        "maxLength": 1200,
        "grounded": false
      },
      "kind": {
        "type": "string",
        "enum": [
          "song",
          "sound"
        ]
      },
      "lyrics": {
        "type": "string",
        "maxLength": 4000,
        "grounded": false
      },
      "bpm": {
        "type": "number",
        "minimum": 20,
        "maximum": 300
      },
      "key": {
        "type": "string",
        "maxLength": 20,
        "pattern": "^[A-G][#b]?\\s?(major|minor|maj|min|m)?$",
        "grounded": false
      },
      "imitates_real_voice": {
        "type": "boolean"
      },
      "instrumental": {
        "type": "boolean"
      },
      "seconds": {
        "type": "number",
        "minimum": 1,
        "default": 60
      },
      "loop": {
        "type": "boolean"
      },
      "stick_to_words": {
        "type": "boolean"
      },
      "language": {
        "type": "string",
        "maxLength": 20,
        "pattern": "^([a-z]{2,3}(-[A-Za-z]{2,4})?|unknown)$",
        "grounded": false
      },
      "title": {
        "type": "string",
        "maxLength": 200,
        "grounded": false
      },
      "length": {
        "type": "string",
        "enum": [
          "quick",
          "full"
        ]
      },
      "tier": {
        "type": "string",
        "enum": [
          "standard",
          "boost",
          "max"
        ]
      },
      "song_style": {
        "type": "string",
        "maxLength": 40,
        "grounded": false
      },
      "band": {
        "type": "string",
        "maxLength": 40,
        "grounded": false
      },
      "album": {
        "type": "string",
        "maxLength": 40,
        "grounded": false
      },
      "takes": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3,
        "grounded": false
      },
      "seed": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483646,
        "grounded": false
      }
    },
    "allOf": [
      {
        "if": {
          "properties": {
            "kind": {
              "const": "sound"
            }
          },
          "required": [
            "kind"
          ]
        },
        "then": {
          "properties": {
            "seconds": {
              "maximum": 60
            },
            "description": {
              "maxLength": 600
            }
          }
        },
        "else": {
          "properties": {
            "seconds": {
              "minimum": 10
            }
          }
        }
      }
    ]
  },
  "incognito": "ephemeral",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "adult",
  "consequential": false,
  "offline": "full",
  "config": [],
  "data_sources": [],
  "permissions": [],
  "notifications": [],
  "backup": "exclude",
  "background": false,
  "contributes": {},
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "recipe_fixture",
    "fixture": "tests/smoke.json"
  }
}
