{
  "id": "generate_music",
  "version": "0.1.3",
  "kind": "plugin",
  "category": "Media",
  "display": "Make a Song",
  "description": "Make a song when asked.",
  "offer": {
    "mode": "conditional",
    "gate": "musicAllowed",
    "bench_row": "music-tool",
    "reason": "adult on their own written screen with music enabled and an available Stack music model"
  },
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "make a folk song about Saturday pancakes",
      "write and sing a chorus about rain",
      "make a minute of piano music",
      "create an instrumental for reading",
      "make a song with these lyrics",
      "write a jazz tune with an original voice",
      "write me a song about bananas",
      "compose a heavy metal song",
      "sing me a song",
      "can you write a song for my dad's birthday"
    ],
    "patterns": []
  },
  "args": {
    "type": "object",
    "required": [
      "description"
    ],
    "properties": {
      "description": {
        "type": "string",
        "grounded": false,
        "description": "Genre, mood, instruments, voice. Never claim a song without calling this.",
        "minLength": 3,
        "maxLength": 1200
      },
      "lyrics": {
        "type": "string",
        "grounded": false,
        "description": "Lyrics, [Verse]/[Chorus] tags.",
        "maxLength": 4000
      },
      "bpm": {
        "type": "number",
        "minimum": 20,
        "maximum": 300
      },
      "key": {
        "type": "string",
        "grounded": false,
        "maxLength": 20,
        "pattern": "^[A-G][#b]?\\s?(major|minor|maj|min|m)?$"
      },
      "imitates_real_voice": {
        "type": "boolean",
        "description": "Sounds like a real person."
      },
      "instrumental": {
        "type": "boolean"
      },
      "seconds": {
        "type": "number",
        "minimum": 10,
        "default": 60
      },
      "language": {
        "type": "string",
        "grounded": false,
        "maxLength": 20,
        "pattern": "^([a-z]{2,3}(-[A-Za-z]{2,4})?|unknown)$"
      },
      "title": {
        "type": "string",
        "grounded": false,
        "maxLength": 200
      },
      "length": {
        "type": "string",
        "enum": [
          "quick",
          "full"
        ]
      },
      "tier": {
        "type": "string",
        "enum": [
          "standard",
          "boost",
          "max"
        ],
        "description": "Only if asked; max needs admin."
      },
      "song_style": {
        "type": "string",
        "grounded": false,
        "maxLength": 40
      },
      "band": {
        "type": "string",
        "grounded": false,
        "maxLength": 40
      },
      "album": {
        "type": "string",
        "grounded": false,
        "maxLength": 40
      },
      "takes": {
        "type": "integer",
        "grounded": false,
        "description": "Takes 1-3, one card; only if options asked.",
        "minimum": 1,
        "maximum": 3
      },
      "seed": {
        "type": "integer",
        "grounded": false,
        "description": "Same seed, similar song.",
        "minimum": 1,
        "maximum": 2147483646
      }
    }
  },
  "incognito": "ephemeral",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "adult",
  "consequential": false,
  "offline": "full",
  "config": [],
  "data_sources": [],
  "permissions": [],
  "notifications": [],
  "backup": "exclude",
  "background": false,
  "contributes": {},
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "recipe_fixture",
    "fixture": "tests/smoke.json"
  }
}
