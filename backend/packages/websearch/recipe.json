{
  "id": "websearch",
  "inputs": [{ "name": "expression", "selector": "text" }],
  "steps": [
    { "op": "integration.call", "as": "search_results", "id": "searxng", "method": "search", "args": { "query": "{expression}", "category": "{category}" } },
    { "op": "pick", "as": "search_rows", "from": "search_results", "path": "rows" },
    { "op": "format", "as": "reply", "synthesis_hint": "answer the question from these search results; say plainly when they don't answer it", "data": { "rows": "{search_rows}", "query": "{expression}" } }
  ]
}
