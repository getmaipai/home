{
  "id": "websearch",
  "inputs": [{ "name": "expression", "selector": "text" }],
  "steps": [
    { "op": "integration.call", "as": "search_results", "id": "searxng", "method": "search", "args": { "query": "{expression}", "category": "{category}", "read_page": "{read_page}" } },
    { "op": "pick", "as": "search_rows", "from": "search_results", "path": "rows" },
    { "op": "pick", "as": "page", "from": "search_results", "path": "page" },
    { "op": "format", "as": "reply", "synthesis_hint": "answer the question from these search results and the page text when present; say plainly when they don't answer it", "data": { "rows": "{search_rows}", "query": "{expression}", "page": "{page}" } }
  ]
}
