{
  "id": "alarm",
  "inputs": [{"name":"action", "selector":"text"}, {"name":"expression", "selector":"text"}],
  "steps": [
    {"op":"remind", "as":"alarm", "text":"{action} {expression}"},
    {"op":"pick", "as":"task", "from":"alarm", "path":"task"},
    {"op":"pick", "as":"schedule_task", "from":"alarm", "path":"schedule_task"},
    {"op":"pick", "as":"when_text", "from":"alarm", "path":"when_text"},
    {"op":"format", "as":"reply", "text":"{task}", "speech":"{task}", "data":{"task":"{task}", "schedule_task":"{schedule_task}", "when_text":"{when_text}", "action":"{action}"}}
  ]
}
