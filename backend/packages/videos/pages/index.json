{
  "type": "page",
  "id": "index",
  "title": "Videos",
  "body": [
    {
      "type": "billboard",
      "bind": {
        "source": "package",
        "path": "featured"
      },
      "label": "Featured videos",
      "size": "banner",
      "item_key_field": "id",
      "item_title_field": "title",
      "item_subtitle_field": "{summary}",
      "item_eyebrow_field": "New from {channel}",
      "item_art_field": "backdrop",
      "primary": {
        "label": "Play",
        "icon": "play",
        "action": {
          "play": {
            "media_id": "{id}"
          }
        }
      },
      "secondary": [
        {
          "label": "Watch later",
          "icon": "plus",
          "action": {
            "call": {
              "target": "/api/plugins/videos/watch-later",
              "args": {
                "media_id": "{id}"
              }
            }
          }
        }
      ],
      "hide_when_empty": true
    },
    {
      "type": "picker",
      "state": "channel",
      "label": "Channel",
      "placeholder": "All channels",
      "bind": {
        "source": "package",
        "path": "channels"
      },
      "item_key_field": "id",
      "item_label_field": "label"
    },
    {
      "type": "media_shelf",
      "heading": "Channels",
      "bind": {
        "source": "package",
        "path": "channels",
        "params": {
          "scope": "strip"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "aspect": "square",
      "art_shape": "circle",
      "variant": "plain",
      "hide_when_empty": true,
      "on_select": {
        "navigate": {
          "to": "/apps/videos/channel",
          "state": {
            "channel": "{id}"
          }
        }
      },
      "card_radius": "soft"
    },
    {
      "type": "media_shelf",
      "heading": "Recently added",
      "bind": {
        "source": "package",
        "path": "recent",
        "params": {
          "filter": "$state.vfilter",
          "channel": "$state.channel"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{byline}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "row_actions": [
        {
          "icon": "clock",
          "label": "Watch later",
          "action": {
            "call": {
              "target": "/api/plugins/videos/watch-later",
              "args": {
                "media_id": "{id}"
              }
            }
          }
        },
        {
          "icon": "list-plus",
          "label": "Save to playlist",
          "action": {
            "call": {
              "target": "/api/plugins/videos/playlists/save",
              "args": {
                "media_id": "{id}"
              }
            }
          }
        },
        {
          "icon": "share",
          "label": "Share",
          "action": {
            "share": {
              "to": "/apps/videos/watch?id={id}",
              "title": "{title}"
            }
          }
        }
      ],
      "aspect": "wide",
      "variant": "plain",
      "hide_when_empty": true,
      "see_all": {
        "label": "See all",
        "action": {
          "navigate": {
            "to": "/apps/videos/library"
          }
        }
      },
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "chips": {
        "state": "vfilter",
        "label": "Filter videos",
        "options": [
          {
            "value": "all",
            "label": "All"
          },
          {
            "value": "made",
            "label": "Made at home"
          },
          {
            "value": "unwatched",
            "label": "Unwatched"
          },
          {
            "value": "long",
            "label": "Long"
          },
          {
            "value": "short",
            "label": "Short"
          }
        ]
      },
      "card_radius": "soft",
      "item_avatar_field": "channel_avatar"
    },
    {
      "type": "media_shelf",
      "heading": "Made at home",
      "bind": {
        "source": "package",
        "path": "made-at-home"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "media_loop": true,
      "item_loop_field": "loop",
      "aspect": "wide",
      "variant": "plain",
      "hide_when_empty": true,
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "card_radius": "soft"
    },
    {
      "type": "media_shelf",
      "heading": "Continue watching",
      "bind": {
        "source": "package",
        "path": "continue",
        "params": {
          "filter": "$state.vfilter",
          "channel": "$state.channel"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{byline}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "row_actions": [
        {
          "icon": "clock",
          "label": "Watch later",
          "action": {
            "call": {
              "target": "/api/plugins/videos/watch-later",
              "args": {
                "media_id": "{id}"
              }
            }
          }
        },
        {
          "icon": "list-plus",
          "label": "Save to playlist",
          "action": {
            "call": {
              "target": "/api/plugins/videos/playlists/save",
              "args": {
                "media_id": "{id}"
              }
            }
          }
        },
        {
          "icon": "share",
          "label": "Share",
          "action": {
            "share": {
              "to": "/apps/videos/watch?id={id}",
              "title": "{title}"
            }
          }
        }
      ],
      "aspect": "wide",
      "variant": "plain",
      "hide_when_empty": true,
      "see_all": {
        "label": "See all",
        "action": {
          "navigate": {
            "to": "/apps/videos/history"
          }
        }
      },
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "card_radius": "soft",
      "item_avatar_field": "channel_avatar"
    },
    {
      "type": "media_shelf",
