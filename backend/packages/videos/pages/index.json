      "empty_state": {
        "type": "empty_state",
        "icon": "film",
        "text": "No videos yet. Make one in Create, and it shows up here.",
        "action": {
          "navigate": {
            "to": "/apps/videos/create"
          }
        },
        "action_label": "Make a video"
      },
      "card_radius": "soft",
      "item_avatar_field": "channel_avatar"
