{
  "type": "page",
  "id": "index",
  "title": "Videos",
  "tone": "cinema",
  "body": [
    {
      "type": "billboard",
      "bind": {
        "source": "package",
        "path": "featured"
      },
      "label": "Featured videos",
      "size": "banner",
      "item_key_field": "id",
      "item_title_field": "title",
      "item_subtitle_field": "{summary}",
      "item_eyebrow_field": "New from {channel}",
      "item_art_field": "backdrop",
      "primary": {
        "label": "Play",
        "icon": "play",
        "action": {
          "play": {
            "media_id": "{id}"
          }
        }
      },
      "secondary": [
        {
          "label": "Watch later",
          "icon": "plus",
          "action": {
            "call": {
              "target": "/api/plugins/videos/watch-later",
              "args": {
                "media_id": "{id}"
              }
            }
          }
        }
      ],
      "hide_when_empty": true
    },
    {
      "type": "media_shelf",
      "heading": "Made at home",
      "bind": {
        "source": "package",
        "path": "made-at-home"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "hide_when_empty": true,
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "Continue watching",
      "bind": {
        "source": "package",
        "path": "continue"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "hide_when_empty": true,
      "see_all": {
        "label": "See all",
        "action": {
          "navigate": {
            "to": "/apps/videos/history"
          }
        }
      },
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "New from your channels",
      "bind": {
        "source": "package",
        "path": "new"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "hide_when_empty": true,
      "see_all": {
        "label": "See all",
        "action": {
          "navigate": {
            "to": "/apps/videos/library"
          }
        }
      },
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "Recently added",
      "bind": {
        "source": "package",
        "path": "recent"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "hide_when_empty": true,
      "see_all": {
        "label": "See all",
        "action": {
          "navigate": {
            "to": "/apps/videos/library"
          }
        }
      },
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "More from your most watched",
      "bind": {
        "source": "package",
        "path": "more-from"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "hide_when_empty": true,
      "see_all": {
        "label": "See all",
        "action": {
          "navigate": {
            "to": "/apps/videos/library"
          }
        }
      },
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "Watch again",
      "bind": {
        "source": "package",
        "path": "again"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "hide_when_empty": true,
      "see_all": {
        "label": "See all",
        "action": {
          "navigate": {
            "to": "/apps/videos/history"
          }
        }
      },
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "Everything in your library",
      "bind": {
        "source": "package",
        "path": "library"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "see_all": {
        "label": "See all",
        "action": {
          "navigate": {
            "to": "/apps/videos/library"
          }
        }
      },
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "film",
        "text": "No videos in the library yet. An admin can add a video folder in Settings, Home, Storage."
      }
    }
  ]
}
