{
  "type": "page",
  "id": "videos-clips",
  "title": "My clips",
  "body": [
    {
      "type": "tabs",
      "state": "view",
      "tabs": [
        {
          "id": "all",
          "label": "All",
          "body": [
            {
              "type": "media_shelf",
              "bind": {
                "source": "package",
                "path": "recipes",
                "params": {
                  "scope": "clips",
                  "view": "all"
                }
              },
              "item_key_field": "id",
              "item_label_field": "title",
              "item_subtitle_field": "{subtitle}",
              "item_media_field": "thumbnail",
              "item_meta_field": "duration_s",
              "locked_field": "locked",
              "making_field": "making",
              "aspect": "wide",
              "variant": "plain",
              "layout": "grid",
              "group_by_field": "created_at",
              "group_noun": {
                "one": "clip",
                "other": "clips"
              },
              "size_control": true,
              "favorite": {
                "field": "favorite",
                "action": {
                  "call": {
                    "target": "/api/plugins/videos/actions/favorite",
                    "method": "POST",
                    "args": {
                      "id": "{id}",
                      "favorite": "{favorite}"
                    }
                  }
                }
              },
              "on_select": {
                "play": {
                  "media_id": "{id}"
                }
              },
              "empty_state": {
                "type": "empty_state",
                "icon": "film",
                "text": "Your clips will show up here. Choose Create to make one.",
                "action": {
                  "navigate": {
                    "to": "/apps/videos/create"
                  }
                },
                "action_label": "Make a video"
              },
              "row_actions": [
                {
                  "label": "Remove lock",
                  "icon": "key-round",
                  "action": {
                    "call": {
                      "target": "/api/plugins/videos/actions/adult-mark",
                      "method": "POST",
                      "args": {
                        "id": "{id}",
                        "action": "clear",
                        "ticket": "{ticket}"
                      },
                      "fresh_confirm": {
                        "title": "Remove the adult lock?",
                        "description": "This changes who can see it. It will show with its title and thumbnail in your feeds and lists, to anyone looking at your screen. People under 18 still never see it. Enter your passcode to continue.",
                        "action_label": "Remove lock"
                      }
                    }
                  },
                  "show_when_field": "can_unmark"
                },
                {
                  "label": "Lock",
                  "icon": "lock",
                  "action": {
                    "call": {
                      "target": "/api/plugins/videos/actions/adult-mark",
                      "method": "POST",
                      "args": {
                        "id": "{id}",
                        "action": "mark"
                      }
                    }
                  },
                  "show_when_field": "can_mark"
                }
              ]
            }
          ]
        },
        {
          "id": "favorites",
          "label": "Favorites",
          "body": [
            {
              "type": "media_shelf",
              "bind": {
                "source": "package",
                "path": "recipes",
                "params": {
                  "scope": "clips",
                  "view": "favorites"
                }
              },
              "item_key_field": "id",
              "item_label_field": "title",
              "item_subtitle_field": "{subtitle}",
              "item_media_field": "thumbnail",
              "item_meta_field": "duration_s",
              "aspect": "wide",
              "variant": "plain",
              "layout": "grid",
              "group_by_field": "created_at",
              "group_noun": {
                "one": "clip",
                "other": "clips"
              },
              "size_control": true,
              "favorite": {
                "field": "favorite",
                "action": {
                  "call": {
                    "target": "/api/plugins/videos/actions/favorite",
                    "method": "POST",
                    "args": {
                      "id": "{id}",
                      "favorite": "{favorite}"
                    }
                  }
                }
              },
              "on_select": {
                "play": {
                  "media_id": "{id}"
                }
              },
              "empty_state": {
                "type": "empty_state",
                "icon": "heart",
                "text": "Press the heart on a clip and it shows up here."
              }
            }
          ]
        },
        {
          "id": "uploaded",
          "label": "Uploaded",
          "body": [
            {
              "type": "media_shelf",
              "bind": {
                "source": "package",
                "path": "recipes",
                "params": {
                  "scope": "clips",
                  "view": "uploaded"
                }
              },
              "item_key_field": "id",
              "item_label_field": "title",
              "item_subtitle_field": "{subtitle}",
              "item_media_field": "thumbnail",
              "aspect": "wide",
              "variant": "plain",
              "layout": "grid",
              "group_by_field": "created_at",
              "group_noun": {
                "one": "picture",
                "other": "pictures"
              },
              "size_control": true,
              "on_select": {
                "navigate": {
                  "to": "/apps/videos/create",
                  "state": {
                    "start_frame": "{id}"
                  }
                }
              },
              "empty_state": {
                "type": "empty_state",
                "icon": "camera",
                "text": "Pictures you add to start a video from show up here.",
                "action": {
                  "navigate": {
                    "to": "/apps/videos/create"
                  }
                },
                "action_label": "Make a video"
              }
            }
          ]
        }
      ]
    }
  ]
}
