{
  "type": "page",
  "id": "videos-make-video",
  "title": "Make a video",
  "body": [
    {
      "type": "split_view",
      "aside_label": "Make a video",
      "main": [
        {
          "type": "prompt_bar",
          "label": "What should the video show?",
          "placeholder": "Describe your video",
          "prompt_state": "prompt",
          "max_length": 1200,
          "chips": [
            {
              "state": "orientation",
              "label": "Shape",
              "default": "landscape",
              "options": [
                {
                  "value": "landscape",
                  "label": "Landscape"
                },
                {
                  "value": "portrait",
                  "label": "Portrait"
                }
              ]
            }
          ],
          "references": [
            {
              "state": "start_frame",
              "label": "Picture",
              "kind": "picture"
            }
          ],
          "submit_label": "Make",
          "submit": {
            "call": {
              "target": "/api/plugins/videos/actions/make",
              "method": "POST",
              "args": {
                "prompt": "{prompt}",
                "orientation": "{orientation}",
                "seconds": "{seconds}",
                "tier": "{tier}",
                "look": "{look}",
                "camera": "{camera}",
                "voices": "{voices}",
                "start_frame": "{start_frame}"
              }
            }
          }
        },
        {
          "type": "empty_state",
          "icon": "info",
          "text": "Write what you want to see. For speech put each person's line in quotes and let one person talk at a time."
        }
      ],
      "aside": [
        {
          "type": "player",
          "bind": {
            "source": "package",
            "path": "recipes",
            "params": {
              "scope": "newest"
            }
          },
          "kind": "video",
          "actions": [
            {
              "label": "Another take",
              "icon": "refresh-cw",
              "action": {
                "call": {
                  "target": "/api/plugins/videos/actions/another",
                  "method": "POST",
                  "args": {
                    "id": "{id}"
                  }
                }
              }
            }
          ],
          "empty_state": {
            "type": "empty_state",
            "icon": "film",
            "text": "Your video shows here when it is ready. Describe it, choose a look, then press Make."
          }
        },
        {
          "type": "list",
          "bind": {
            "source": "package",
            "path": "recipes",
            "params": {
              "scope": "making"
            }
          },
          "item_key_field": "id",
          "item_label_field": "title",
          "item_subtitle_field": "{status}",
          "item_media_field": "film",
          "empty_state": {
            "type": "empty_state",
            "icon": "film",
            "text": "Nothing is being made right now."
          }
        },
        {
          "type": "media_shelf",
          "heading": "Recent creations",
          "bind": {
            "source": "package",
            "path": "made-at-home"
          },
          "item_key_field": "id",
          "item_label_field": "title",
          "item_subtitle_field": "{channel}",
          "item_media_field": "thumbnail",
          "item_meta_field": "duration_s",
          "aspect": "wide",
          "variant": "plain",
          "hide_when_empty": true,
          "row_actions": [
            {
              "icon": "refresh-cw",
              "label": "Another take",
              "action": {
                "call": {
                  "target": "/api/plugins/videos/actions/another",
                  "method": "POST",
                  "args": {
                    "id": "{id}"
                  }
                }
              }
            }
          ],
          "on_select": {
            "play": {
              "media_id": "{id}"
            }
          }
        }
      ]
    }
  ]
}
