{
  "type": "page",
  "id": "videos-make-video",
  "title": "Make a video",
  "body": [
    {
      "type": "prompt_bar",
      "label": "What should the video show?",
      "placeholder": "Describe your video",
      "prompt_state": "prompt",
      "max_length": 1200,
      "chips": [
        {
          "state": "orientation",
          "label": "Shape",
          "default": "landscape",
          "options": [
            {
              "value": "landscape",
              "label": "Landscape"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            }
          ]
        }
      ],
      "submit_label": "Make",
      "submit": {
        "call": {
          "target": "/api/plugins/videos/actions/make",
          "method": "POST",
          "args": {
            "prompt": "{prompt}",
            "orientation": "{orientation}",
            "seconds": "{seconds}",
            "tier": "{tier}",
            "recipe": "{recipe}",
            "look": "{look}",
            "voices": "{voices}"
          }
        }
      }
    },
    {
      "type": "empty_state",
      "icon": "info",
      "text": "Write what you want to see. For speech put each person's line in quotes and let one person talk at a time."
    },
    {
      "type": "section",
      "heading": "Making now",
      "children": [
        {
          "type": "list",
          "bind": {
            "source": "package",
            "path": "recipes",
            "params": {
              "scope": "making"
            }
          },
          "item_key_field": "id",
          "item_label_field": "title",
          "item_subtitle_field": "{status}",
          "item_media_field": "film",
          "empty_state": {
            "type": "empty_state",
            "icon": "film",
            "text": "Nothing is being made right now."
          }
        }
      ]
    },
    {
      "type": "section",
      "heading": "Last one",
      "children": [
        {
          "type": "list",
          "bind": {
            "source": "package",
            "path": "recipes",
            "params": {
              "scope": "last"
            }
          },
          "item_key_field": "id",
          "item_label_field": "title",
          "item_subtitle_field": "{status}",
          "item_media_field": "film",
          "row_action": {
            "icon": "refresh-cw",
            "label": "Another take",
            "action": {
              "call": {
                "target": "/api/plugins/videos/actions/another",
                "method": "POST",
                "args": {
                  "id": "{id}"
                }
              }
            }
          },
          "empty_state": {
            "type": "empty_state",
            "icon": "film",
            "text": "Your last video will show here with an Another take button."
          }
        }
      ]
    },
    {
      "type": "media_shelf",
      "heading": "Recent creations",
      "bind": {
        "source": "package",
        "path": "made-at-home"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "hide_when_empty": true,
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      }
    }
  ]
}
