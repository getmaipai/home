{
  "type": "page",
  "id": "videos-creations",
  "title": "My creations",
  "body": [
    {
      "type": "media_shelf",
      "bind": {
        "source": "package",
        "path": "made-at-home",
        "params": {
          "limit": 200
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "orientation": "vertical",
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "library",
        "text": "Your videos will show up here. Choose Make a video to start one."
      }
    }
  ]
}
