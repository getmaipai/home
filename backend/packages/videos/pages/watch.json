{
  "type": "page",
  "id": "watch",
  "title": "Watch",
  "tone": "cinema",
  "body": [
    {
      "type": "split_view",
      "aside_label": "Up next",
      "main": [
        {
          "type": "player",
          "bind": {
            "source": "package",
            "path": "item",
            "params": {
              "id": "$state.id"
            }
          },
          "kind": "video",
          "autoplay_next": true,
          "details": true,
          "actions": [
            {
              "label": "Like",
              "icon": "thumbs-up",
              "field": "liked",
              "on_label": "Liked",
              "action": {
                "call": {
                  "target": "/api/plugins/videos/like",
                  "args": {
                    "media_id": "{id}",
                    "on": "{on}"
                  }
                }
              }
            },
            {
              "label": "Watch later",
              "icon": "clock",
              "field": "watch_later",
              "on_label": "Saved for later",
              "action": {
                "call": {
                  "target": "/api/plugins/videos/watch-later",
                  "args": {
                    "media_id": "{id}",
                    "on": "{on}"
                  }
                }
              }
            }
          ],
          "on_progress": {
            "call": {
              "target": "/api/plugins/videos/progress",
              "args": {
                "media_id": "{id}",
                "position_s": "{position_s}",
                "duration_s": "{duration_s}",
                "reason": "{reason}"
              }
            }
          },
          "on_next": {
            "play": {
              "media_id": "{id}"
            }
          },
          "empty_state": {
            "type": "empty_state",
            "icon": "film",
            "text": "This video is not on the hub. Go back to Videos and pick another."
          }
        }
      ],
      "aside": [
        {
          "type": "media_shelf",
          "heading": "Up next",
          "bind": {
            "source": "package",
            "path": "up-next",
            "params": {
              "id": "$state.id"
            }
          },
          "item_key_field": "id",
          "item_label_field": "title",
          "item_subtitle_field": "{channel}",
          "item_media_field": "thumbnail",
          "item_progress_field": "progress",
          "item_badge_field": "copy_label",
          "item_meta_field": "duration_s",
          "aspect": "wide",
          "variant": "plain",
          "orientation": "vertical",
          "hide_when_empty": true,
          "on_select": {
            "play": {
              "media_id": "{id}"
            }
          }
        }
      ]
    }
  ]
}
