{
  "id": "videos",
  "version": "0.4.0",
  "kind": "app",
  "category": "Media",
  "display": "Videos",
  "description": "Watch the videos saved on your hub, pick up where you stopped and keep a list to watch later.",
  "routing": {
    "examples": [
      "open my videos",
      "what videos are saved on the hub",
      "continue the video I was watching",
      "show my watch later list",
      "play the newest video from Bramble Workshop"
    ],
    "patterns": []
  },
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "degraded",
  "config": [],
  "data_sources": [],
  "permissions": [],
  "notifications": [
    {
      "id": "videos.clip_ready",
      "level": "passive",
      "audience": "person",
      "template": "Your video is ready: {title}",
      "configurable": true,
      "default_channels": [
        "in_app"
      ]
    }
  ],
  "backup": "exclude",
  "background": false,
  "contributes": {
    "sidebar": {
      "search": {
        "type": "search",
        "state": "q",
        "label": "Search Videos",
        "placeholder": "Search Videos",
        "submit": {
          "navigate": {
            "to": "/apps/videos/search",
            "state": {
              "q": "{q}"
            }
          }
        }
      },
      "groups": [
        {
          "id": "play",
          "mode": "play",
          "pages": [
            "index",
            "library",
            "clips-feed",
            "history",
            "watch-later",
            "liked",
            "playlists"
          ]
        },
        {
          "id": "create",
          "mode": "create",
          "pages": [
            "create",
            "studio",
            "clips"
          ]
        }
      ]
    },
    "pages": [
      {
        "id": "index",
        "label": "Videos",
        "icon": "film",
        "nav": true,
        "kind": "schema",
        "module": "index",
        "keywords": [
          "video",
          "movies",
          "clips",
          "watch",
          "youtube",
          "channel"
        ]
      },
      {
        "id": "library",
        "label": "Library",
        "icon": "library",
        "nav": true,
        "kind": "schema",
        "module": "library"
      },
      {
        "id": "watch",
        "label": "Watch",
        "icon": "play",
        "nav": false,
        "kind": "schema",
        "module": "watch"
      },
      {
        "id": "clips-feed",
        "label": "Clips",
        "icon": "clapperboard",
        "nav": true,
        "kind": "schema",
        "module": "clips-feed",
        "keywords": [
          "clips",
          "shorts",
          "short videos",
          "scroll"
        ]
      },
      {
        "id": "watch-later",
        "label": "Watch later",
        "icon": "clock",
        "nav": true,
        "kind": "schema",
        "module": "watch-later"
      },
      {
        "id": "liked",
        "label": "Liked videos",
        "icon": "thumbs-up",
        "nav": true,
        "kind": "schema",
        "module": "liked"
      },
      {
        "id": "playlists",
        "label": "Playlists",
        "icon": "list-video",
        "nav": true,
        "kind": "schema",
        "module": "playlists"
      },
      {
        "id": "playlist",
        "label": "Playlist",
        "icon": "list-video",
        "nav": false,
        "kind": "schema",
        "module": "playlist"
      },
      {
        "id": "channel",
        "label": "Channel",
        "icon": "film",
        "nav": false,
        "kind": "schema",
        "module": "channel"
      },
      {
        "id": "history",
        "label": "History",
        "icon": "history",
        "nav": true,
        "kind": "schema",
        "module": "history"
      },
      {
        "id": "search",
        "label": "Search",
        "icon": "search",
        "nav": false,
        "kind": "schema",
        "module": "search"
      },
      {
        "id": "create",
        "label": "Create",
        "icon": "film",
        "nav": true,
        "kind": "schema",
        "module": "create",
        "min_role": "adult"
      },
      {
        "id": "studio",
        "label": "Studio",
        "icon": "audio-waveform",
        "nav": true,
        "kind": "schema",
        "module": "studio",
        "min_role": "adult"
      },
      {
        "id": "clips",
        "label": "My clips",
        "icon": "folder",
        "nav": true,
        "kind": "schema",
        "module": "clips",
        "min_role": "adult"
      }
    ],
    "data": [
      {
        "id": "made-at-home",
        "rows": "list"
      },
      {
        "id": "featured",
        "rows": "list"
      },
      {
        "id": "continue",
        "rows": "list"
      },
      {
        "id": "new",
        "rows": "list"
      },
      {
        "id": "recent",
        "rows": "list"
      },
      {
        "id": "more-from",
        "rows": "list"
      },
      {
        "id": "again",
        "rows": "list"
      },
      {
        "id": "library",
        "rows": "list"
      },
      {
        "id": "channels",
        "rows": "list"
      },
      {
        "id": "watch-later",
        "rows": "list"
      },
      {
        "id": "history",
        "rows": "list"
      },
      {
        "id": "item",
        "rows": "list"
      },
      {
        "id": "creation",
        "rows": "list"
      },
      {
        "id": "up-next",
        "rows": "list"
      },
      {
        "id": "recipes",
        "rows": "list"
      },
      {
        "id": "liked",
        "rows": "list"
      }
    ],
    "settings_area": {
      "id": "videos",
      "title": "Videos",
      "app": "/apps/videos",
      "audience": {
        "min_role": "child"
      },
      "groups": [
        {
          "label": "Videos",
          "sections": [
            "speed",
            "storage"
          ]
        }
      ],
      "sections": [
        {
          "id": "speed",
          "label": "Video speed",
          "icon": "gauge",
          "kind": "link",
          "href": "/settings/account/voice",
          "keywords": [
            "playback",
            "speed",
            "faster",
            "slower"
          ]
        },
        {
          "id": "storage",
          "label": "Saved videos and storage",
          "icon": "hard-drive",
          "kind": "link",
          "href": "/settings/home/storage",
          "min_role": "admin",
          "keywords": [
            "library",
            "folders",
            "saved copies",
            "trash"
          ]
        }
      ]
    },
    "header": {
      "search": {
        "label": "Search Videos"
      },
      "modes": [
        {
          "id": "play",
          "label": "Browse",
          "icon": "play",
          "page": "index"
        },
        {
          "id": "create",
          "label": "Create",
          "icon": "sparkles",
          "page": "create"
        }
      ]
    }
  },
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "static"
  },
  "incognito": "unaffected"
}
