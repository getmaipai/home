      "search": {
        "type": "search",
        "state": "q",
        "label": "Search Videos",
        "placeholder": "Search Videos",
        "submit": {
          "navigate": {
            "to": "/apps/videos/search",
            "state": {
              "q": "{q}"
            }
          }
        }
      },
      "groups": [
        {
          "id": "play",
          "mode": "play",
          "pages": [
            "index",
            "library",
            "history",
            "watch-later"
          ]
        },
        {
