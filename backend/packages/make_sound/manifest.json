{
  "id": "make_sound",
  "version": "0.1.0",
  "kind": "plugin",
  "category": "Media",
  "display": "Make a Sound",
  "description": "Make a short sound effect or ambience with no melody or singing.",
  "offer": {
    "mode": "off",
    "reason": "Sound creation is offered through generate_music kind=sound; keep this package id for saved-file provenance and older conversations."
  },
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "make a door slam sound",
      "rain on a window ambience",
      "a loopable forest background",
      "make a quiet wind ambience",
      "create a short thunderclap sound"
    ],
    "patterns": []
  },
  "args": {
    "type": "object",
    "required": [
      "description"
    ],
    "properties": {
      "description": {
        "type": "string",
        "grounded": false,
        "description": "Describe the sound effect or ambience.",
        "minLength": 3,
        "maxLength": 600
      },
      "seconds": {
        "type": "number",
        "grounded": false,
        "description": "Optional length in seconds, from 1 to 60.",
        "minimum": 1,
        "maximum": 60
      },
      "loop": {
        "type": "boolean",
        "grounded": false,
        "description": "Set true when the sound should loop seamlessly."
      },
      "takes": {
        "type": "integer",
        "grounded": false,
        "description": "Optional number of different takes to make, from 1 to 3. Make more than one only when the person asks for options.",
        "minimum": 1,
        "maximum": 3
      },
      "stick_to_words": {
        "type": "boolean",
        "grounded": false,
        "description": "Set false only when you want the model to improvise beyond the words of the request."
      }
    }
  },
  "incognito": "ephemeral",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "adult",
  "consequential": false,
  "offline": "full",
  "config": [],
  "data_sources": [],
  "permissions": [],
  "notifications": [],
  "backup": "exclude",
  "background": false,
  "contributes": {},
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "recipe_fixture",
    "fixture": "tests/smoke.json"
  }
}
