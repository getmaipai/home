{
  "id": "remind",
  "version": "0.1.0",
  "kind": "plugin",
  "category": "Utilities",
  "display": "Reminders",
  "description": "Set a reminder for a later time.",
  "offer": {"mode":"base","priority":5},
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "remind me at 6 to call Nadia",
      "remind me tomorrow at noon to walk the dog",
      "remind me tonight at 8 to take out the trash",
      "remind me in an hour to check the oven",
      "remind me at 9am to leave for work",
      "add milk to the shopping list",
      "put milk on the shopping list",
      "what's on my shopping list",
      "what do I need to buy",
      "cancel the reminder to call Nadia",
      "what reminders do I have"
    ],
    "patterns": [
      "remind me *",
      "add * to the shopping list",
      "add * to my shopping list",
      "put * on the shopping list",
      "what's on my shopping list",
      "what's on the shopping list",
      "what do i need to buy",
      "cancel the reminder *",
      "what reminders do I have"
    ]
  },
  "args": {
    "type": "object",
    "required": ["expression"],
    "properties": {
      "expression": { "type": "string", "minLength": 1 }
    }
  },
  "incognito": "unaffected",
  "requires": [],
  "optional": [],
  "platforms": ["home"],
  "min_role": "child",
  "consequential": false,
  "offline": "full",
  "returns_blocks": ["schedule_card", "confirmation", "todo_list"],
  "config": [],
  "data_sources": [],
  "permissions": ["reminders:write", "lists:write", "lists:read"],
  "notifications": [
    {
      "id": "remind.due",
      "level": "time_sensitive",
      "audience": "person",
      "template": "Reminder: {task}",
      "configurable": true,
      "default_channels": ["in_app"]
    }
  ],
  "backup": "exclude",
  "background": false,
  "contributes": {
    "widgets": [{ "id": "shopping", "title": "Shopping List", "size": "card", "refresh_s": 60, "inputs": { "action": "show_list", "expression": "shopping list" } }]
  },
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": { "kind": "recipe_fixture", "fixture": "tests/smoke.json" }
}
