{
  "id": "remind",
  "inputs": [{ "name": "expression", "selector": "text" }],
  "steps": [
    { "op": "remind", "as": "reminder", "text": "{expression}" },
    { "op": "pick", "as": "task", "from": "reminder", "path": "task" },
    { "op": "pick", "as": "when_text", "from": "reminder", "path": "when_text" },
    { "op": "pick", "as": "undo_id", "from": "reminder", "path": "undo_id" },
    { "op": "format", "as": "reply", "text": "Okay, I'll remind you: {task} ({when_text}).", "speech": "Okay, I'll remind you: {task} ({when_text}).", "data": { "task": "{task}", "when_text": "{when_text}", "undo_id": "{undo_id}" } }
  ]
}
