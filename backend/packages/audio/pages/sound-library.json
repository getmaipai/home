{
  "type": "page",
  "id": "audio-sound-library",
  "title": "Sound effects",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Sound effects",
      "bind": {
        "source": "package",
        "path": "sounds",
        "params": { "scope": "library" }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "density": "compact",
      "item_meta_field": "duration_s",
      "item_highlight_field": "playing",
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "audio-waveform",
        "text": "You have not made a sound effect yet. Make one and it shows up here.",
        "action": {
          "navigate": {
            "to": "/apps/audio/create?make=sound"
          }
        },
        "action_label": "Make a sound"
      }
    }
  ]
}
