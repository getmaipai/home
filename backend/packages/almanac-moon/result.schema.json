{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AlmanacMoonData",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "phase"
  ],
  "properties": {
    "phase": {
      "enum": [
        "New Moon",
        "Waxing Crescent",
        "First Quarter",
        "Waxing Gibbous",
        "Full Moon",
        "Waning Gibbous",
        "Last Quarter",
        "Waning Crescent"
      ]
    },
    "illumination": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "next_full_moon": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "next_new_moon": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "sunrise": {
      "type": ["string", "null"],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    },
    "sunset": {
      "type": ["string", "null"],
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    }
  }
}
