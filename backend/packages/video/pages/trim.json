{
  "type": "page",
  "id": "video-trim",
  "title": "Trim and join",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Pick a clip to trim, split or join",
      "heading_style": "eyebrow",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "studio-picker",
          "id": "$state.clip"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "locked_field": "locked",
      "making_field": "making",
      "aspect": "wide",
      "variant": "plain",
      "layout": "grid",
      "hide_when_empty": true,
      "on_select": {
        "navigate": {
          "to": "/apps/video/trim",
          "state": {
            "clip": "{id}"
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "film",
        "text": "You have no clips yet. Make one with Create.",
        "action": {
          "navigate": {
            "to": "/apps/video/create"
          }
        },
        "action_label": "Make a video"
      }
    },
    {
      "type": "studio",
      "kind": "video",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "studio",
          "id": "$state.clip"
        }
      },
      "handlers": {
        "export": {
          "call": {
            "target": "/api/plugins/video/actions/export",
            "method": "POST",
            "args": {
              "clip": "{clip}",
              "plan": "{plan}"
            }
          }
        },
        "add": {
          "call": {
            "target": "/api/plugins/video/actions/add",
            "method": "POST",
            "args": {
              "clip": "{clip}",
              "kind": "{kind}",
              "ref": "{ref}"
            }
          }
        }
      },
      "export_result": {
        "bind": {
          "source": "package",
          "path": "recipes",
          "params": {
            "scope": "job",
            "id": "$state.export_id"
          }
        },
        "fields": {
          "key": "id",
          "status": "status",
          "progress": "percent",
          "phase": "phase",
          "queue_position": "queue_position",
          "started_at": "started_at",
          "error": "error",
          "poster": "still",
          "src": "src",
          "words": "prompt",
          "locked": "locked",
          "making": "making"
        },
        "handlers": {
          "stop": {
            "call": {
              "target": "/api/plugins/video/actions/cancel",
              "method": "POST",
              "args": {
                "id": "{id}"
              }
            }
          }
        },
        "actions": [
          {
            "label": "Open in My clips",
            "action": {
              "navigate": {
                "to": "/apps/video/clips"
              }
            }
          }
        ],
        "poll_while": {
          "statuses": [
            "queued",
            "generating"
          ],
          "record": {
            "path": "recipes",
            "params": {
              "scope": "job",
              "id": "{id}"
            }
          }
        }
      },
      "tools": [
        "split",
        "delete",
        "add_clip"
      ],
      "panels": [
        "crossfade"
      ],
      "export_label": "Save as a new clip"
    },
    {
      "type": "section",
      "heading": "Split into two clips",
      "condition": "clip",
      "children": [
        {
          "type": "prompt_bar",
          "placement": "inline",
          "layout": "chat",
          "chat_distribution": "start_end",
          "label": "Split at",
          "placeholder": "Type the time to split at, in seconds, for example 4.5.",
          "prompt_state": "split_at",
          "max_length": 12,
          "submit_label": "Split",
          "starts": "video",
          "submit": {
            "call": {
              "target": "/api/plugins/video/actions/split",
              "method": "POST",
              "args": {
                "id": "{clip}",
                "at": "{split_at}"
              },
              "then": {
                "navigate": {
                  "to": "/apps/video/clips"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
