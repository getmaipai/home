{
  "type": "page",
  "id": "videos-create",
  "title": "Create",
  "body": [
    {
      "type": "prompt_bar",
      "placement": "inline",
      "layout": "chat",
      "chat_distribution": "start_end",
      "label": "Describe a video",
      "placeholder": "Describe the video you want. Put each person's line in quotes. Type @ for your cast.",
      "prompt_state": "prompt",
      "max_length": 1200,
      "submit_label": "Generate",
      "starts": "video",
      "style_suggest": {
        "rows": {
          "source": "package",
          "path": "recipes",
          "params": {
            "scope": "style-suggestions",
            "q": "$state.prompt"
          }
        },
        "style_state": "style",
        "character_state": "character",
        "max": 2
      },
      "chips": [
        {
          "state": "orientation",
          "label": "Shape",
          "default": "landscape",
          "options": [
            {
              "value": "landscape",
              "label": "Landscape"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            }
          ],
          "group": "Settings",
          "presentation": "popover"
        }
      ],
      "submit": {
        "call": {
          "target": "/api/plugins/video/actions/make",
          "method": "POST",
          "args": {
            "prompt": "{prompt}",
            "template": "{template}",
            "orientation": "{orientation}",
            "seconds": "{seconds}",
            "tier": "{tier}",
            "look": "{look}",
            "camera": "{camera}",
            "voices": "{voices}",
            "style": "{style}",
            "character": "{character}",
            "strength": "{strength}",
            "start_frame": "{start_frame}",
            "end_frame": "{end_frame}",
            "takes": "{takes}"
          }
        }
      },
      "references": [
        {
          "state": "start_frame",
          "label": "Image",
          "kind": "picture",
          "placement": "in_field"
        }
      ]
    },
    {
      "type": "media_stage",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "stage"
        }
      },
      "size": "stage",
    "compact": true,
      "media": {
        "still": "still",
        "loop": "loop",
        "position": "position"
      },
      "description": "description",
      "scrim": "strong",
      "state": "stage_state",
      "eyebrow": "eyebrow",
      "title": "title",
      "subtitle": "subtitle",
      "progress": "progress",
      "pills": [
        {
          "label": "Another take",
          "icon": "rotate-ccw",
          "action": {
                        "call": {
              "target": "/api/plugins/video/actions/reshoot",
              "method": "POST",
              "args": {
                "id": "{id}"
              }
            }
          }
        },
        {
          "label": "Edit and make again",
          "icon": "pencil",
          "action": {
            "navigate": {
              "to": "/apps/video/create",
              "state": {
                "prompt": "{prompt}",
                "look": "{look}",
                "camera": "{camera}",
                "seconds": "{seconds}",
                "tier": "{tier}",
                "orientation": "{orientation}",
                "start_frame": "{start_frame}"
              }
            }
          }
        },
        {
          "label": "Favorite",
          "icon": "heart",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/favorite",
              "method": "POST",
              "args": {
                "id": "{id}"
              }
            }
          }
        }
      ],
      "error_message": "error_message",
      "error_actions": [
        {
          "label": "Try again",
          "icon": "refresh-cw",
          "action": {
                        "call": {
              "target": "/api/plugins/video/actions/another",
              "method": "POST",
              "args": {
                "id": "{id}"
              }
            }
          }
        },
        {
          "label": "Change the words",
          "icon": "pencil",
          "action": {
            "navigate": {
              "to": "/apps/video/create",
              "state": {
                "prompt": "{prompt}",
                "look": "{look}",
                "camera": "{camera}",
                "seconds": "{seconds}",
                "tier": "{tier}",
                "orientation": "{orientation}",
                "start_frame": "{start_frame}"
              }
            }
          }
        }
      ]
    },
    {
      "type": "media_shelf",
      "heading": "Templates",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "templates",
          "limit": 8
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle}",
      "item_media_field": "thumbnail",
      "aspect": "wide",
      "layout": "rail",
      "variant": "plain",
      "card_radius": "tight",
      "press_scale": true,
      "hide_when_empty": true,
      "on_select": {
        "navigate": {
          "to": "/apps/video/create",
          "state": {
            "template": "{id}"
          }
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "Inspiration",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "showcase",
          "limit": 4
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle}",
      "item_media_field": "thumbnail",
      "aspect": "wide",
      "layout": "rail",
      "variant": "plain",
      "card_radius": "tight",
      "press_scale": true,
      "hide_when_empty": true,
      "on_select": {
        "navigate": {
          "to": "/apps/video/create",
          "state": {
            "prompt": "{prompt}",
            "look": "{look}",
            "camera": "{camera}"
          }
        }
      },
      "media_loop": true,
      "item_loop_field": "loop"
    },
    {
      "type": "section",
      "heading": "Your clips",
      "children": [
        {
          "type": "result_feed",
          "bind": {
            "source": "package",
            "path": "recipes",
            "params": {
              "scope": "feed",
              "view": "after-stage",
              "favorites": "$state.favorites_only",
              "hidden": "$state.hidden_only",
              "type": "$state.type"
            }
          },
          "filters": [
            {
              "kind": "toggle",
              "state": "favorites_only",
              "label": "Favorites only"
            },
            {
              "kind": "toggle",
              "state": "hidden_only",
              "label": "Hidden"
            },
            {
              "kind": "toggle",
              "state": "group_by_words",
              "label": "Group by words",
              "group": true
            },
            {
              "kind": "select",
              "state": "type",
              "label": "Type",
              "options": [
                {
                  "value": "all",
                  "label": "All"
                },
                {
                  "value": "video",
                  "label": "Videos"
                }
              ]
            }
          ],
          "fields": {
            "locked": "locked",
            "making": "making",
            "words": "prompt",
            "tags": "tags",
            "references": "references",
            "status": "status",
            "progress": "percent",
            "phase": "phase",
            "queue_position": "queue_position",
            "started_at": "started_at",
            "error": "error",
            "poster": "still",
            "src": "src",
            "favorite": "favorite",
            "created_at": "created_at",
            "width": "width",
            "height": "height"
          },
          "actions": [
            {
              "label": "Edit and make again",
              "icon": "pencil",
              "action": {
                "navigate": {
                  "to": "/apps/video/create",
                  "state": {
                    "prompt": "{prompt}",
                    "look": "{look}",
                    "camera": "{camera}",
                    "seconds": "{seconds}",
                    "tier": "{tier}",
                    "orientation": "{orientation}",
                    "start_frame": "{start_frame}"
                  }
                }
              }
            },
            {
              "label": "Make it Max",
              "icon": "sparkles",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/max",
                  "method": "POST",
                  "args": {
                    "id": "{id}"
                  }
                }
              }
            },
            {
              "label": "Make it vertical",
              "icon": "smartphone",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/reshape",
                  "method": "POST",
                  "args": {
                    "id": "{id}",
                    "shape": "vertical"
                  }
                }
              }
            },
            {
              "label": "Make it portrait",
              "icon": "smartphone",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/reshape",
                  "method": "POST",
                  "args": {
                    "id": "{id}",
                    "shape": "portrait"
                  }
                }
              }
            },
            {
              "label": "Make it square",
              "icon": "image",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/reshape",
                  "method": "POST",
                  "args": {
                    "id": "{id}",
                    "shape": "square"
                  }
                }
              }
            },
            {
              "label": "Make it widescreen",
              "icon": "monitor",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/reshape",
                  "method": "POST",
                  "args": {
                    "id": "{id}",
                    "shape": "wide"
                  }
                }
              }
            },
            {
              "label": "Sharpen 2x",
              "icon": "sparkles",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/sharpen",
                  "method": "POST",
                  "args": {
                    "id": "{id}"
                  }
                }
              }
            },
            {
              "label": "Spatial sound",
              "icon": "headphones",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/spatial-sound",
                  "method": "POST",
                  "args": {
                    "id": "{id}"
                  }
                }
              }
            },
            {
              "label": "Spatial sound with 5.1 file",
              "icon": "headphones",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/spatial-sound",
                  "method": "POST",
                  "args": {
                    "id": "{id}",
                    "surround": true
                  }
                }
              }
            },
            {
              "label": "Another take",
              "icon": "rotate-ccw",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/reshoot",
                  "method": "POST",
                  "args": {
                    "id": "{id}"
                  }
                }
              }
            },
            {
              "label": "Next shot",
              "icon": "video",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/next-shot",
                  "method": "POST",
                  "args": {
                    "id": "{id}",
                    "shot": "push_in"
                  }
                }
              }
            },
            {
              "label": "Extend",
              "icon": "arrow-right",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/extend",
                  "method": "POST",
                  "args": {
                    "id": "{id}"
                  }
                }
              }
            },
            {
              "label": "Colorize",
              "icon": "palette",
              "starts": "video",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/colorize",
                  "method": "POST",
                  "args": {
                    "id": "{id}"
                  }
                }
              }
            },
            {
              "label": "Hide or show again",
              "icon": "eye-off",
              "show_when": "can_hide",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/hide",
                  "method": "POST",
                  "args": {
                    "id": "{id}"
                  }
                }
              }
            },
            {
              "label": "Open in Studio",
              "icon": "audio-waveform",
              "action": {
                "navigate": {
                  "to": "/apps/video/studio",
                  "state": {
                    "clip": "{id}"
                  }
                }
              }
            },
            {
              "label": "Remove lock",
              "icon": "key-round",
              "show_when": "can_unmark",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/adult-mark",
                  "method": "POST",
                  "args": {
                    "id": "{id}",
                    "action": "clear",
                    "ticket": "{ticket}"
                  },
                  "fresh_confirm": {
                    "title": "Remove the adult lock?",
                    "description": "This changes who can see it. It will show with its title and thumbnail in your feeds and lists, to anyone looking at your screen. People under 18 still never see it. Enter your passcode to continue.",
                    "action_label": "Remove lock"
                  }
                }
              }
            },
            {
              "label": "Lock",
              "icon": "lock",
              "show_when": "can_mark",
              "action": {
                "call": {
                  "target": "/api/plugins/video/actions/adult-mark",
                  "method": "POST",
                  "args": {
                    "id": "{id}",
                    "action": "mark"
                  }
                }
              }
            },
            {
              "label": "How it was made",
              "icon": "info",
              "when": [
                "ready"
              ],
              "action": {
                "navigate": {
                  "to": "/apps/video/how-made",
                  "state": {
                    "id": "{id}"
                  }
                }
              }
            }
          ],
          "handlers": {
            "stop": {
              "call": {
                "target": "/api/plugins/video/actions/cancel",
                "method": "POST",
                "args": {
                  "id": "{id}"
                }
              }
            },
            "retry": {
              "starts": "video",
              "call": {
                "target": "/api/plugins/video/actions/another",
                "method": "POST",
                "args": {
                  "id": "{id}"
                }
              }
            },
            "make_another": {
              "starts": "video",
              "call": {
                "target": "/api/plugins/video/actions/another",
                "method": "POST",
                "args": {
                  "id": "{id}"
                }
              }
            },
            "favorite": {
              "call": {
                "target": "/api/plugins/video/actions/favorite",
                "method": "POST",
                "args": {
                  "id": "{id}"
                }
              }
            }
          },
          "actions_variant": "icons",
          "actions_inline": 2,
          "poll_while": {
            "statuses": [
              "queued",
              "generating"
            ],
            "record": {
              "path": "recipes",
              "params": {
                "scope": "job",
                "id": "{id}"
              }
            }
          },
          "empty_state": {
            "type": "empty_state",
            "icon": "film",
            "text": "Your clips show here. Pick an idea below or describe a video above and press Generate."
          },
          "look": "media",
          "filters_presentation": "popover"
        }
      ]
    }
  ]
}
