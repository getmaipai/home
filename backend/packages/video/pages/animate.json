{
  "type": "page",
  "id": "video-animate",
  "title": "Animate a picture",
  "body": [
    {
      "type": "prompt_bar",
      "placement": "inline",
      "layout": "chat",
      "chat_distribution": "start_end",
      "label": "Describe the motion",
      "placeholder": "Pick a still picture, then describe what should move.",
      "prompt_state": "prompt",
      "max_length": 1200,
      "submit_label": "Animate",
      "chips": [
        {
          "state": "orientation",
          "label": "Shape",
          "default": "landscape",
          "group": "Settings",
          "presentation": "popover",
          "options": [
            {
              "value": "landscape",
              "label": "Landscape"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            }
          ]
        }
      ],
      "references": [
        {
          "state": "start_frame",
          "label": "Picture",
          "kind": "picture",
          "placement": "in_field"
        }
      ],
      "submit": {
        "call": {
          "target": "/api/plugins/video/actions/make",
          "method": "POST",
          "args": {
            "prompt": "{prompt}",
            "orientation": "{orientation}",
            "start_frame": "{start_frame}",
            "need_picture": true
          },
          "then": {
            "navigate": {
              "to": "/apps/video/create"
            }
          }
        }
      },
      "starts": "video"
    }
  ]
}
