{
  "type": "page",
  "id": "video-talking-avatar",
  "title": "Talking avatar",
  "body": [
    {
      "type": "media_stage",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "stage"
        }
      },
      "poll_while": {
        "field": "state",
        "values": [
          "queued",
          "running"
        ]
      },
      "size": "stage",
      "aspect": "short",
      "media": {
        "still": "still",
        "loop": "loop",
        "position": "position"
      },
      "description": "description",
      "scrim": "strong",
      "state": "stage_state",
      "eyebrow": "eyebrow",
      "title": "title",
      "subtitle": "subtitle",
      "progress": "progress",
      "pills": [
        {
          "label": "Open in Studio",
          "icon": "scissors",
          "action": {
            "navigate": {
              "to": "/apps/video/studio",
              "state": {
                "clip": "{id}"
              }
            }
          }
        },
        {
          "label": "See in Create",
          "icon": "film",
          "action": {
            "navigate": {
              "to": "/apps/video/create"
            }
          }
        }
      ],
      "error_message": "error_message",
      "error_actions": [
        {
          "label": "Try again",
          "starts": "video",
          "icon": "refresh-cw",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/another",
              "method": "POST",
              "args": {
                "id": "{id}"
              }
            }
          }
        }
      ],
      "waiting_actions": [
        {
          "label": "Stop",
          "icon": "square",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/cancel",
              "method": "POST",
              "args": {
                "id": "{id}"
              },
              "success_label": "Stopped"
            }
          }
        }
      ]
    },
    {
      "type": "prompt_bar",
      "placement": "inline",
      "layout": "chat",
      "chat_distribution": "start_end",
      "label": "What should they say",
      "placeholder": "Type what they should say.",
      "prompt_state": "line",
      "max_length": 1200,
      "submit_label": "Generate",
      "starts": "video",
      "chips": [
        {
          "state": "orientation",
          "label": "Shape",
          "default": "landscape",
          "options": [
            {
              "value": "landscape",
              "label": "Landscape"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            }
          ],
          "group": "Settings",
          "presentation": "popover"
        }
      ],
      "references": [
        {
          "state": "cast",
          "label": "Cast",
          "kind": "character",
          "placement": "in_field"
        }
      ],
      "submit": {
        "call": {
          "target": "/api/plugins/video/actions/make",
          "method": "POST",
          "args": {
            "prompt": "A close-up of the person talking to the camera, looking natural.",
            "cast": "{cast}",
            "line": "{line}",
            "orientation": "{orientation}",
            "tier": "{tier}"
          }
        }
      }
    }
  ]
}
