{
  "type": "page",
  "id": "video-talking-avatar",
  "title": "Talking avatar",
  "body": [
    {
      "type": "prompt_bar",
      "placement": "inline",
      "layout": "chat",
      "chat_distribution": "start_end",
      "label": "What should they say",
      "placeholder": "Type what they should say.",
      "prompt_state": "line",
      "max_length": 1200,
      "submit_label": "Generate",
      "starts": "video",
      "chips": [
        { "state": "orientation", "label": "Shape", "default": "landscape", "options": [{ "value": "landscape", "label": "Landscape" }, { "value": "portrait", "label": "Portrait" }], "group": "Settings", "presentation": "popover" }
      ],
      "references": [{ "state": "cast", "label": "Cast", "kind": "character", "placement": "in_field" }],
      "submit": {
        "call": {
          "target": "/api/plugins/video/actions/make",
          "method": "POST",
          "args": {
            "prompt": "A close-up of the person talking to the camera, looking natural.",
            "cast": "{cast}",
            "line": "{line}",
            "orientation": "{orientation}",
            "tier": "{tier}"
          }
        }
      }
    }
  ]
}
