{
  "type": "page",
  "id": "library",
  "title": "All videos",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Playlists",
      "bind": {
        "source": "package",
        "path": "library",
        "params": {
          "scope": "playlists"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "card_radius": "soft",
      "hide_when_empty": true,
      "see_all": {
        "label": "See all",
        "action": {
          "navigate": {
            "to": "/apps/video/playlists"
          }
        }
      },
      "on_select": {
        "navigate": {
          "to": "/apps/video/playlist",
          "state": {
            "id": "{id}"
          }
        }
      },
      "look": "backdrop"
    },
    {
      "type": "media_shelf",
      "heading": "Made at home",
      "bind": {
        "source": "package",
        "path": "made-at-home"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "aspect": "wide",
      "variant": "plain",
      "orientation": "vertical",
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "hide_when_empty": true,
      "card_radius": "soft",
      "look": "backdrop"
    },
    {
      "type": "picker",
      "state": "channel",
      "label": "Channel",
      "placeholder": "All channels",
      "bind": {
        "source": "package",
        "path": "channels"
      },
      "item_key_field": "id",
      "item_label_field": "label"
    },
    {
      "type": "media_shelf",
      "heading": "Library",
      "bind": {
        "source": "package",
        "path": "library",
        "params": {
          "channel": "$state.channel",
          "sort": "$state.sort"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{byline}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "item_meta_field": "duration_s",
      "row_actions": [
        {
          "icon": "clock",
          "label": "Watch later",
          "action": {
            "call": {
              "target": "/api/plugins/video/watch-later",
              "args": {
                "media_id": "{id}"
              }
            }
          }
        },
        {
          "icon": "list-plus",
          "label": "Save to playlist",
          "action": {
            "call": {
              "target": "/api/plugins/video/playlists/save",
              "args": {
                "media_id": "{id}"
              },
              "success_label": "Saved to the playlist"
            }
          }
        },
        {
          "icon": "share",
          "label": "Share",
          "action": {
            "share": {
              "to": "/apps/video/watch?id={id}",
              "title": "{title}"
            }
          }
        }
      ],
      "aspect": "wide",
      "variant": "plain",
      "layout": "grid",
      "size_control": true,
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "film",
        "text": "No videos in the library yet.",
        "action": {
          "navigate": {
            "to": "/apps/video/create"
          }
        },
        "action_label": "Make a video"
      },
      "sort": {
        "state": "sort",
        "label": "Sort by",
        "options": [
          {
            "value": "recents",
            "label": "Recents"
          },
          {
            "value": "a-z",
            "label": "A to Z"
          }
        ]
      },
      "card_radius": "soft",
      "item_avatar_field": "channel_avatar",
      "look": "backdrop"
    }
  ]
}
