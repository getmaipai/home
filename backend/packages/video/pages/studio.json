{
  "type": "page",
  "id": "videos-studio",
  "title": "Studio",
  "body": [
    {
      "type": "creation_header",
      "variant": "studio",
      "eyebrow": "Studio",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "studio-header",
          "id": "$state.clip"
        }
      },
      "fields": {
        "art": "thumbnail"
      },
      "secondary": {
        "label": "Back to My clips",
        "action": {
          "navigate": {
            "to": "/apps/video/clips"
          }
        }
      },
      "share_change": {
        "add": {
          "call": {
            "target": "/api/plugins/video/actions/share-add",
            "args": {
              "id": "{id}",
              "person_id": "{person_id}"
            }
          }
        },
        "remove": {
          "call": {
            "target": "/api/plugins/video/actions/share-remove",
            "args": {
              "id": "{id}",
              "person_id": "{person_id}"
            }
          }
        },
        "make_private": {
          "call": {
            "target": "/api/plugins/video/actions/share-private",
            "args": {
              "id": "{id}"
            }
          }
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "Pick a clip to edit",
      "heading_style": "eyebrow",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "studio-picker",
          "id": "$state.clip"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "locked_field": "locked",
      "making_field": "making",
      "aspect": "wide",
      "variant": "plain",
      "layout": "grid",
      "hide_when_empty": true,
      "on_select": {
        "navigate": {
          "to": "/apps/video/studio",
          "state": {
            "clip": "{id}"
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "film",
        "text": "You have no clips yet. Make one with Create.",
        "action": {
          "navigate": {
            "to": "/apps/video/create"
          }
        },
        "action_label": "Make a video"
      }
    },
    {
      "type": "studio",
      "kind": "video",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "studio",
          "id": "$state.clip"
        }
      },
      "handlers": {
        "export": {
          "call": {
            "target": "/api/plugins/video/actions/export",
            "method": "POST",
            "args": {
              "clip": "{clip}",
              "plan": "{plan}"
            }
          }
        },
        "add": {
          "call": {
            "target": "/api/plugins/video/actions/add",
            "method": "POST",
            "args": {
              "clip": "{clip}",
              "kind": "{kind}",
              "ref": "{ref}"
            }
          }
        }
      },
      "make_more": [
        {
          "label": "Another take",
          "starts": "video",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/another",
              "method": "POST",
              "args": {
                "id": "{clip}"
              },
              "then": {
                "navigate": {
                  "to": "/apps/video/create"
                }
              }
            }
          }
        },
        {
          "label": "Make clearer: Quick",
          "starts": "video",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/clearer",
              "method": "POST",
              "args": {
                "id": "{clip}",
                "level": "quick"
              },
              "then": {
                "navigate": {
                  "to": "/apps/video/create"
                }
              }
            }
          }
        },
        {
          "label": "Make clearer: Better",
          "starts": "video",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/clearer",
              "method": "POST",
              "args": {
                "id": "{clip}",
                "level": "better"
              },
              "then": {
                "navigate": {
                  "to": "/apps/video/create"
                }
              }
            }
          }
        }
      ],
      "export_result": {
        "bind": {
          "source": "package",
          "path": "recipes",
          "params": {
            "scope": "job",
            "id": "$state.export_id"
          }
        },
        "fields": {
          "key": "id",
          "status": "status",
          "progress": "percent",
          "phase": "phase",
          "queue_position": "queue_position",
          "started_at": "started_at",
          "error": "error",
          "poster": "still",
          "src": "src",
          "words": "prompt",
          "locked": "locked",
          "making": "making"
        },
        "handlers": {
          "stop": {
            "call": {
              "target": "/api/plugins/video/actions/cancel",
              "method": "POST",
              "args": {
                "id": "{id}"
              }
            }
          }
        },
        "actions": [
          {
            "label": "Spatial sound",
            "action": {
              "call": {
                "target": "/api/plugins/video/actions/spatial-sound",
                "method": "POST",
                "args": {
                  "id": "{id}"
                },
                "then": {
                  "navigate": {
                    "to": "/apps/video/create"
                  }
                }
              }
            }
          },
          {
            "label": "Spatial sound with 5.1 file",
            "action": {
              "call": {
                "target": "/api/plugins/video/actions/spatial-sound",
                "method": "POST",
                "args": {
                  "id": "{id}",
                  "surround": true
                },
                "then": {
                  "navigate": {
                    "to": "/apps/video/create"
                  }
                }
              }
            }
          },
          {
            "label": "Open in My clips",
            "action": {
              "navigate": {
                "to": "/apps/video/clips"
              }
            }
          }
        ],
        "poll_while": {
          "statuses": [
            "queued",
            "generating"
          ],
          "record": {
            "path": "recipes",
            "params": {
              "scope": "job",
              "id": "{id}"
            }
          }
        }
      }
    }
  ]
}
