{
  "type": "page",
  "id": "videos-studio",
  "title": "Studio",
  "body": [
    {
      "type": "creation_header",
      "variant": "studio",
      "eyebrow": "Studio",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "studio-header",
          "id": "$state.clip"
        }
      },
      "fields": {
        "art": "thumbnail"
      },
      "secondary": {
        "label": "Back to My clips",
        "action": {
          "navigate": {
            "to": "/apps/video/clips"
          }
        }
      },
      "share_change": {
        "add": {
          "call": {
            "target": "/api/plugins/video/actions/share-add",
            "args": {
              "id": "{id}",
              "person_id": "{person_id}"
            }
          }
        },
        "remove": {
          "call": {
            "target": "/api/plugins/video/actions/share-remove",
            "args": {
              "id": "{id}",
              "person_id": "{person_id}"
            }
          }
        },
        "make_private": {
          "call": {
            "target": "/api/plugins/video/actions/share-private",
            "args": {
              "id": "{id}"
            }
          }
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "Pick a clip to edit",
      "heading_style": "eyebrow",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "studio-picker",
          "id": "$state.clip"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle}",
      "item_media_field": "thumbnail",
      "item_meta_field": "duration_s",
      "locked_field": "locked",
      "making_field": "making",
      "aspect": "wide",
      "variant": "plain",
      "layout": "grid",
      "hide_when_empty": true,
      "on_select": {
        "navigate": {
          "to": "/apps/video/studio",
          "state": {
            "clip": "{id}"
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "film",
        "text": "You have no clips yet. Make one with Create.",
        "action": {
          "navigate": {
            "to": "/apps/video/create"
          }
        },
        "action_label": "Make a video"
      }
    },
    {
      "type": "media_stage",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "stage",
          "id": "$state.clip",
          "filter": "edit"
        }
      },
      "poll_while": {
        "field": "state",
        "values": [
          "queued",
          "running"
        ]
      },
      "size": "stage",
      "aspect": "short",
      "media": {
        "still": "still",
        "loop": "loop",
        "position": "position"
      },
      "description": "description",
      "scrim": "strong",
      "state": "stage_state",
      "eyebrow": "eyebrow",
      "title": "title",
      "subtitle": "subtitle",
      "progress": "progress",
      "pills": [
        {
          "label": "Open in Studio",
          "icon": "scissors",
          "action": {
            "navigate": {
              "to": "/apps/video/studio",
              "state": {
                "clip": "{id}"
              }
            }
          }
        },
        {
          "label": "See in Create",
          "icon": "film",
          "action": {
            "navigate": {
              "to": "/apps/video/create"
            }
          }
        }
      ],
      "error_message": "error_message",
      "error_actions": [
        {
          "label": "Try again",
          "starts": "video",
          "icon": "refresh-cw",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/another",
              "method": "POST",
              "args": {
                "id": "{id}"
              }
            }
          }
        }
      ],
      "waiting_actions": [
        {
          "label": "Stop",
          "icon": "square",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/cancel",
              "method": "POST",
              "args": {
                "id": "{id}"
              },
              "success_label": "Stopped"
            }
          }
        }
      ],
      "hide_when_empty": true
    },
    {
      "type": "studio",
      "kind": "video",
      "panels": [
        "volume",
        "fades",
        "crossfade",
        "titles",
        "level"
      ],
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "studio",
          "id": "$state.clip"
        }
      },
      "handlers": {
        "export": {
          "call": {
            "target": "/api/plugins/video/actions/export",
            "method": "POST",
            "args": {
              "clip": "{clip}",
              "plan": "{plan}"
            }
          }
        },
        "add": {
          "call": {
            "target": "/api/plugins/video/actions/add",
            "method": "POST",
            "args": {
              "clip": "{clip}",
              "kind": "{kind}",
              "ref": "{ref}"
            }
          }
        },
        "export_nle": {
          "call": {
            "target": "/api/plugins/video/actions/export-nle",
            "method": "POST",
            "args": {
              "clip": "{clip}",
              "plan": "{plan}"
            }
          }
        }
      },
      "make_more": [
        {
          "label": "Another take",
          "starts": "video",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/another",
              "method": "POST",
              "args": {
                "id": "{clip}"
              }
            }
          }
        },
        {
          "label": "Make clearer: Quick",
          "starts": "video",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/clearer",
              "method": "POST",
              "args": {
                "id": "{clip}",
                "level": "quick"
              }
            }
          }
        },
        {
          "label": "Make clearer: Better",
          "starts": "video",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/clearer",
              "method": "POST",
              "args": {
                "id": "{clip}",
                "level": "better"
              }
            }
          }
        }
      ],
      "export_result": {
        "bind": {
          "source": "package",
          "path": "recipes",
          "params": {
            "scope": "job",
            "id": "$state.export_id"
          }
        },
        "fields": {
          "key": "id",
          "status": "status",
          "progress": "percent",
          "phase": "phase",
          "queue_position": "queue_position",
          "started_at": "started_at",
          "error": "error",
          "poster": "still",
          "src": "src",
          "words": "prompt",
          "locked": "locked",
          "making": "making"
        },
        "handlers": {
          "stop": {
            "call": {
              "target": "/api/plugins/video/actions/cancel",
              "method": "POST",
              "args": {
                "id": "{id}"
              }
            }
          }
        },
        "actions": [
          {
            "label": "Spatial sound",
            "action": {
              "call": {
                "target": "/api/plugins/video/actions/spatial-sound",
                "method": "POST",
                "args": {
                  "id": "{id}"
                },
                "then": {
                  "navigate": {
                    "to": "/apps/video/create"
                  }
                }
              }
            }
          },
          {
            "label": "Spatial sound with 5.1 file",
            "action": {
              "call": {
                "target": "/api/plugins/video/actions/spatial-sound",
                "method": "POST",
                "args": {
                  "id": "{id}",
                  "surround": true
                },
                "then": {
                  "navigate": {
                    "to": "/apps/video/create"
                  }
                }
              }
            }
          },
          {
            "label": "Open in My clips",
            "action": {
              "navigate": {
                "to": "/apps/video/clips"
              }
            }
          }
        ],
        "poll_while": {
          "statuses": [
            "queued",
            "generating"
          ],
          "record": {
            "path": "recipes",
            "params": {
              "scope": "job",
              "id": "{id}"
            }
          }
        }
      },
      "export_placement": "auto"
    },
    {
      "type": "section",
      "heading": "Split into two clips",
      "condition": "clip",
      "children": [
        {
          "type": "prompt_bar",
          "placement": "inline",
          "layout": "chat",
          "chat_distribution": "start_end",
          "label": "Split at",
          "placeholder": "Type the time to split at, in seconds, for example 4.5.",
          "prompt_state": "split_at",
          "max_length": 12,
          "submit_label": "Split",
          "starts": "video",
          "submit": {
            "call": {
              "target": "/api/plugins/video/actions/split",
              "method": "POST",
              "args": {
                "id": "{clip}",
                "at": "{split_at}"
              },
              "then": {
                "navigate": {
                  "to": "/apps/video/clips"
                }
              }
            }
          }
        }
      ]
    }
  ]
}
