{
  "type": "page",
  "id": "video-voiceover",
  "title": "Voiceover",
  "body": [
    {
      "type": "media_stage",
      "bind": {
        "source": "package",
        "path": "recipes",
        "params": {
          "scope": "stage",
          "id": "$state.clip",
          "filter": "edit"
        }
      },
      "poll_while": {
        "field": "state",
        "values": [
          "queued",
          "running"
        ]
      },
      "size": "stage",
      "aspect": "short",
      "media": {
        "still": "still",
        "loop": "loop",
        "position": "position"
      },
      "description": "description",
      "scrim": "strong",
      "state": "stage_state",
      "eyebrow": "eyebrow",
      "title": "title",
      "subtitle": "subtitle",
      "progress": "progress",
      "pills": [
        {
          "label": "Open in Studio",
          "icon": "scissors",
          "action": {
            "navigate": {
              "to": "/apps/video/studio",
              "state": {
                "clip": "{id}"
              }
            }
          }
        },
        {
          "label": "See in Create",
          "icon": "film",
          "action": {
            "navigate": {
              "to": "/apps/video/create"
            }
          }
        }
      ],
      "error_message": "error_message",
      "error_actions": [
        {
          "label": "Try again",
          "starts": "video",
          "icon": "refresh-cw",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/another",
              "method": "POST",
              "args": {
                "id": "{id}"
              }
            }
          }
        }
      ],
      "waiting_actions": [
        {
          "label": "Stop",
          "icon": "square",
          "action": {
            "call": {
              "target": "/api/plugins/video/actions/cancel",
              "method": "POST",
              "args": {
                "id": "{id}"
              },
              "success_label": "Stopped"
            }
          }
        }
      ]
    },
    {
      "type": "prompt_bar",
      "placement": "inline",
      "layout": "chat",
      "chat_distribution": "start_end",
      "label": "What should be said",
      "placeholder": "Pick a clip, then type what the voice should say.",
      "prompt_state": "line",
      "max_length": 600,
      "submit_label": "Make voiceover",
      "starts": "video",
      "chips": [
        {
          "state": "voice",
          "label": "Voice",
          "icon": "mic",
          "icon_only": true,
          "default": "default",
          "options": [
            {
              "value": "default",
              "label": "My usual voice"
            }
          ]
        }
      ],
      "references": [
        {
          "state": "clip",
          "label": "Clip",
          "kind": "video",
          "placement": "row"
        }
      ],
      "submit": {
        "call": {
          "target": "/api/plugins/video/actions/voiceover",
          "method": "POST",
          "args": {
            "id": "{clip}",
            "line": "{line}",
            "voice": "{voice}",
            "level": "{level}"
          }
        }
      }
    }
  ]
}
