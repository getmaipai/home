{
  "type": "page",
  "id": "video-voiceover",
  "title": "Voiceover",
  "body": [
    {
      "type": "prompt_bar",
      "placement": "inline",
      "layout": "chat",
      "chat_distribution": "start_end",
      "label": "What should be said",
      "placeholder": "Pick a clip, then type what the voice should say.",
      "prompt_state": "line",
      "max_length": 600,
      "submit_label": "Make voiceover",
      "starts": "video",
      "chips": [
        {
          "state": "voice",
          "label": "Voice",
          "icon": "mic",
          "icon_only": true,
          "default": "default",
          "options": [
            { "value": "default", "label": "My usual voice" }
          ]
        }
      ],
      "references": [
        {
          "state": "clip",
          "label": "Clip",
          "kind": "video",
          "placement": "row"
        }
      ],
      "submit": {
        "call": {
          "target": "/api/plugins/video/actions/voiceover",
          "method": "POST",
          "args": {
            "id": "{clip}",
            "line": "{line}",
            "voice": "{voice}",
            "level": "{level}"
          },
          "then": {
            "navigate": {
              "to": "/apps/video/create"
            }
          }
        }
      }
    }
  ]
}
