{
  "id": "generate_video",
  "version": "0.5.0",
  "kind": "plugin",
  "category": "Media",
  "display": "Make a Video",
  "description": "Make a short video; call before saying one exists.",
  "offer": {
    "mode": "conditional",
    "gate": "videosAllowed",
    "bench_row": "video-tool",
    "reason": "offered only to an adult on their own written screen, when the household has video on and the Stack has a video model"
  },
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "make a short video of a paper boat in the rain",
      "can you generate a video of a dragon flying over a castle",
      "animate this picture",
      "make a clip of waves on a beach at sunset",
      "turn that picture into a video",
      "create a short animation of a robot waving hello"
    ],
    "patterns": []
  },
  "args": {
    "type": "object",
    "required": [
      "prompt"
    ],
    "properties": {
      "prompt": {
        "type": "string",
        "minLength": 3,
        "maxLength": 1200,
        "grounded": false,
        "description": "Scene description; spoken lines in quotes, one speaker at a time."
      },
      "from_picture": {
        "type": "string",
        "maxLength": 80,
        "grounded": false,
        "description": "latest or attached."
      },
      "end_frame": {
        "type": "string",
        "maxLength": 80,
        "grounded": false,
        "description": "Needs from_picture."
      },
      "orientation": {
        "type": "string",
        "enum": [
          "landscape",
          "portrait"
        ]
      },
      "look": {
        "type": "string",
        "enum": [
          "natural",
          "classic-cartoon",
          "anime",
          "3d-animated",
          "film"
        ],
        "description": "Cartoon: name the character, era, style in the prompt."
      },
      "camera": {
        "type": "string",
        "enum": [
          "dolly-in",
          "slow-orbit",
          "handheld",
          "slow-motion",
          "time-lapse",
          "aerial",
          "close-up",
          "still"
        ]
      },
      "voices": {
        "type": "string",
        "enum": [
          "clean",
          "full"
        ]
      },
      "seconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10,
        "description": "Default 5; 5 max from a picture."
      },
      "tier": {
        "type": "string",
        "enum": [
          "standard",
          "boost",
          "max"
        ]
      },
      "styles": {
        "type": "array",
        "maxItems": 2,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": "Saved style names, if named."
      },
      "subjects": {
        "type": "array",
        "maxItems": 3,
        "items": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      },
      "production": {
        "type": "string",
        "maxLength": 80,
        "grounded": false
      },
      "shot": {
        "type": "string",
        "maxLength": 80,
        "grounded": false
      },
      "strength": {
        "type": "string",
        "enum": [
          "less",
          "normal",
          "more"
        ]
      }
    }
  },
  "incognito": "ephemeral",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "full",
  "config": [],
  "data_sources": [],
  "permissions": [],
  "notifications": [],
  "backup": "exclude",
  "background": false,
  "contributes": {},
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "recipe_fixture",
    "fixture": "tests/smoke.json"
  }
}
