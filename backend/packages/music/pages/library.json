{
  "type": "page",
  "id": "library",
  "title": "Your Library",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Your Library",
      "bind": {
        "source": "package",
        "path": "songs",
        "params": {
          "scope": "library",
          "sort": "$state.sort",
          "kind": "$state.library_kind"
        }
      },
      "item_key_field": "pin_key",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle_line}",
      "item_media_field": "thumbnail",
      "pinned_field": "pinned",
      "pinned_max": 6,
      "pinned_heading": "Pinned",
      "sort": {
        "state": "sort",
        "label": "Sort by",
        "options": [
          {
            "value": "recents",
            "label": "Recents"
          },
          {
            "value": "a-z",
            "label": "A to Z"
          },
          {
            "value": "creator",
            "label": "Creator"
          }
        ]
      },
      "chips": {
        "state": "library_kind",
        "label": "Filter",
        "options": [
          {
            "value": "all",
            "label": "All"
          },
          {
            "value": "songs",
            "label": "Songs"
          },
          {
            "value": "albums",
            "label": "Albums"
          },
          {
            "value": "artists",
            "label": "Artists"
          },
          {
            "value": "playlists",
            "label": "Playlists"
          }
        ]
      },
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "density": "compact",
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "row_actions": [
        {
          "icon": "pin",
          "label": "Pin",
          "hide_when_field": "pinned",
          "action": {
            "call": {
              "target": "/api/plugins/music/pin",
              "args": {
                "op": "pin",
                "key": "{pin_key}"
              }
            }
          }
        },
        {
          "icon": "pin-off",
          "label": "Unpin",
          "show_when_field": "pinned",
          "action": {
            "call": {
              "target": "/api/plugins/music/pin",
              "args": {
                "op": "unpin",
                "key": "{pin_key}"
              }
            }
          }
        },
        {
          "icon": "external-link",
          "label": "Open",
          "action": {
            "navigate": {
              "to": "/apps/music/{route}",
              "state": {
                "id": "{id}"
              }
            }
          }
        }
      ],
      "empty_state": {
        "type": "empty_state",
        "icon": "music",
        "text": "Nothing here yet. Make a song or add music to your library.",
        "action": {
          "navigate": {
            "to": "/apps/music/create"
          }
        },
        "action_label": "Make a song"
      }
    }
  ]
}
