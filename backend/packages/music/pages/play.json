{
  "type": "page",
  "id": "play",
  "title": "Now playing",
  "body": [
    {
      "type": "split_view",
      "main": [
        {
          "type": "player",
          "bind": {
            "source": "package",
            "path": "item",
            "params": {
              "id": "$state.id"
            }
          },
          "kind": "audio",
          "details": false,
          "autoplay_next": true,
          "actions": [
            {
              "label": "Like",
              "icon": "heart",
              "field": "liked",
              "on_label": "Liked",
              "action": {
                "call": {
                  "target": "/api/plugins/music/like",
                  "args": {
                    "media_id": "{id}",
                    "on": "{on}"
                  }
                }
              }
            },
            {
              "label": "Add to playlist",
              "icon": "plus",
              "action": {
                "call": {
                  "target": "/api/plugins/music/playlist",
                  "args": {
                    "op": "add",
                    "media_id": "{id}"
                  }
                }
              }
            }
          ],
          "on_progress": {
            "call": {
              "target": "/api/plugins/music/progress",
              "args": {
                "media_id": "{id}",
                "position_s": "{position_s}",
                "duration_s": "{duration_s}",
                "reason": "{reason}"
              }
            }
          },
          "on_next": {
            "play": {
              "media_id": "{id}"
            }
          },
          "empty_state": {
            "type": "empty_state",
            "icon": "film",
            "text": "This song is not available. Go back to Music and pick another."
          },
          "layout": "audio",
          "fields": {
            "description": "description",
            "facts": "facts"
          },
          "lyrics_enabled": true,
          "lyrics_empty_text": "No lyrics for this song.",
          "on_lyrics_open": {
            "call": {
              "target": "/api/plugins/music/actions/lyrics",
              "args": {
                "media_id": "{id}"
              }
            }
          },
          "edit": {
            "label": "Edit",
            "title": "Edit song",
            "visible_field": "can_edit",
            "cover_choices_field": "cover_choices",
            "fields": [
              {
                "name": "title",
                "kind": "text",
                "label": "Title"
              },
              {
                "name": "artist",
                "kind": "text",
                "label": "Artist"
              },
              {
                "name": "description",
                "kind": "textarea",
                "label": "Description"
              },
              {
                "name": "cover",
                "kind": "cover",
                "label": "Cover"
              }
            ],
            "on_save": {
              "call": {
                "target": "/api/plugins/music/actions/edit",
                "args": {
                  "id": "{id}",
                  "title": "{title}",
                  "description": "{description}",
                  "artist": "{artist}",
                  "artwork": "{cover}"
                }
              }
            },
            "on_upload": {
              "call": {
                "target": "/api/plugins/music/actions/cover",
                "args": {
                  "id": "{id}",
                  "file": "{file}"
                }
              }
            }
          },
          "details_show": [
            "facts",
            "chapters"
          ]
        },
        {
          "type": "creation_header",
          "variant": "byline",
          "bind": {
            "source": "package",
            "path": "header",
            "params": {
              "id": "$state.id",
              "scope": "creation"
            }
          },
          "candidates_bind": {
            "source": "package",
            "path": "header",
            "params": {
              "id": "$state.id",
              "scope": "creation-people"
            }
          },
          "share_change": {
            "add": {
              "call": {
                "target": "/api/plugins/music/actions/share-add",
                "args": {
                  "id": "{id}",
                  "person_id": "{person_id}"
                }
              }
            },
            "remove": {
              "call": {
                "target": "/api/plugins/music/actions/share-remove",
                "args": {
                  "id": "{id}",
                  "person_id": "{person_id}"
                }
              }
            },
            "make_private": {
              "call": {
                "target": "/api/plugins/music/actions/share-private",
                "args": {
                  "id": "{id}"
                }
              }
            }
          }
        }
      ],
      "aside": [
        {
          "type": "media_shelf",
          "heading": "Up next",
          "bind": {
            "source": "package",
            "path": "up-next",
            "params": {
              "id": "$state.id"
            }
          },
          "item_key_field": "id",
          "item_label_field": "title",
          "item_subtitle_field": "{channel}",
          "item_media_field": "thumbnail",
          "aspect": "square",
          "variant": "plain",
          "orientation": "vertical",
          "density": "compact",
          "item_meta_field": "duration_s",
          "item_highlight_field": "playing",
          "on_select": {
            "play": {
              "media_id": "{id}"
            }
          },
          "empty_state": {
            "type": "empty_state",
            "icon": "music",
            "text": "Nothing is queued after this song."
          }
        }
      ],
      "aside_label": "Up next",
      "aside_sheet": "phone"
    }
  ]
}
