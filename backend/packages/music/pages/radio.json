    { "type": "media_shelf", "heading": "Hip hop", "bind": { "source": "package", "path": "radio", "params": { "scope": "genre-hip-hop" } }, "item_key_field": "id", "item_label_field": "title", "item_subtitle_field": "{summary}", "item_media_field": "thumbnail", "aspect": "square", "variant": "plain", "orientation": "horizontal", "hide_when_empty": true, "on_select": { "play": { "media_id": "{id}" } }, "row_actions": [{ "icon": "plus", "label": "Add", "label_field": "action_label", "action": { "call": { "target": "/api/plugins/music/radio/stations", "args": { "from": "directory", "name": "{title}", "url": "{url}", "favicon": "{favicon}", "tags": "{tags_csv}", "country_code": "{country_code}", "codec": "{codec}", "bitrate_kbps": "{bitrate_kbps}" } } } }] },
    { "type": "media_shelf", "heading": "Around the world · United States", "bind": { "source": "package", "path": "radio", "params": { "scope": "world-us" } }, "item_key_field": "id", "item_label_field": "title", "item_subtitle_field": "{summary}", "item_media_field": "thumbnail", "aspect": "square", "variant": "plain", "orientation": "horizontal", "hide_when_empty": true, "on_select": { "play": { "media_id": "{id}" } }, "row_actions": [{ "icon": "plus", "label": "Add", "label_field": "action_label", "action": { "call": { "target": "/api/plugins/music/radio/stations", "args": { "from": "directory", "name": "{title}", "url": "{url}", "favicon": "{favicon}", "tags": "{tags_csv}", "country_code": "{country_code}", "codec": "{codec}", "bitrate_kbps": "{bitrate_kbps}" } } } }] },
