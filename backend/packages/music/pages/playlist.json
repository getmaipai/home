{
  "type": "page",
  "id": "playlist",
  "title": "Playlist",
  "body": [
    {
      "type": "creation_header",
      "variant": "collection",
      "bind": {
        "source": "package",
        "path": "header",
        "params": {
          "id": "$state.id",
          "scope": "playlist"
        }
      },
      "share_change": {
        "add": {
          "call": {
            "target": "/api/plugins/music/actions/share-add",
            "args": {
              "id": "{id}",
              "person_id": "{person_id}"
            }
          }
        },
        "remove": {
          "call": {
            "target": "/api/plugins/music/actions/share-remove",
            "args": {
              "id": "{id}",
              "person_id": "{person_id}"
            }
          }
        },
        "make_private": {
          "call": {
            "target": "/api/plugins/music/actions/share-private",
            "args": {
              "id": "{id}"
            }
          }
        }
      },
      "primary": {
        "label": "Play",
        "icon": "play",
        "action": {
          "play": {
            "media_id": "{id}"
          }
        }
      },
      "shuffle": {
        "label": "Shuffle",
        "icon": "shuffle",
        "labeled": true,
        "action": {
          "play": {
            "media_id": "{shuffle_id}"
          }
        }
      }
    },
    {
      "type": "track_rows",
      "label": "Songs",
      "bind": {
        "source": "package",
        "path": "playlist",
        "params": {
          "id": "$state.id"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_number_field": "track_number",
      "item_meta_field": "duration_s",
      "item_highlight_field": "playing",
      "play_label": "Play {title}",
      "on_play": {
        "play": {
          "media_id": "{id}"
        }
      },
      "row_actions": [
        {
          "icon": "x",
          "label": "Remove",
          "action": {
            "call": {
              "target": "/api/plugins/music/playlist",
              "args": {
                "op": "remove",
                "media_id": "{id}",
                "playlist_id": "{playlist_id}"
              }
            }
          }
        }
      ],
      "empty_state": {
        "type": "empty_state",
        "icon": "music",
        "text": "This playlist is empty. Press Add to playlist on Now playing."
      }
    },
    {
      "type": "creation_header",
      "variant": "collection",
      "part": "footer",
      "bind": {
        "source": "package",
        "path": "header",
        "params": {
          "id": "$state.id",
          "scope": "playlist"
        }
      },
      "share_change": {
        "add": {
          "call": {
            "target": "/api/plugins/music/actions/share-add",
            "args": {
              "id": "{id}",
              "person_id": "{person_id}"
            }
          }
        },
        "remove": {
          "call": {
            "target": "/api/plugins/music/actions/share-remove",
            "args": {
              "id": "{id}",
              "person_id": "{person_id}"
            }
          }
        },
        "make_private": {
          "call": {
            "target": "/api/plugins/music/actions/share-private",
            "args": {
              "id": "{id}"
            }
          }
        }
      }
    }
  ]
}
