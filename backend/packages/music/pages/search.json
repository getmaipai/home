{
  "type": "page",
  "id": "music-search",
  "title": "Search",
  "body": [
    {
      "type": "search",
      "state": "q",
      "label": "Search Music",
      "placeholder": "Search Music"
    },
    {
      "type": "media_shelf",
      "heading": "Results",
      "bind": {
        "source": "package",
        "path": "songs",
        "params": {
          "query": "$state.q"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "density": "compact",
      "empty_state": {
        "type": "empty_state",
        "icon": "music",
        "text": "No songs match. Try other words."
      },
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      }
    }
  ]
}
