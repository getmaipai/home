{
  "type": "page",
  "id": "artist",
  "title": "Artist",
  "body": [
    {
      "type": "creation_header",
      "variant": "collection",
      "bind": {
        "source": "package",
        "path": "header",
        "params": {
          "id": "$state.id",
          "scope": "artist"
        }
      },
      "share_change": {
        "add": {
          "call": {
            "target": "/api/plugins/music/actions/share-add",
            "args": {
              "id": "{id}",
              "person_id": "{person_id}"
            }
          }
        },
        "remove": {
          "call": {
            "target": "/api/plugins/music/actions/share-remove",
            "args": {
              "id": "{id}",
              "person_id": "{person_id}"
            }
          }
        },
        "make_private": {
          "call": {
            "target": "/api/plugins/music/actions/share-private",
            "args": {
              "id": "{id}"
            }
          }
        }
      },
      "primary": {
        "label": "Play",
        "icon": "play",
        "action": {
          "play": {
            "media_id": "{id}"
          }
        }
      },
      "shuffle": {
        "label": "Start radio",
        "action": {
          "play": {
            "media_id": "{radio_id}"
          }
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "Songs",
      "bind": {
        "source": "package",
        "path": "artist",
        "params": {
          "id": "$state.id"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "aspect": "square",
      "variant": "plain",
      "orientation": "vertical",
      "density": "compact",
      "item_meta_field": "duration_s",
      "item_highlight_field": "playing",
      "on_select": {
        "play": {
          "media_id": "{id}"
        }
      },
      "hide_when_empty": true
    },
    {
      "type": "media_shelf",
      "heading": "Albums",
      "bind": {
        "source": "package",
        "path": "artist-albums",
        "params": {
          "id": "$state.id"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "aspect": "square",
      "variant": "plain",
      "layout": "grid",
      "on_select": {
        "navigate": {
          "to": "/apps/music/album",
          "state": {
            "id": "{id}"
          }
        }
      },
      "hide_when_empty": true
    }
  ]
}
