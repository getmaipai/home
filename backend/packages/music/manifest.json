{
  "id": "music",
  "version": "0.3.15",
  "kind": "plugin",
  "category": "Media",
  "display": "Music",
  "description": "Play songs from your library, browse albums and artists, make playlists and start local radio.",
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "look up the artist Radiohead",
      "look up the artist Adele",
      "who is the singer Prince",
      "who is the singer Adele",
      "who is the singer in Radiohead",
      "open my music",
      "play my liked songs",
      "show my albums"
    ],
    "patterns": [
      "look up the artist *",
      "who is the singer *"
    ]
  },
  "args": {
    "type": "object",
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "incognito": "unaffected",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "degraded",
  "config": [],
  "data_sources": [
    {
      "id": "musicbrainz",
      "destination": "MusicBrainz's own public search API",
      "when": "someone asks about a music artist, in the background after a library scan, about one song a second, to match your songs to MusicBrainz, and when you press Create a band like this on a matched song, once, to read its artist's genre tags. Turn the background match off under Music settings.",
      "what": "for an artist question, the artist's name as typed; for the genre tags, the artist's public MusicBrainz id; for the background match, each song's title, artist, album and track number from its file, plus your home's internet address. Nothing anyone in the house said or saved goes with it: no name, account, cookie or listening history.",
      "who": "the MetaBrainz Foundation",
      "opt_in": false,
      "retention": "unknown, see MusicBrainz's own policy"
    },
    {
      "id": "wikimedia-artists",
      "destination": "Wikidata, Wikipedia and Wikimedia Commons (www.wikidata.org, en.wikipedia.org, commons.wikimedia.org, upload.wikimedia.org), and MusicBrainz once per artist to find the artist's Wikidata id",
      "when": "in the background after a library scan, once for each artist MusicBrainz matched, to keep one photo and a two-sentence bio on your computer for the Artist page. Turn it off under Music settings.",
      "what": "the artist's public MusicBrainz id, then the artist's public Wikidata id, Wikipedia page title and photo file name, plus your home's internet address. Never anyone's name, a song from your library, an account, a cookie or listening history. Nothing is asked for an artist under 18.",
      "who": "the Wikimedia Foundation and the MetaBrainz Foundation",
      "opt_in": false,
      "retention": "controlled entirely by the Wikimedia Foundation; see their own privacy policy"
    },
    {
      "id": "cover-art-archive",
      "destination": "the Cover Art Archive (coverartarchive.org, which hands the picture over from archive.org)",
      "when": "in the background after a library scan, once for each album that has no art in its files or folder and that MusicBrainz matched, to keep the front cover on your computer. Turn it off under Music settings.",
      "what": "the album's public MusicBrainz release group id, plus your home's internet address. Never anyone's name, a song title from your library, an account, a cookie or listening history.",
      "who": "the MetaBrainz Foundation and the Internet Archive",
      "opt_in": false,
      "retention": "unknown, see the Cover Art Archive's and the Internet Archive's own policies"
    }
  ],
  "permissions": [
    "net:musicbrainz.org",
    "net:www.wikidata.org",
    "net:en.wikipedia.org",
    "net:commons.wikimedia.org",
    "net:upload.wikimedia.org",
    "net:coverartarchive.org",
    "net:archive.org"
  ],
  "notifications": [],
  "cache": {
    "key_template": "music:artist:{query}",
    "ttl_s": 86400,
    "stale_ok_s": 604800,
    "max_bytes": 50000
  },
  "fallback_reply": {
    "text": "Sorry, I'm having trouble looking that up right now.",
    "speech": "Sorry, I'm having trouble looking that up right now."
  },
  "backup": "exclude",
  "background": false,
