{
  "id": "music",
  "version": "0.2.0",
  "kind": "plugin",
  "category": "Media",
  "display": "Music",
  "description": "Play songs from your library, browse albums and artists, make playlists and start local radio.",
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "look up the artist Radiohead",
      "look up the artist Adele",
      "who is the singer Prince",
      "who is the singer Adele",
      "who is the singer in Radiohead",
      "open my music",
      "play my liked songs",
      "show my albums"
    ],
    "patterns": [
      "look up the artist *",
      "who is the singer *"
    ]
  },
  "args": {
    "type": "object",
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "incognito": "unaffected",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "degraded",
  "config": [],
  "data_sources": [
    {
      "id": "musicbrainz",
      "destination": "MusicBrainz's own public search API",
      "when": "the household asks about a music artist",
      "what": "the artist's name as typed, nothing personal",
      "who": "the MetaBrainz Foundation",
      "opt_in": true,
      "retention": "unknown, see MusicBrainz's own policy"
    }
  ],
  "permissions": [
    "net:musicbrainz.org"
  ],
  "notifications": [],
  "cache": {
    "key_template": "music:artist:{query}",
    "ttl_s": 86400,
    "stale_ok_s": 604800,
    "max_bytes": 50000
  },
  "fallback_reply": {
    "text": "Sorry, I'm having trouble looking that up right now.",
    "speech": "Sorry, I'm having trouble looking that up right now."
  },
  "backup": "exclude",
  "background": false,
  "contributes": {
    "pages": [
      {
        "id": "index",
        "label": "Music",
        "icon": "music",
        "nav": true,
        "kind": "schema",
