{
  "id": "music",
  "version": "0.3.9",
  "kind": "plugin",
  "category": "Media",
  "display": "Music",
  "description": "Play songs from your library, browse albums and artists, make playlists and start local radio.",
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "look up the artist Radiohead",
      "look up the artist Adele",
      "who is the singer Prince",
      "who is the singer Adele",
      "who is the singer in Radiohead",
      "open my music",
      "play my liked songs",
      "show my albums"
    ],
    "patterns": [
      "look up the artist *",
      "who is the singer *"
    ]
  },
  "args": {
    "type": "object",
    "required": [
      "query"
    ],
    "properties": {
      "query": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "incognito": "unaffected",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "degraded",
  "config": [],
  "data_sources": [
    {
      "id": "musicbrainz",
      "destination": "MusicBrainz's own public search API",
      "when": "someone asks about a music artist, and in the background after a library scan, about one song a second, to match your songs to MusicBrainz. Turn the background match off under Music settings.",
      "what": "for an artist question, the artist's name as typed; for the background match, each song's title, artist, album and track number from its file, plus your home's internet address. Nothing anyone in the house said or saved goes with it: no name, account, cookie or listening history.",
      "who": "the MetaBrainz Foundation",
      "opt_in": false,
      "retention": "unknown, see MusicBrainz's own policy"
    }
  ],
  "permissions": [
    "net:musicbrainz.org"
  ],
  "notifications": [],
  "cache": {
    "key_template": "music:artist:{query}",
    "ttl_s": 86400,
    "stale_ok_s": 604800,
    "max_bytes": 50000
  },
  "fallback_reply": {
    "text": "Sorry, I'm having trouble looking that up right now.",
    "speech": "Sorry, I'm having trouble looking that up right now."
  },
  "backup": "exclude",
  "background": false,
  "contributes": {
    "sidebar": {
      "search": {
        "type": "search",
        "state": "q",
        "label": "Search Music",
        "placeholder": "Search Music",
        "submit": {
          "navigate": {
            "to": "/apps/music/search",
            "state": {
              "q": "{q}"
            }
          }
        }
      },
      "groups": [
        {
          "id": "play",
          "mode": "play",
          "pages": [
            "index",
            "radio",
            "songs",
            "albums",
            "artists",
            "playlists",
            "liked"
          ]
        },
        {
          "id": "create",
          "mode": "create",
          "pages": [
            "create",
            "make-song",
            "make-band",
            "creations"
          ]
        }
      ]
    },
