{
  "id": "elements",
  "version": "0.1.0",
  "kind": "app",
  "category": "Media",
  "display": "Elements",
  "description": "Characters, places and props you reuse in pictures, clips and films, all in one place.",
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "open Elements",
      "show my characters",
      "show my places and props",
      "find the character I saved",
      "where are my reusable props"
    ],
    "patterns": []
  },
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "degraded",
  "config": [],
  "data_sources": [],
  "permissions": [],
  "notifications": [],
  "backup": "exclude",
  "background": false,
  "contributes": {
    "sidebar": {
      "search": {
        "type": "search",
        "state": "q",
        "label": "Search Elements",
        "placeholder": "Search Elements",
        "submit": {
          "navigate": {
            "to": "/apps/elements/search",
            "state": {
              "q": "{q}"
            }
          }
        }
      },
      "groups": [
        {
          "id": "browse-elements",
          "pages": [
            "index",
            "characters",
            "places",
            "props",
            "looks"
          ],
          "mode": "browse"
        },
        {
          "id": "create-make",
          "mode": "create",
          "title": "Make",
          "pages": [
            "make"
          ]
        }
      ]
    },
    "pages": [
      {
        "id": "index",
        "label": "Elements",
        "icon": "layers",
        "nav": true,
        "kind": "schema",
        "module": "index"
      },
      {
        "id": "characters",
        "label": "Characters",
        "icon": "user-round",
        "nav": true,
        "kind": "schema",
        "module": "characters"
      },
      {
        "id": "places",
        "label": "Places",
        "icon": "map-pin",
        "nav": true,
        "kind": "schema",
        "module": "places"
      },
      {
        "id": "props",
        "label": "Props",
        "icon": "box",
        "nav": true,
        "kind": "schema",
        "module": "props"
      },
      {
        "id": "looks",
        "label": "Looks",
        "icon": "palette",
        "nav": true,
        "kind": "schema",
        "module": "looks"
      },
      {
        "id": "search",
        "label": "Search",
        "icon": "search",
        "nav": false,
        "kind": "schema",
        "module": "search"
      },
      {
        "id": "make",
        "label": "Make an element",
        "icon": "sparkles",
        "nav": true,
        "kind": "schema",
        "module": "make"
      },
      {
        "id": "element",
        "label": "Element",
        "icon": "layers",
        "nav": false,
        "kind": "schema",
        "module": "element"
      }
    ],
    "data": [
      {
        "id": "elements",
        "rows": "list"
      },
      {
        "id": "element",
        "rows": "list"
      },
      {
        "id": "element-pictures",
        "rows": "list"
      },
      {
        "id": "element-films",
        "rows": "list"
      },
      {
        "id": "element-actions",
        "rows": "list"
      },
      {
        "id": "element-edit",
        "rows": "list"
      },
      {
        "id": "element-voices",
        "rows": "list"
      },
      {
        "id": "looks",
        "rows": "list"
      }
    ],
    "header": {
      "search": {
        "label": "Search Elements"
      },
      "modes": [
        {
          "id": "browse",
          "label": "Browse",
          "icon": "layers",
          "page": "index"
        },
        {
          "id": "create",
          "label": "Make",
          "icon": "sparkles",
          "page": "make"
        }
      ]
    }
  },
  "smoke": {
    "kind": "static"
  },
  "incognito": "unaffected",
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze"
}
