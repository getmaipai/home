{
  "type": "page",
  "id": "elements-index",
  "title": "Elements",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Characters, places and props",
      "bind": {
        "source": "package",
        "path": "elements",
        "params": {}
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle}",
      "item_media_field": "thumbnail",
      "aspect": "square",
      "layout": "grid",
      "empty_state": {
        "type": "empty_state",
        "icon": "layers",
        "text": "Nothing saved yet. Characters, places and props you save will show here."
      },
      "on_select": {
        "navigate": {
          "to": "/apps/elements/element",
          "state": {
            "id": "{id}"
          }
        }
      }
    }
  ]
}
