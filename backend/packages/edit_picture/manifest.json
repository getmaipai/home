{
  "id": "edit_picture",
  "version": "0.2.0",
  "kind": "plugin",
  "category": "Media",
  "display": "Edit a Picture",
  "description": "Use an available picture operation on a picture in this conversation.",
  "offer": {
    "mode": "conditional",
    "gate": "pictureEditAllowed",
    "bench_row": "picture-edit-tool",
    "priority": 90
  },
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "args": {
    "type": "object",
    "required": [
      "op",
      "source",
      "args"
    ],
    "properties": {
      "op": {
        "type": "string",
        "maxLength": 80,
        "grounded": false
      },
      "source": {
        "type": "string",
        "maxLength": 80,
        "grounded": false
      },
      "args": {
        "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["clothes", "background", "face", "whole"],
          "description": "clothes: changing what someone wears; background: replacing what is behind the people; face: changing a face, such as a smile or glasses; whole: anything else, the whole picture may change."
        }
      },
        "grounded": false
      }
    }
  },
  "incognito": "ephemeral",
  "requires": [],
  "optional": [],
  "platforms": [
    "home"
  ],
  "min_role": "child",
  "consequential": false,
  "offline": "full",
  "data_sources": [],
  "permissions": [],
  "notifications": [],
  "backup": "exclude",
  "background": false,
  "contributes": {},
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": {
    "kind": "recipe_fixture",
    "fixture": "tests/smoke.json"
  },
  "config": [],
  "routing": {
    "examples": [
      "remove the man on the left from this picture",
      "make this picture look sunny",
      "take the background out of this photo",
      "combine these two pictures into one",
      "make the dog bigger",
      "turn this picture into a watercolor"
    ],
    "patterns": []
  }
}
