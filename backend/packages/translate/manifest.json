{
  "id": "translate",
  "version": "0.1.0",
  "kind": "plugin",
  "category": "Utilities",
  "display": "Translate",
  "description": "Translates text via the household's own local chat model - nothing leaves the house. A network translation service is a separate, opt-in package, not built yet.",
  "author": "MaiPai",
  "license": "AGPL-3.0",
  "homepage": "https://github.com/getmaipai/home",
  "routing": {
    "examples": [
      "translate hello to spanish",
      "translate good morning into french",
      "translate thank you to japanese",
      "translate how are you into german",
      "translate good night to italian"
    ],
    "patterns": ["translate *"]
  },
  "args": {
    "type": "object",
    "required": ["expression"],
    "properties": {
      "expression": { "type": "string", "minLength": 1 }
    }
  },
  "requires": [],
  "optional": [],
  "platforms": ["home", "bot"],
  "min_role": "child",
  "consequential": false,
  "offline": "full",
  "config": [],
  "data_sources": [],
  "permissions": ["llm:complete"],
  "notifications": [],
  "backup": "exclude",
  "background": false,
  "contributes": {},
  "pages": [],
  "min_app": "0.1.0",
  "tier": 0,
  "quality_scale": "bronze",
  "smoke": { "kind": "recipe_fixture", "fixture": "tests/smoke.json" }
}
