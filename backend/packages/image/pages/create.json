{
  "type": "page",
  "id": "image-create",
  "title": "Image",
  "body": [
    {
      "type": "prompt_bar",
      "placement": "inline",
      "layout": "chat",
      "chat_distribution": "start_end",
      "label": "Describe a picture",
      "placeholder": "Describe the picture you want. Type @ to add someone from your cast.",
      "prompt_state": "prompt",
      "max_length": 1200,
      "submit_label": "Make picture",
      "starts": "picture",
      "chips": [
        {
          "state": "shape",
          "label": "Shape",
          "default": "square",
          "group": "Settings",
          "icon": "rectangle-horizontal",
          "icon_only": true,
          "presentation": "popover",
          "options": [
            {
              "value": "square",
              "label": "Square",
              "icon": "square"
            },
            {
              "value": "landscape",
              "label": "Landscape",
              "icon": "rectangle-horizontal"
            },
            {
              "value": "portrait",
              "label": "Portrait",
              "icon": "rectangle-vertical"
            },
            {
              "value": "wide",
              "label": "Wide",
              "icon": "monitor"
            },
            {
              "value": "tall",
              "label": "Tall",
              "icon": "smartphone"
            }
          ]
        },
        {
          "state": "count",
          "label": "Pictures",
          "default": 1,
          "group": "Pictures",
          "icon": "layers",
          "icon_only": true,
          "presentation": "popover",
          "options": [
            {
              "value": 1,
              "label": "1 picture"
            },
            {
              "value": 2,
              "label": "2 pictures"
            },
            {
              "value": 3,
              "label": "3 pictures"
            },
            {
              "value": 4,
              "label": "4 pictures"
            },
            {
              "value": 5,
              "label": "5 pictures"
            },
            {
              "value": 6,
              "label": "6 pictures"
            },
            {
              "value": 7,
              "label": "7 pictures"
            },
            {
              "value": 8,
              "label": "8 pictures"
            }
          ]
        }
      ],
      "tier": {
        "state": "tier",
        "label": "Quality",
        "default": "standard",
        "tiers": [
          {
            "id": "standard",
            "label": "Standard",
            "hint": "Fast"
          },
          {
            "id": "boost",
            "label": "Boost",
            "hint": "More detail"
          },
          {
            "id": "max",
            "label": "Max",
            "hint": "Best quality"
          }
        ]
      },
      "references": [
        {
          "state": "reference",
          "label": "Image reference",
          "kind": "picture",
          "placement": "in_field"
        },
        {
          "state": "cast",
          "label": "Cast",
          "kind": "character",
          "placement": "row"
        }
      ],
      "submit": {
        "call": {
          "target": "/api/plugins/image/actions/make",
          "method": "POST",
          "args": {
            "prompt": "{prompt}",
            "shape": "{shape}",
            "count": "{count}",
            "tier": "{tier}",
            "reference": "{reference}",
            "cast": "{cast}"
          }
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "Your pictures",
      "bind": {
        "source": "package",
        "path": "recent"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle}",
      "item_media_field": "thumbnail",
      "aspect": "square",
      "on_select": {
        "navigate": {
          "to": "/apps/image/studio",
          "state": {
            "file": "{id}"
          }
        }
      }
    }
  ]
}
