{
  "type": "page",
  "id": "image-creations",
  "title": "My creations",
  "body": [
    {
      "type": "media_shelf",
      "heading": "My creations",
      "bind": {
        "source": "package",
        "path": "recent"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_media_field": "thumbnail",
      "item_subtitle_field": "{subtitle}",
      "item_badge_field": "badge",
      "item_meta_field": "meta",
      "aspect": "square",
      "layout": "grid",
      "on_select": {
        "navigate": {
          "to": "/apps/image/studio",
          "state": {
            "file": "{id}"
          }
        }
      }
    }
  ]
}
