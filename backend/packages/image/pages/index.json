{
  "type": "page",
  "id": "image-index",
  "title": "Image",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Templates",
      "bind": {
        "source": "package",
        "path": "templates"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle}",
      "item_media_field": "thumbnail",
      "item_badge_field": "badge",
      "item_meta_field": "meta",
      "item_progress_field": "progress",
      "making_field": "making",
      "poll_while": { "field": "making", "values": ["yes"] },
      "aspect": "square",
      "on_select": {
        "navigate": {
          "to": "/apps/image/templates"
        }
      }
    },
    {
      "type": "media_shelf",
      "heading": "Recently made",
      "bind": {
        "source": "package",
        "path": "recent"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle}",
      "item_media_field": "thumbnail",
      "aspect": "square",
      "on_select": {
        "navigate": {
          "to": "/apps/image/studio",
          "state": {
            "file": "{id}"
          }
        }
      }
    }
  ]
}
