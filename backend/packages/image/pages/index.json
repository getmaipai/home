{
  "type": "page",
  "id": "image-index",
  "title": "Image",
  "body": [
    {
      "type": "media_shelf",
      "heading": "Recently made",
      "variant": "plain",
      "see_all": {
        "label": "See all",
        "action": {
          "navigate": {
            "to": "/apps/image/recent"
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "image",
        "text": "Nothing made yet.",
        "action": {
          "navigate": {
            "to": "/apps/image/create"
          }
        },
        "action_label": "Make a picture"
      },
      "bind": {
        "source": "package",
        "path": "recent"
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{subtitle}",
      "item_media_field": "thumbnail",
      "item_badge_field": "badge",
      "item_meta_field": "meta",
      "item_progress_field": "progress",
      "making_field": "making",
      "poll_while": { "field": "making", "values": ["yes"] },
      "aspect": "square",
      "on_select": {
        "navigate": {
          "to": "/apps/image/studio",
          "state": {
            "file": "{id}"
          }
        }
      }
    }
  ]
}
