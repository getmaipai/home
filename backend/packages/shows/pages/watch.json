{
  "type": "page",
  "id": "watch",
  "title": "Watch",
  "body": [
    {
      "type": "split_view",
      "aside_label": "Up next",
      "main": [
        {
          "type": "player",
          "bind": {
            "source": "package",
            "path": "item",
            "params": {
              "id": "$state.id"
            }
          },
          "kind": "video",
          "autoplay_next": true,
          "details": true,
          "actions": [],
          "on_progress": {
            "call": {
              "target": "/api/plugins/shows/progress",
              "args": {
                "media_id": "{id}",
                "position_s": "{position_s}",
                "duration_s": "{duration_s}",
                "reason": "{reason}"
              }
            }
          },
          "on_next": {
            "play": {
              "media_id": "{id}"
            }
          },
          "empty_state": {
            "type": "empty_state",
            "icon": "film",
            "text": "This title is not available. Go back to Shows and Films and choose another."
          }
        }
      ],
      "aside": [
        {
          "type": "media_shelf",
          "heading": "Up next",
          "bind": {
            "source": "package",
            "path": "up-next",
            "params": {
              "id": "$state.id"
            }
          },
          "item_key_field": "id",
          "item_label_field": "title",
          "item_subtitle_field": "{channel}",
          "item_media_field": "thumbnail",
          "item_progress_field": "progress",
          "item_meta_field": "duration_s",
          "aspect": "wide",
          "variant": "plain",
          "orientation": "vertical",
          "hide_when_empty": true,
          "on_select": {
            "play": {
              "media_id": "{id}"
            }
          }
        }
      ]
    }
  ]
}
