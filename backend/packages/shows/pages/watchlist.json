{
  "type": "page",
  "id": "watchlist",
  "title": "Watchlist",
  "body": [
    {
      "type": "picker",
      "state": "status",
      "label": "Status",
      "leading": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "want",
          "label": "Want to watch"
        },
        {
          "value": "watching",
          "label": "Watching"
        },
        {
          "value": "completed",
          "label": "Completed"
        }
      ],
      "variant": "pill"
    },
    {
      "type": "media_shelf",
      "heading": "Watchlist",
      "bind": {
        "source": "package",
        "path": "watchlist",
        "params": {
          "status": "$state.status"
        }
      },
      "item_key_field": "id",
      "item_label_field": "title",
      "item_subtitle_field": "{channel}",
      "item_media_field": "thumbnail",
      "item_progress_field": "progress",
      "item_badge_field": "copy_label",
      "aspect": "poster",
      "variant": "plain",
      "on_select": {
        "navigate": {
          "to": "/apps/shows/{detail_page}?id={id}",
          "state": {
            "id": "{id}",
            "season": "{next_season}"
          }
        }
      },
      "empty_state": {
        "type": "empty_state",
        "icon": "film",
        "text": "No saved shows or films yet."
      },
      "layout": "grid"
    }
  ]
}
