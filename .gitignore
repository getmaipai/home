# Dependencies
node_modules/
.venv/

# Local data, never committed (org rule: nothing under data/ ever enters git)
data/

# Backups (2.5): encrypted, but still real household data end to end;
# same "never in git, ever" rule as data/.
backups/

# Editor/OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Bun/TS
*.tsbuildinfo

# frontend build output: served by backend/src/app.ts's serveStatic when
# present, built fresh (bun run build) rather than committed
frontend/dist/

# onnxruntime-web's WASM runtime (2026-09-04, the wake-word plan):
# copied from node_modules by frontend/scripts/copy-ort.mjs on every
# dev/build, ~38 MB, fully regenerable
frontend/public/ort/

# spec/ codegen intermediate (fully-dereferenced schemas, regenerated by
# gen-py.sh; spec/gen/ is the committed output, this is not)
spec/schemas.resolved/

# scripts/screenshot.ts's throwaway demo backend data - regenerated every
# run, never the real household, never committed
.demo-data/
