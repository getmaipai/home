# Dependencies
node_modules/
.venv/

# Local data, never committed (org rule: nothing under data/ ever enters git).
# data-a/, data-b/, ...: each parallel worktree session's own data
# directory (session-a-intelligence.md / session-b-ui.md's "own data
# directory and port" rule) - the same real household-shaped data as
# data/ itself, just per-worktree instead of shared.
data/
data-*/
# A worktree may symlink data-scratch/ to a sibling checkout's copy
# rather than duplicating it (ACT-02, lane 16: reusing already-
# downloaded public datasets across worktrees) - `data-*/` alone does
# not match a symlink (only a real directory), so the symlink itself
# needs its own line.
data-scratch

# Backups (2.5): encrypted, but still real household data end to end;
# same "never in git, ever" rule as data/.
backups/

# Editor/OS
.DS_Store

# Python
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Bun/TS
*.tsbuildinfo

# frontend build output: served by backend/src/app.ts's serveStatic when
# present, built fresh (bun run build) rather than committed
frontend/dist/

# onnxruntime-web's WASM runtime (2026-09-04, the wake-word plan):
# copied from node_modules by frontend/scripts/copy-ort.mjs on every
# dev/build, ~38 MB, fully regenerable
frontend/public/ort/

# scripts/screenshot.ts's throwaway demo backend data - regenerated every
# run, never the real household, never committed. Suffixed by a reserved
# port per run since #105 (two concurrent runs used to race on one shared
# .demo-data/, one's rmSync deleting the other's in-flight seed). Matches
# the script's own sweepStaleDemoDataDirs() filter exactly (a code review
# caught a bare `.demo-data*/` as broader than that filter - it would also
# match an unrelated future `.demo-data<word>/` directory the sweep would
# never touch) - the bare legacy name from before #105, or a hyphen then
# the reserved port number.
.demo-data/
.demo-data-*/

# scripts/screenshot.ts's non-Chromium output (issue #76): only Chromium's
# renders are the published docs screenshots; every other browser (--webkit,
# used for a11y/keyboard-trap verification, not screenshot review) writes
# here instead so it can never overwrite them.
docs/assets/screens/webkit/
docs/assets/webkit/

# ACT-02: backend/scripts/train/turn-signal-heads.ts's own output - the
# trained weight artifacts (never a tracked file; they ship as a catalog
# model package instead, docs/dev.md section 12) and its staging report,
# folded into docs/dev.md by hand rather than committed as a second copy.
backend/scripts/train/out/
