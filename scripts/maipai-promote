#!/usr/bin/env bash
set -euo pipefail
ROOT="${MAIPAI_INSTALL_ROOT:-/usr/local/maipai-home}"
MIRROR="/usr/local/maipai-home-src.git"
REMOTE="https://github.com/getmaipai/home.git"
usage() { echo "usage: maipai-promote <7-40 lowercase hex SHA> | --rollback [<tag>] | --check" >&2; }
fail() { echo "maipai-promote: $1" >&2; exit "${2:-1}"; }
[[ "$(id -u)" == 0 ]] || fail "run it with sudo." 77
[[ $# == 1 || ( $# == 2 && "$1" == --rollback ) ]] || { usage; exit 64; }
case "$1" in
  --check) echo ok; exit 0 ;;
  --rollback) rb_args=(); if [[ $# == 2 ]]; then [[ "$2" =~ ^(v[0-9]+\.[0-9]+\.[0-9]+|sha-[0-9a-f]{7})$ ]] || { usage; exit 64; }; rb_args=(--to "$2"); fi
    [[ -f "$ROOT/scripts/install.sh" ]] || fail "no installed installer at $ROOT/scripts/install.sh; repair the live install first."; exec bash "$ROOT/scripts/install.sh" --rollback ${rb_args[@]+"${rb_args[@]}"} ;;
esac
[[ "$1" =~ ^[0-9a-f]{7,40}$ ]] || { usage; exit 64; }
if [[ ! -d "$MIRROR" ]]; then git clone --bare "$REMOTE" "$MIRROR" || fail "could not create $MIRROR; check Git access and retry." 75; else git -C "$MIRROR" fetch --prune origin '+refs/heads/*:refs/heads/*' || fail "could not refresh $MIRROR; check Git access and retry." 75; fi
[[ "$(stat -f '%u' "$MIRROR" 2>/dev/null)" == 0 ]] || fail "$MIRROR is not root-owned; remove it as root and retry so untrusted files cannot be installed." 75
[[ -z "$(find "$MIRROR" \( -perm -002 -o -perm -020 \) -print -quit 2>/dev/null)" ]] || fail "$MIRROR contains group- or user-writable files; secure it as root before retrying." 75
git -C "$MIRROR" rev-parse --verify "$1^{commit}" >/dev/null 2>&1 || fail "commit $1 is missing from the mirror; check the SHA and retry." 75
git -C "$MIRROR" merge-base --is-ancestor "$1" main || fail "commit $1 is not on main; land it first." 75
sha="$(git -C "$MIRROR" rev-parse "$1^{commit}")"
tmp="$(mktemp -d)" || fail "could not create a temporary folder; check disk space and retry." 75
trap 'rm -rf "$tmp"' EXIT
# The extract fails now and then for a moment (2026-10-31); try once more after 2 s, then stop with the hub untouched (exit 75 = nothing was installed or changed).
extract_installer() { git -C "$MIRROR" archive "$sha" scripts/install.sh | tar -x -C "$tmp"; }
if ! extract_installer; then sleep 2; extract_installer || fail "could not extract the commit installer; nothing was installed and the hub is untouched. Check the mirror and retry." 75; fi
if MAIPAI_SOURCE_MIRROR="$MIRROR" MAIPAI_SOURCE_REMOTE="$REMOTE" bash "$tmp/scripts/install.sh" --commit "$sha"; then exit 0; else status=$?; exit "$status"; fi
