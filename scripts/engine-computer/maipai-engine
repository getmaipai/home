#!/usr/bin/env bash
set -euo pipefail

STACK_USER=maipai-stack
STACK_HOME=/home/maipai-stack
STACK_DATA=/data/stack
STACK_ROOT=/opt/maipai-stack
STACK_STORE=/data/stack/engines
PAIR_FILE="${MAIPAI_ENGINE_PAIR_FILE:-/var/lib/maipai-stack/paired-home.json}"
AUTH_KEYS="${MAIPAI_ENGINE_AUTH_KEYS:-$STACK_HOME/.ssh/authorized_keys}"
STACK_TAG="3e1172173bba41c18c6842f844b3c7a9f4698979"
STACK_REPO=getmaipai/stack
DRY_RUN=no
# The scratch folder update() builds in. A global on purpose: a trap that names a function's local variable
# outlives the function and fires again, later, where that local no longer exists (ENGINE-TRAP-01).
UPDATE_WORK=""

say() { printf '%s\n' "$*"; }
die() { say "error: $*" >&2; exit 1; }
dry() { [ "$DRY_RUN" = yes ]; }
need_root() { [ "$(id -u)" -eq 0 ] || die "Run with sudo."; }

usage() {
  say "Usage: maipai-engine [--dry-run] pair <home> <code> [--replace]"
  say "       maipai-engine [--dry-run] unpair|update|status|doctor"
}

doctor() {
  local uid linger active enabled listeners matching_keys
  uid=$(id -u "$STACK_USER" 2>/dev/null || true)
  active=no; enabled=no; linger=no
  if [ -n "$uid" ]; then
    if [ -z "${XDG_RUNTIME_DIR:-}" ]; then export XDG_RUNTIME_DIR="/run/user/$uid"; fi
    systemctl --user is-active --quiet maipai-stack.service && active=yes || true
    systemctl --user is-enabled --quiet maipai-stack.service && enabled=yes || true
    [ "$(loginctl show-user "$STACK_USER" -p Linger --value 2>/dev/null || true)" = yes ] && linger=yes
  fi
  [ "$active" = yes ] && [ "$enabled" = yes ] && [ "$linger" = yes ] \
    && say "PASS hop 1: service active, enabled, linger on" \
    || say "FAIL hop 1: service active=$active enabled=$enabled linger=$linger"
  [ "$active" = yes ] && [ "$enabled" = yes ] && [ "$linger" = yes ] \
    && say "Fix hop 1: no action needed." \
    || say "Fix hop 1: sudo loginctl enable-linger maipai-stack"

  listeners=$(ss -H -ltn 'sport = :8770' 2>/dev/null | awk '{print $4}')
  if [ -n "$listeners" ] && ! printf '%s\n' "$listeners" | grep -Ev '^127\.0\.0\.1:8770$|^\[::1\]:8770$' | grep -q .; then
    say "PASS hop 2: listener is loopback-only on 8770"
    say "Fix hop 2: no action needed."
  else
    say "FAIL hop 2: listener is absent or not loopback-only"
    say "Fix hop 2: bind Stack to 127.0.0.1:8770"
  fi

  if nvidia-smi -L >/dev/null 2>&1 && [ -n "$(nvidia-smi -L 2>/dev/null)" ]; then
    say "PASS hop 3: NVIDIA GPUs are visible"
    say "Fix hop 3: no action needed."
  else
    say "FAIL hop 3: nvidia-smi found no GPUs"
    say "Fix hop 3: install the NVIDIA driver"
  fi

  local engine_current engine_target
  engine_current="${MAIPAI_ENGINE_CURRENT:-$STACK_STORE/llama-server/current}"
  if [ -L "$engine_current" ]; then engine_target="$(readlink -f "$engine_current")"; else engine_target="${MAIPAI_PINNED_ENGINE:-}"; fi
  if [ -n "$engine_target" ] && [ -x "$engine_target/llama-server" ] && [ -f "$engine_target/.engine-ready" ] && "$engine_target/llama-server" --version 2>/dev/null | grep -q 'b10797'; then
    say "PASS hop 4: pinned llama-server b10797 is present"
    say "Fix hop 4: no action needed."
  else
    say "FAIL hop 4: pinned llama-server b10797 is missing"
    say "Fix hop 4: sudo maipai-engine update"
  fi

  if current=$(read_pair 2>/dev/null); then
    local paired_key expected_line
    paired_key=$(read_pair_key 2>/dev/null || true)
    expected_line="restrict,port-forwarding,permitopen=\"127.0.0.1:8770\" $paired_key"
    matching_keys=$(awk -v expected="$expected_line" '$0 == expected { n++ } END { print n+0 }' "$AUTH_KEYS" 2>/dev/null)
    if [ -n "$paired_key" ] && [ "$matching_keys" = 1 ] && [ "$(wc -l < "$AUTH_KEYS" | tr -d ' ')" = 1 ]; then
      say "PASS hop 5: one restricted key matches the paired household"
      say "Fix hop 5: no action needed."
    else
      say "FAIL hop 5: restricted authorized key is missing or duplicated"
      say "Fix hop 5: sudo maipai-engine pair HOME CODE"
    fi
  else
    say "FAIL hop 5: no paired household"
    say "Fix hop 5: sudo maipai-engine pair HOME CODE"
  fi
}

normalize_code() { printf '%s' "$1" | tr -d '-' | tr '[:lower:]' '[:upper:]'; }

read_pair() {
  [ -f "$PAIR_FILE" ] || return 1
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["household_id"])' "$PAIR_FILE"
}

read_pair_key() {
  [ -f "$PAIR_FILE" ] || return 1
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("authorized_key", ""))' "$PAIR_FILE"
}

read_pair_code_hash() {
  [ -f "$PAIR_FILE" ] || return 1
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("code_hash", ""))' "$PAIR_FILE"
}

print_check_code() {
  local actual host_key_pub
  host_key_pub="${MAIPAI_ENGINE_HOST_KEY_PUB:-/etc/ssh/ssh_host_ed25519_key.pub}"
  actual=$(ssh-keygen -lf "$host_key_pub" -E sha256 | python3 -c 'import base64,sys; fingerprint=sys.stdin.read().split()[1].split(":",1)[1]; digest=base64.b64decode(fingerprint + "=" * (-len(fingerprint) % 4)); print(base64.b32encode(digest).decode().rstrip("=")[:12])')
  say "Check code: ${actual:0:12}"
}

pair() {
  local home="$1" code="$2" replace="$3" current code_hash
  code=$(normalize_code "$code")
  [[ "$code" =~ ^[A-Z2-7]{12}$ ]] || die "Pair code must be 12 base32 characters."
  code_hash=$(printf '%s' "$code" | sha256sum | awk '{print $1}')
  if [[ "$home" != http://* && "$home" != https://* ]]; then
    if [[ "$home" == *:* ]]; then home="http://${home}";
    else home="http://${home}:3000"; fi
  fi
  if current=$(read_pair 2>/dev/null); then
    if [ "$(read_pair_code_hash 2>/dev/null || true)" = "$code_hash" ]; then
      say "Already paired to household ${current}."
      print_check_code
      return 0
    fi
    if [ "$replace" != yes ]; then
      say "Already paired. Use --replace to switch households."
      return 1
    fi
  fi
  if dry; then
    say "[dry-run] Would fetch and verify the pairing response."
    say "[dry-run] Would write one restricted authorized_keys line."
    say "[dry-run] Would record the household id."
    say "[dry-run] Check code: AAAAAAAAAAAA"
    return 0
  fi
  need_root
  local key household response_tool response
  response_tool="$(dirname "$0")/pair-response.py"
  [ -f "$response_tool" ] || response_tool=/usr/local/lib/maipai-engine/pair-response.py
  response=$(python3 "$response_tool" "$home" "$code") \
    || die "Pairing did not finish. The message above says what went wrong and what to do. Fix that, then run sudo maipai-engine pair again with a new code from Home."
  local fields=() field
  while IFS= read -r field; do fields+=("$field"); done <<< "$response"
  key="${fields[0]}"
  household="${fields[1]}"
  if [ -n "${current:-}" ] && [ "$current" != "$household" ] && [ "$replace" = yes ]; then
    unpair_real
  fi
  install -d -o "$STACK_USER" -g "$STACK_USER" -m 0700 "$STACK_HOME/.ssh"
  local line="restrict,port-forwarding,permitopen=\"127.0.0.1:8770\" $key"
  touch "$AUTH_KEYS"
  chmod 0600 "$AUTH_KEYS"
  printf '%s\n' "$line" > "$AUTH_KEYS"
  chown "$STACK_USER:$STACK_USER" "$AUTH_KEYS"
  install -d -o root -g root -m 0755 "$(dirname "$PAIR_FILE")"
  python3 - "$PAIR_FILE" "$household" "$code_hash" "$key" <<'PY'
import json, os, sys, tempfile
path, household, code_hash, authorized_key = sys.argv[1:]
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, 'w') as out:
    json.dump({'household_id': household, 'code_hash': code_hash, 'authorized_key': authorized_key}, out)
    out.write('\n')
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY
  chown root:root "$PAIR_FILE"
  say "Paired household ${household}."
  print_check_code
}

unpair_real() {
  rm -f "$PAIR_FILE"
  install -d -o "$STACK_USER" -g "$STACK_USER" -m 0700 "$(dirname "$AUTH_KEYS")"
  : > "$AUTH_KEYS"
  chown "$STACK_USER:$STACK_USER" "$AUTH_KEYS" 2>/dev/null || true
  chmod 0600 "$AUTH_KEYS" 2>/dev/null || true
}

unpair() {
  if dry; then
    say "[dry-run] Would remove the paired household record."
    say "[dry-run] Would clear the restricted authorized_keys entry."
    return 0
  fi
  need_root
  unpair_real
  say "Engine computer unpaired."
}

# The Stack's backend/package.json points at its Commons packages as
# file:../../commons-tags/<package>-<tag>/<package>. The work folder is laid out so those paths
# resolve: <work>/stack is the Stack, <work>/commons-tags/<package>-<tag>/<package> is each package.
# These helpers are the same as in scripts/install.sh (a test keeps the two equal).
log() { say "$@"; }

sha256_file() {
  local file="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
  else
    shasum -a 256 "$file" | awk '{print $1}'
  fi
}

