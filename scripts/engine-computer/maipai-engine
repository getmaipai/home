#!/usr/bin/env bash
set -euo pipefail

STACK_USER=maipai-stack
STACK_HOME=/home/maipai-stack
STACK_DATA=/data/stack
STACK_ROOT=/opt/maipai-stack
STACK_STORE=/data/stack/engines
PAIR_FILE="${MAIPAI_ENGINE_PAIR_FILE:-/var/lib/maipai-stack/paired-home.json}"
AUTH_KEYS="${MAIPAI_ENGINE_AUTH_KEYS:-$STACK_HOME/.ssh/authorized_keys}"
STACK_TAG=60b887c5704bd94bc742254cce48e4d34b1fd035
STACK_REPO=getmaipai/stack
DRY_RUN=no

say() { printf '%s\n' "$*"; }
die() { say "error: $*" >&2; exit 1; }
dry() { [ "$DRY_RUN" = yes ]; }
need_root() { [ "$(id -u)" -eq 0 ] || die "Run with sudo."; }

usage() {
  say "Usage: maipai-engine [--dry-run] pair <home> <code> [--replace]"
  say "       maipai-engine [--dry-run] unpair|update|status|doctor"
}

doctor() {
  local uid linger active enabled listeners matching_keys
  uid=$(id -u "$STACK_USER" 2>/dev/null || true)
  active=no; enabled=no; linger=no
  if [ -n "$uid" ]; then
    if [ -z "${XDG_RUNTIME_DIR:-}" ]; then export XDG_RUNTIME_DIR="/run/user/$uid"; fi
    systemctl --user is-active --quiet maipai-stack.service && active=yes || true
    systemctl --user is-enabled --quiet maipai-stack.service && enabled=yes || true
    [ "$(loginctl show-user "$STACK_USER" -p Linger --value 2>/dev/null || true)" = yes ] && linger=yes
  fi
  [ "$active" = yes ] && [ "$enabled" = yes ] && [ "$linger" = yes ] \
    && say "PASS hop 1: service active, enabled, linger on" \
    || say "FAIL hop 1: service active=$active enabled=$enabled linger=$linger"
  [ "$active" = yes ] && [ "$enabled" = yes ] && [ "$linger" = yes ] \
    && say "Fix hop 1: no action needed." \
    || say "Fix hop 1: sudo loginctl enable-linger maipai-stack"

  listeners=$(ss -H -ltn 'sport = :8770' 2>/dev/null | awk '{print $4}')
  if [ -n "$listeners" ] && ! printf '%s\n' "$listeners" | grep -Ev '^127\.0\.0\.1:8770$|^\[::1\]:8770$' | grep -q .; then
    say "PASS hop 2: listener is loopback-only on 8770"
    say "Fix hop 2: no action needed."
  else
    say "FAIL hop 2: listener is absent or not loopback-only"
    say "Fix hop 2: bind Stack to 127.0.0.1:8770"
  fi

  if nvidia-smi -L >/dev/null 2>&1 && [ -n "$(nvidia-smi -L 2>/dev/null)" ]; then
    say "PASS hop 3: NVIDIA GPUs are visible"
    say "Fix hop 3: no action needed."
  else
    say "FAIL hop 3: nvidia-smi found no GPUs"
    say "Fix hop 3: install the NVIDIA driver"
  fi

  local engine_current engine_target
  engine_current="${MAIPAI_ENGINE_CURRENT:-$STACK_STORE/llama-server/current}"
  if [ -L "$engine_current" ]; then engine_target="$(readlink -f "$engine_current")"; else engine_target="${MAIPAI_PINNED_ENGINE:-}"; fi
  if [ -n "$engine_target" ] && [ -x "$engine_target/llama-server" ] && [ -f "$engine_target/.engine-ready" ] && "$engine_target/llama-server" --version 2>/dev/null | grep -q 'b10797'; then
    say "PASS hop 4: pinned llama-server b10797 is present"
    say "Fix hop 4: no action needed."
  else
    say "FAIL hop 4: pinned llama-server b10797 is missing"
    say "Fix hop 4: sudo maipai-engine update"
  fi

  if current=$(read_pair 2>/dev/null); then
    local paired_key expected_line
    paired_key=$(read_pair_key 2>/dev/null || true)
    expected_line="restrict,port-forwarding,permitopen=\"127.0.0.1:8770\" $paired_key"
    matching_keys=$(awk -v expected="$expected_line" '$0 == expected { n++ } END { print n+0 }' "$AUTH_KEYS" 2>/dev/null)
    if [ -n "$paired_key" ] && [ "$matching_keys" = 1 ] && [ "$(wc -l < "$AUTH_KEYS" | tr -d ' ')" = 1 ]; then
      say "PASS hop 5: one restricted key matches the paired household"
      say "Fix hop 5: no action needed."
    else
      say "FAIL hop 5: restricted authorized key is missing or duplicated"
      say "Fix hop 5: sudo maipai-engine pair HOME CODE"
    fi
  else
    say "FAIL hop 5: no paired household"
    say "Fix hop 5: sudo maipai-engine pair HOME CODE"
  fi
}

normalize_code() { printf '%s' "$1" | tr -d '-' | tr '[:lower:]' '[:upper:]'; }

read_pair() {
  [ -f "$PAIR_FILE" ] || return 1
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["household_id"])' "$PAIR_FILE"
}

read_pair_key() {
  [ -f "$PAIR_FILE" ] || return 1
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("authorized_key", ""))' "$PAIR_FILE"
}

read_pair_code_hash() {
  [ -f "$PAIR_FILE" ] || return 1
  python3 -c 'import json,sys; print(json.load(open(sys.argv[1])).get("code_hash", ""))' "$PAIR_FILE"
}

print_check_code() {
  local actual host_key_pub
  host_key_pub="${MAIPAI_ENGINE_HOST_KEY_PUB:-/etc/ssh/ssh_host_ed25519_key.pub}"
  actual=$(ssh-keygen -lf "$host_key_pub" -E sha256 | python3 -c 'import base64,sys; fingerprint=sys.stdin.read().split()[1].split(":",1)[1]; digest=base64.b64decode(fingerprint + "=" * (-len(fingerprint) % 4)); print(base64.b32encode(digest).decode().rstrip("=")[:12])')
  say "Check code: ${actual:0:12}"
}

pair() {
  local home="$1" code="$2" replace="$3" current code_hash
  code=$(normalize_code "$code")
  [[ "$code" =~ ^[A-Z2-7]{12}$ ]] || die "Pair code must be 12 base32 characters."
  code_hash=$(printf '%s' "$code" | sha256sum | awk '{print $1}')
  if [[ "$home" != http://* && "$home" != https://* ]]; then
    if [[ "$home" == *:* ]]; then home="http://${home}";
    else home="http://${home}:3000"; fi
  fi
  if current=$(read_pair 2>/dev/null); then
    if [ "$(read_pair_code_hash 2>/dev/null || true)" = "$code_hash" ]; then
      say "Already paired to household ${current}."
      print_check_code
      return 0
    fi
    if [ "$replace" != yes ]; then
      say "Already paired. Use --replace to switch households."
      return 1
    fi
  fi
  if dry; then
    say "[dry-run] Would fetch and verify the pairing response."
    say "[dry-run] Would write one restricted authorized_keys line."
    say "[dry-run] Would record the household id."
    say "[dry-run] Check code: AAAAAAAAAAAA"
    return 0
  fi
  need_root
  local key household response_tool response
  response_tool="$(dirname "$0")/pair-response.py"
  [ -f "$response_tool" ] || response_tool=/usr/local/lib/maipai-engine/pair-response.py
  response=$(python3 "$response_tool" "$home" "$code") \
    || die "Could not fetch or verify pairing details."
  local fields=() field
  while IFS= read -r field; do fields+=("$field"); done <<< "$response"
  key="${fields[0]}"
  household="${fields[1]}"
  if [ -n "${current:-}" ] && [ "$current" != "$household" ] && [ "$replace" = yes ]; then
    unpair_real
  fi
  install -d -o "$STACK_USER" -g "$STACK_USER" -m 0700 "$STACK_HOME/.ssh"
  local line="restrict,port-forwarding,permitopen=\"127.0.0.1:8770\" $key"
  touch "$AUTH_KEYS"
  chmod 0600 "$AUTH_KEYS"
  printf '%s\n' "$line" > "$AUTH_KEYS"
  chown "$STACK_USER:$STACK_USER" "$AUTH_KEYS"
  install -d -o root -g root -m 0755 "$(dirname "$PAIR_FILE")"
  python3 - "$PAIR_FILE" "$household" "$code_hash" "$key" <<'PY'
import json, os, sys, tempfile
path, household, code_hash, authorized_key = sys.argv[1:]
fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path))
with os.fdopen(fd, 'w') as out:
    json.dump({'household_id': household, 'code_hash': code_hash, 'authorized_key': authorized_key}, out)
    out.write('\n')
os.chmod(tmp, 0o600)
os.replace(tmp, path)
PY
  chown root:root "$PAIR_FILE"
  say "Paired household ${household}."
  print_check_code
}

unpair_real() {
  rm -f "$PAIR_FILE"
  install -d -o "$STACK_USER" -g "$STACK_USER" -m 0700 "$(dirname "$AUTH_KEYS")"
  : > "$AUTH_KEYS"
  chown "$STACK_USER:$STACK_USER" "$AUTH_KEYS" 2>/dev/null || true
  chmod 0600 "$AUTH_KEYS" 2>/dev/null || true
}

unpair() {
  if dry; then
    say "[dry-run] Would remove the paired household record."
    say "[dry-run] Would clear the restricted authorized_keys entry."
    return 0
  fi
  need_root
  unpair_real
  say "Engine computer unpaired."
}

# The Stack's backend/package.json points at its Commons packages as
# file:../../commons-tags/<package>-<tag>/<package>. The work folder is laid out so those paths
# resolve: <work>/stack is the Stack, <work>/commons-tags/<package>-<tag>/<package> is each package.
# These helpers are the same as in scripts/install.sh (a test keeps the two equal).
log() { say "$@"; }

sha256_file() {
  local file="$1"
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$file" | awk '{print $1}'
  else
    shasum -a 256 "$file" | awk '{print $1}'
  fi
}

# The SHA-256 of GitHub's archive for one Commons tag (the tags the Stack at STACK_TAG names).
# Fails, printing nothing, for a tag with no pinned digest.
commons_archive_sha256() {
  case "$1" in
    core-v0.1.0) printf '%s\n' "d3c60aec818e73c00079e5a819d86477ecb590a0172f214a0aee80890d8427f4" ;;
    spec-v0.1.95) printf '%s\n' "42cce9e73007b395cc7f6f742a43f20a6032f7f0baf4da82869affce3c5a9903" ;;
    *) return 1 ;;
  esac
}

# The Commons packages a Stack's backend/package.json names, one per line as "<package> <dir> <tag>":
# file:../../commons-tags/<dir>/<package> with <dir> = <package>-<tag>. This is the one place the pins
# come from, so they cannot drift from the Stack at STACK_TAG.
stack_commons_deps() {
  local manifest="$1" line pkg dir leaf tag found=0
  while IFS= read -r line; do
    pkg=$(printf '%s\n' "$line" | sed -n 's#.*"@maipai/\([a-z][a-z0-9-]*\)"[[:space:]]*:[[:space:]]*"file:\.\./\.\./commons-tags/\([^/"]*\)/\([^/"]*\)".*#\1#p')
    dir=$(printf '%s\n' "$line" | sed -n 's#.*"@maipai/\([a-z][a-z0-9-]*\)"[[:space:]]*:[[:space:]]*"file:\.\./\.\./commons-tags/\([^/"]*\)/\([^/"]*\)".*#\2#p')
    leaf=$(printf '%s\n' "$line" | sed -n 's#.*"@maipai/\([a-z][a-z0-9-]*\)"[[:space:]]*:[[:space:]]*"file:\.\./\.\./commons-tags/\([^/"]*\)/\([^/"]*\)".*#\3#p')
    [ -n "$pkg" ] || continue
    if [ "$leaf" != "$pkg" ] || [ "${dir#"${pkg}-"}" = "$dir" ]; then
      log "The Stack's backend/package.json names @maipai/${pkg} as ${dir}/${leaf}, which is not <package>-<tag>/<package>. The Stack was bumped to a layout this script does not know; update stack_commons_deps in scripts/install.sh and scripts/engine-computer/maipai-engine."
      return 1
    fi
    tag="${dir#"${pkg}-"}"
    printf '%s %s %s\n' "$pkg" "$dir" "$tag"
    found=1
  done < "$manifest"
  [ "$found" = 1 ] || { log "The Stack's backend/package.json names no Commons package under ../../commons-tags/. Check that STACK_TAG points at the Stack commit this installer was written for."; return 1; }
}

# One Commons package into <workspace>/commons-tags/<dir>/<package>, the place the Stack's
# file:../../commons-tags/<dir>/<package> resolves to from <workspace>/stack/backend.
fetch_one_stack_commons() {
  local work="$1" pkg="$2" dir="$3" tag="$4" expected actual tmp dest="$1/commons-tags/$3"
  if ! expected=$(commons_archive_sha256 "$tag"); then
    log "The Stack needs Commons ${tag}, and this script has no pinned SHA-256 for it. Add the SHA-256 of https://github.com/getmaipai/commons/archive/refs/tags/${tag}.tar.gz to commons_archive_sha256 in scripts/install.sh and scripts/engine-computer/maipai-engine, then run this again."
    return 1
  fi
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' RETURN
  log "Fetching getmaipai/commons@${tag}..."
  if ! curl -fsSL "https://github.com/getmaipai/commons/archive/refs/tags/${tag}.tar.gz" -o "${tmp}/commons.tar.gz"; then
    log "Could not download Commons ${tag} from https://github.com/getmaipai/commons/archive/refs/tags/${tag}.tar.gz. Check that this computer can reach github.com, then run this again."
    trap - RETURN
    rm -rf "$tmp"
    return 1
  fi
  if ! actual=$(sha256_file "${tmp}/commons.tar.gz"); then
    log "Could not compute the SHA-256 of the Commons ${tag} download. Install sha256sum (or shasum), then run this again."
    trap - RETURN
    rm -rf "$tmp"
    return 1
  fi
  if [ "$actual" != "$expected" ]; then
    log "Commons ${tag} archive SHA-256 mismatch: expected ${expected}, got ${actual}. The download may be damaged: run this again, and if it fails the same way, do not continue and report both digests."
    trap - RETURN
    rm -rf "$tmp"
    return 1
  fi
  if ! mkdir -p "$dest"; then
    log "Could not create ${dest}. Check that the folder is writable, then run this again."
    trap - RETURN
    rm -rf "$tmp"
    return 1
  fi
  if ! tar -xzf "${tmp}/commons.tar.gz" -C "$dest" --strip-components=1 "commons-${tag}/${pkg}"; then
    log "Could not unpack ${pkg} from the Commons ${tag} archive. Run this again; if it repeats, the archive no longer has a ${pkg} folder and the Stack pin needs a new tag."
    trap - RETURN
    rm -rf "$tmp"
    return 1
  fi
  if [ ! -f "${dest}/${pkg}/package.json" ]; then
    log "Commons ${tag} archive is missing ${pkg}/package.json. The Stack pin needs a Commons tag that has it."
    trap - RETURN
    rm -rf "$tmp"
    return 1
  fi
  trap - RETURN
  rm -rf "$tmp"
}

# Every Commons package the fetched Stack names, laid beside it: <workspace>/stack is the Stack,
# <workspace>/commons-tags/<package>-<tag>/<package> is each package, so ../../commons-tags/... from
# <workspace>/stack/backend resolves (core and spec at STACK_TAG). Reads the names from the Stack's
# own backend/package.json, so call it after the Stack is unpacked.
fetch_stack_commons() {
  local work="$1" dry_run="$2"
  if [ "$dry_run" = "yes" ]; then
    log "[dry-run] would fetch each getmaipai/commons tag named in ${work}/stack/backend/package.json (known: core-v0.1.0 sha256 $(commons_archive_sha256 core-v0.1.0), spec-v0.1.95 sha256 $(commons_archive_sha256 spec-v0.1.95)) into ${work}/commons-tags/<package>-<tag>/<package>"
    return 0
  fi
  local manifest="${work}/stack/backend/package.json" deps pkg dir tag
  if [ ! -f "$manifest" ]; then
    log "The Stack's backend/package.json is not at ${manifest}, so its Commons packages cannot be read. Fetch the Stack source into ${work}/stack first, then run this again."
    return 1
  fi
  deps=$(stack_commons_deps "$manifest") || return 1
  while read -r pkg dir tag; do
    fetch_one_stack_commons "$work" "$pkg" "$dir" "$tag" || return 1
  done <<< "$deps"
}

# The Stack's build-binary.sh clears its OUT_DIR before it compiles, and the Bun runtime lives inside
# STACK_ROOT, so the build goes to a scratch folder and only the compiled files are copied in.
publish_stack_binary() {
  local built_dir="$1" out_dir="$2" binary_name="$3" artifact
  mkdir -p "$out_dir" || return 1
  for artifact in "$binary_name" migrations backend-src; do
    [ -e "${built_dir}/${artifact}" ] || return 1
    rm -rf "${out_dir:?}/${artifact}" || return 1
    cp -a "${built_dir}/${artifact}" "$out_dir/" || return 1
  done
}

update() {
  if dry; then
    say "[dry-run] Would fetch Stack at pinned STACK_TAG into a scratch folder."
    say "[dry-run] Would fetch the Commons packages its backend/package.json names (core-v0.1.0 and spec-v0.1.95) beside it, each checked against a pinned SHA-256."
    say "[dry-run] Would rebuild and restart maipai-stack."
    return 0
  fi
  need_root
  local work bun_bin os arch binary_name
  work=$(mktemp -d)
  trap 'rm -rf "$work"' RETURN
  mkdir -p "$work/stack"
  curl -fsSL "https://github.com/${STACK_REPO}/archive/${STACK_TAG}.tar.gz" -o "$work/stack.tgz" \
    || die "Could not download the Stack from https://github.com/${STACK_REPO}/archive/${STACK_TAG}.tar.gz. Check that this computer can reach github.com, then run sudo maipai-engine update again."
  tar -xzf "$work/stack.tgz" -C "$work/stack" --strip-components=1 \
    || die "Could not unpack the Stack download. Run sudo maipai-engine update again."
  fetch_stack_commons "$work" no \
    || die "Could not fetch the Commons packages the Stack needs. Read the message above, fix what it names, then run sudo maipai-engine update again."
  bun_bin="$STACK_ROOT/.bun/bin/bun"
  [ -x "$bun_bin" ] || die "The Bun runtime is missing at $bun_bin. Run the Home installer again to put it back, then run sudo maipai-engine update."
  PATH="$(dirname "$bun_bin"):$PATH" OUT_DIR="$work/output" SKIP_VERIFY=1 \
    bash "$work/stack/scripts/build-binary.sh" \
    || die "The Stack build failed. Read the message above; fix what it names, then run sudo maipai-engine update again."
  os=$(uname -s | tr '[:upper:]' '[:lower:]')
  arch=$(uname -m)
  case "$arch" in x86_64) arch=x64 ;; aarch64) arch=arm64 ;; esac
  binary_name="maipai-stack-${os}-${arch}"
  publish_stack_binary "$work/output" "$STACK_ROOT" "$binary_name" \
    || die "The build did not produce $binary_name, migrations and backend-src, so nothing was installed. Run sudo maipai-engine update again; if it repeats, report this."
  chown -R "$STACK_USER:$STACK_USER" "$STACK_ROOT"
  loginctl enable-linger "$STACK_USER"
  local uid
  uid=$(id -u "$STACK_USER")
  sudo -u "$STACK_USER" env "XDG_RUNTIME_DIR=/run/user/${uid}" \
    systemctl --user restart maipai-stack
}

status() {
  if dry; then
    say "[dry-run] Would show Stack and pairing status."
    return 0
  fi
  need_root
  systemctl --user -M "$STACK_USER@" status maipai-stack.service --no-pager || true
  if current=$(read_pair); then say "Paired household: $current"; else say "Not paired."; fi
}

main() {
  local args=() arg
  for arg in "$@"; do
    if [ "$arg" = --dry-run ]; then DRY_RUN=yes; else args+=("$arg"); fi
  done
  [ "${#args[@]}" -gt 0 ] || { usage; exit 2; }
  case "${args[0]}" in
    pair)
      [ "${#args[@]}" -ge 3 ] || { usage; exit 2; }
      local replace=no
      [ "${args[3]:-}" = --replace ] && replace=yes
      pair "${args[1]}" "${args[2]}" "$replace"
      ;;
    unpair) unpair ;;
    update) update ;;
    status) status ;;
    doctor) doctor ;;
    *) usage; exit 2 ;;
  esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then main "$@"; fi
