#!/bin/bash
# MaiPai host guard. A root LaunchDaemon (com.maipai.host-guard) runs `maipai-host-guard run` every 60 seconds.
#
# Why: on 2026-10-26, 10-30 and 11-03 the Studio lost its user lookup service (getpwuid "does not exist") and its Metal shader
# compiler (MTLCompilerService). sudo, shutdown, launchctl reboot and every new engine start then failed, and the only way out was
# a hard power cycle. Root can still reboot, so this daemon probes, captures evidence once, and reboots the Mac by itself.
# Record: docs/design/host-guard-2026-11-03.md (HOST-GUARD-01).
#
#   maipai-host-guard run                 one probe pass (the daemon calls this)
#   maipai-host-guard status              print status.json
#   maipai-host-guard mode off|dry|live   dry logs "would reboot" only; live reboots; off does nothing (writes tuning.json)
#   maipai-host-guard capture             take the evidence bundle now (no reboot)
#   maipai-host-guard memory-status       print memory.json (the memory probe and the repairs, below)
#   maipai-host-guard uninstall           remove the daemon, the sudoers entry and this script (captures stay)
#
# Files in $STATE (default /var/db/maipai-host-guard):
#   config.json   root-owned, written by the installer: {"owner":"<account>","uid":<n>,"data_dir":"<path>"}. Never changed by Home.
#   tuning.json   written by Home (the Settings keys host.guard.*): {"mode","hard_minutes","metal_minutes","max_reboots_per_12h"}.
#                 Every value is clamped to the ranges below and anything else is ignored. A root process never takes an account,
#                 a path or a command from a file the user can write.
#   status.json   world-readable, written after every pass. Schema version 1:
#                 {"version":1,"owner","checked_at","mode","lookup","spawn","metal","hard_fails","metal_fails","uptime_s","note"}
#   last-reboot.txt, reboots, captures/<stamp>/ (root-only, never read by Home), telemetry.csv (world-readable trend numbers).
#   Memory and self-repair (HOST-GUARD-07..09, 2026-11-12; the section "Memory probe and bounded self-repair" below):
#   repair.json   root-owned, optional: {"mode":"off|dry|live","fsevents_compressed_gb","emergency_gb","pressure_minutes","shed_minutes"}, clamped.
#   memory.json   world-readable, every pass: pressure, swap, compressor, the biggest processes by footprint (compressed included), repairs.
#   memory.csv    world-readable time series (one row a pass). repair-audit.log: world-readable decisions, counts and reasons only.
#   dev-shed      world-readable flag: heavy development work (tests, gates, ships) waits while it is fresh (updated within 10 minutes).
#   fsevents-restarted  world-readable: when the guard restarted the file-event daemon; dev hubs read it and say to restart.
#   fsevents-digest.json  world-readable counts from the last evidence capture; fsevents-captures/<stamp>/ raw evidence, root-only, last 3.
#   Kill switch: the file <data_dir>/host-guard/OFF (or repair-OFF here) turns every repair off; the guard only checks that it exists.
#
# Safety: nothing for 15 minutes after boot; never reboots while a ship or install runs (up to 45 minutes); a Metal-only failure also
# waits for a quiet moment (up to 30 more minutes); at most max_reboots_per_12h reboots; every reboot writes last-reboot.txt.
set -u
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
# The test seams (MAIPAI_HG_*) are honored only when MAIPAI_HG_TEST=1, so a stray variable can never steer the root daemon.
if [[ "${MAIPAI_HG_TEST:-}" != 1 ]]; then
  unset MAIPAI_HG_STATE MAIPAI_HG_LOG MAIPAI_HG_SHUTDOWN MAIPAI_HG_REBOOT MAIPAI_HG_MIN_UPTIME MAIPAI_HG_DEFER_MAX MAIPAI_HG_QUIET_MAX \
    MAIPAI_HG_REBOOT_WINDOW MAIPAI_HG_STACK_URL MAIPAI_HG_USER MAIPAI_HG_UID MAIPAI_HG_DATA MAIPAI_HG_NO_ASUSER MAIPAI_HG_FORCE MAIPAI_HG_QUIET \
    MAIPAI_HG_CAPTURE_LIGHT MAIPAI_HG_NO_TELEMETRY MAIPAI_HG_HARD_LIMIT MAIPAI_HG_METAL_LIMIT MAIPAI_HG_MAX_REBOOTS MAIPAI_HG_FORCE_DELAY \
    MAIPAI_HG_NOW MAIPAI_HG_BIN MAIPAI_HG_REMEDIES MAIPAI_HG_VERIFY_DELAY MAIPAI_HG_FS_USAGE_SECONDS
fi
SELF="${BASH_SOURCE[0]}"

STATE="${MAIPAI_HG_STATE:-/var/db/maipai-host-guard}"
LOG="${MAIPAI_HG_LOG:-/var/log/maipai-host-guard.log}"
SELF_PATH="/usr/local/libexec/maipai-host-guard"
PLIST="/Library/LaunchDaemons/com.maipai.host-guard.plist"
SUDOERS="/etc/sudoers.d/maipai-host-guard"
SHUTDOWN_CMD="${MAIPAI_HG_SHUTDOWN:-/sbin/shutdown}"
REBOOT_CMD="${MAIPAI_HG_REBOOT:-/sbin/reboot}"
MIN_UPTIME="${MAIPAI_HG_MIN_UPTIME:-900}"
DEFER_MAX="${MAIPAI_HG_DEFER_MAX:-2700}"
QUIET_MAX="${MAIPAI_HG_QUIET_MAX:-1800}"
REBOOT_WINDOW="${MAIPAI_HG_REBOOT_WINDOW:-43200}"
STACK_URL="${MAIPAI_HG_STACK_URL:-http://127.0.0.1:8770}"
FORCE_DELAY="${MAIPAI_HG_FORCE_DELAY:-150}"

now() { if [[ "${MAIPAI_HG_NOW:-}" =~ ^[0-9]+$ ]]; then echo "$MAIPAI_HG_NOW"; else date +%s; fi; }
stamp() { date '+%Y-%m-%d %H:%M:%S'; }
log() { printf '%s %s\n' "$(stamp)" "$*" >> "$LOG" 2>/dev/null; }
read_int() { local v; v="$(cat "$1" 2>/dev/null)"; [[ "$v" =~ ^[0-9]+$ ]] && echo "$v" || echo 0; }
# with_timeout SECONDS CMD...: SIGALRM ends the command; exit status 142 means it timed out.
# The command runs in its own process group and the whole group is killed on timeout, so a hung child cannot keep a pipe open.
with_timeout() {
  local s="$1"; shift
  /usr/bin/perl -e 'my $t = shift; my $pid = fork(); if (!$pid) { setpgrp(0, 0); exec @ARGV or exit 127 } $SIG{ALRM} = sub { kill "KILL", -$pid; waitpid($pid, 0); exit 142 }; alarm $t; waitpid($pid, 0); exit($? >> 8);' "$s" "$@"
}
jget() { /usr/bin/plutil -extract "$2" raw -o - "$1" 2>/dev/null; }
clamp() { # value min max default
  local v="$1"; [[ "$v" =~ ^[0-9]{1,6}$ ]] || { echo "$4"; return; }
  v=$((10#$v))
  (( v < $2 )) && { echo "$2"; return; }; (( v > $3 )) && { echo "$3"; return; }; echo "$v"
}

# --- trusted config (root-owned) and clamped tuning (Home-written) ---
OWNER=""; OWNER_UID=""; DATA="/usr/local/maipai-home/data"
load_config() {
  local c="$STATE/config.json" v
  OWNER="${MAIPAI_HG_USER:-$(jget "$c" owner)}"; OWNER_UID="${MAIPAI_HG_UID:-$(jget "$c" uid)}"
  v="${MAIPAI_HG_DATA:-$(jget "$c" data_dir)}"; [[ -n "$v" ]] && DATA="$v"
  [[ "$OWNER" =~ ^[A-Za-z0-9._-]+$ && "$OWNER_UID" =~ ^[0-9]+$ ]] || return 1
  if [[ -n "${MAIPAI_HG_NO_ASUSER:-}" ]]; then LAUNCH=(); else
    # `launchctl asuser` joins the owner's session but stays uid 0, so `sudo -u` drops to the owner (which also exercises the user lookup).
    LAUNCH=(/bin/launchctl asuser "$OWNER_UID" /usr/bin/sudo -n -u "$OWNER" --)
  fi
}
load_tuning() {
  local t="$STATE/tuning.json" m
  m="$(jget "$t" mode)"; case "$m" in off|dry|live) MODE="$m" ;; *) MODE="$(cat "$STATE/mode" 2>/dev/null)"; case "$MODE" in off|dry|live) ;; *) MODE=dry ;; esac ;; esac
  HARD_LIMIT="$(clamp "${MAIPAI_HG_HARD_LIMIT:-$(jget "$t" hard_minutes)}" 2 30 3)"
  METAL_LIMIT="$(clamp "${MAIPAI_HG_METAL_LIMIT:-$(jget "$t" metal_minutes)}" 5 120 10)"
  MAX_REBOOTS="$(clamp "${MAIPAI_HG_MAX_REBOOTS:-$(jget "$t" max_reboots_per_12h)}" 0 3 2)"
}

JXA='ObjC.import("Metal");
var d = $.MTLCreateSystemDefaultDevice();
if (!d || d.isNil()) { console.log("NODEVICE"); } else {
  var e = Ref();
  var lib = d.newLibraryWithSourceOptionsError("// '"$$"'-'"$(now)"'\nkernel void k(device float *a [[buffer(0)]], uint i [[thread_position_in_grid]]) { a[i] = a[i] + 1.0; }", $(), e);
  console.log((!lib || lib.isNil()) ? "FAIL " + ObjC.unwrap(e[0].localizedDescription) : "OK");
}'

ms() { /usr/bin/perl -MTime::HiRes=time -e 'print int(time*1000)'; }

probe_lookup() {
  [[ "${MAIPAI_HG_FORCE:-}" == *lookup* ]] && { NOTE_L="forced"; return 1; }
  local a b
  a="$(with_timeout 25 /usr/bin/dscl . -read "/Users/$OWNER" UniqueID 2>&1 | tail -n 1)"
  b="$(with_timeout 25 /usr/bin/id -u "$OWNER" 2>/dev/null | tail -n 1)"
  NOTE_L="dscl='${a//$'\n'/ }' id='${b//$'\n'/ }'"
  [[ "$a" == "UniqueID: $OWNER_UID" && "$b" == "$OWNER_UID" ]]
}
# Run a command in the owner's session: stdout to a file (the last line is the answer), stderr apart, and the exit status in RC.
as_owner() { # seconds cmd...
  local s="$1" out="$STATE/.probe.out"; shift
  with_timeout "$s" ${LAUNCH[@]+"${LAUNCH[@]}"} "$@" >"$out" 2>"$STATE/.probe.err"; RC=$?
  ANSWER="$(tail -n 1 "$out" 2>/dev/null)"; ERRTEXT="$(head -c 300 "$STATE/.probe.err" 2>/dev/null | tr '\n' ' ')"
  # osascript prints console.log to stderr, so the Metal verdict is the one line that is exactly OK, NODEVICE or FAIL ..., from either stream.
  VERDICT="$(cat "$out" "$STATE/.probe.err" 2>/dev/null | grep -E '^(OK|NODEVICE|FAIL )' | tail -n 1)"
}
sudo_is_broken() { [[ "$ERRTEXT" == *sudoers* || "$ERRTEXT" == *"syntax error"* || "$ERRTEXT" == *"parse error"* ]]; }
probe_spawn() {
  [[ "${MAIPAI_HG_FORCE:-}" == *spawn* ]] && { NOTE_S="forced"; return 1; }
  as_owner 30 /usr/bin/id -un
  NOTE_S="rc=$RC ${ANSWER} ${ERRTEXT}"
  if (( RC != 0 )) && sudo_is_broken; then NOTE_S="sudo is broken (a sudoers file has an error); not counted: $ERRTEXT"; return 2; fi
  [[ "$ANSWER" == "$OWNER" ]]
}
# One Metal compile through the same compiler service the engines use (the Stack's hostProbe.ts compiles the same shader; scripts/hostGuard.test.ts keeps the two texts equal).
probe_metal() {
  [[ "${MAIPAI_HG_FORCE:-}" == *metal* ]] && { NOTE_M="forced"; return 1; }
  as_owner 45 /usr/bin/osascript -l JavaScript -e "$JXA"
  NOTE_M="rc=$RC ${VERDICT:-no answer} ${ERRTEXT}"
  [[ $RC -eq 0 && ( "$VERDICT" == "OK" || "$VERDICT" == "NODEVICE" ) ]]
}
has_session() { [[ -n "${MAIPAI_HG_NO_ASUSER:-}" ]] || with_timeout 15 /bin/launchctl print "gui/$OWNER_UID" >/dev/null 2>&1; }

boot_age() {
  local b; b="$(/usr/sbin/sysctl -n kern.boottime 2>/dev/null | sed -n 's/^{ sec = \([0-9]*\),.*/\1/p')"
  [[ "$b" =~ ^[0-9]+$ ]] && echo $(( $(now) - b )) || echo 999999
}
ship_running() {
  local pid; pid="$(cat "$DATA/ship.lock.d/pid" 2>/dev/null)"
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then return 0; fi
  "$(tp /usr/bin/pgrep)" -f '/usr/local/libexec/maipai-(install|promote)' >/dev/null 2>&1
}
# A Metal-only failure keeps the running engines answering, so it waits for no chat turn or job in flight.
stack_quiet() {
  [[ -n "${MAIPAI_HG_QUIET:-}" ]] && { [[ "$MAIPAI_HG_QUIET" == yes ]]; return; }
  local o; o="$(with_timeout 5 /usr/bin/curl -s -m 4 "$STACK_URL/stack/v1/memory" 2>/dev/null)"
  [[ -z "$o" ]] && return 0   # the Stack does not answer: nothing is in flight
  [[ "$o" == *'"queue_depth":{"reserved":0,"warm":0,"burst":0}'* ]]
}

write_status() { # lookup spawn metal hard metal_fails note
  local tmp="$STATE/status.json.tmp" note="$6"
  note="$(printf '%s' "$note" | tr -d '\\\001-\037' | cut -c1-400)"
  printf '{"version":1,"owner":"%s","checked_at":%s,"mode":"%s","lookup":"%s","spawn":"%s","metal":"%s","hard_fails":%s,"metal_fails":%s,"uptime_s":%s,"note":"%s"}\n' \
    "${OWNER:-}" "$(now)" "$MODE" "$1" "$2" "$3" "$4" "$5" "$(boot_age)" "$note" > "$tmp" && mv "$tmp" "$STATE/status.json" && chmod 644 "$STATE/status.json"
}

# One CSV row per pass: the numbers that tell the candidate causes apart (kernel zones, vnodes, ports, daemon sizes, engine sizes, probe times).
telemetry() { # lookup_ms metal_ms
  local f="$STATE/telemetry.csv" z vm wired comp avail p
  [[ -s "$f" ]] || echo "ts,uptime_s,load1,wired_gb,compressor_gb,swap_gb,avail_pct,vnodes,sandbox_sandboxes,sandbox_profiles,ipc_ports,ipc_kmsgs,proc_task,threads,fileproc,procs,launchd_rss_mb,od_rss_mb,logd_rss_mb,splash_gb,llama_gb,lookup_ms,metal_ms" > "$f"
  z="$(/usr/bin/zprint 2>/dev/null)"; vm="$(/usr/bin/vm_stat)"
  zi() { echo "$z" | awk -v n="$1" '$1==n{print $(NF-2)}' | head -1; }
  wired="$(echo "$vm" | awk '/wired down/{gsub("\\.","",$4);printf "%.1f",$4*16384/2^30}')"
  comp="$(echo "$vm" | awk '/occupied by compressor/{gsub("\\.","",$5);printf "%.1f",$5*16384/2^30}')"
  rss() { /bin/ps -o rss= -p "$1" 2>/dev/null | awk '{printf "%.0f",$1/1024}'; }
  fp() { local t=0 g; for p in $(/usr/bin/pgrep -x "$1"); do g="$(/usr/bin/footprint "$p" 2>/dev/null | sed -n 2p | sed -E 's/.*Footprint: ([0-9.]+) ([GM]B).*/\1 \2/' | awk '{print ($2=="MB")?$1/1024:$1}')"; t="$(echo "$t ${g:-0}" | awk '{print $1+$2}')"; done; echo "$t"; }
  echo "$(now),$(boot_age),$(/usr/sbin/sysctl -n vm.loadavg | awk '{print $2}'),$wired,$comp,$(/usr/sbin/sysctl -n vm.swapusage | awk '{gsub("M","",$6);printf "%.1f",$6/1024}'),$(/usr/sbin/sysctl -n kern.memorystatus_level),$(/usr/sbin/sysctl -n kern.num_vnodes),$(zi sandbox.sandboxes),$(zi sandbox.profiles),$(zi ipc.ports),$(zi ipc.kmsgs),$(zi proc_task),$(zi threads),$(zi fileproc),$(/bin/ps -ax | wc -l | tr -d ' '),$(rss 1),$(rss "$(/usr/bin/pgrep -x opendirectoryd | head -1)"),$(rss "$(/usr/bin/pgrep -x logd | head -1)"),$(fp splash),$(fp llama-server),$1,$2" >> "$f"
  chmod 644 "$f"
  [[ $(stat -f %z "$f" 2>/dev/null || echo 0) -gt 5000000 ]] && { tail -n 20000 "$f" > "$f.tmp"; head -1 "$f" | cat - "$f.tmp" > "$f.new"; mv "$f.new" "$f"; rm -f "$f.tmp"; }
}

capture() {
  local dir="$STATE/captures/$(date +%Y%m%d-%H%M%S)" sd="" p
  mkdir -p "$dir" && chmod 700 "$dir"
  log "capture: start $dir"
  # Root-only evidence for the lookup failure: nothing here is read or shown by Home. ps lists names only (no arguments).
  if [[ -z "${MAIPAI_HG_CAPTURE_LIGHT:-}" ]]; then ( with_timeout 240 /usr/bin/sysdiagnose -f "$dir" -b -u -n -Q >"$dir/sysdiagnose.out" 2>&1 ) & sd=$!; fi
  { echo "uptime: $(/usr/bin/uptime)"; /usr/sbin/sysctl vm.swapusage iogpu.wired_limit_mb kern.memorystatus_level kern.boottime kern.num_vnodes kern.maxvnodes 2>&1; } >"$dir/system.txt"
  with_timeout 20 /usr/bin/vm_stat >"$dir/vm_stat.txt" 2>&1
  with_timeout 30 /usr/bin/memory_pressure >"$dir/memory_pressure.txt" 2>&1
  with_timeout 20 /bin/ps -axo pid,ppid,etime,pcpu,pmem,rss,state,comm >"$dir/ps.txt" 2>&1
  with_timeout 30 /usr/bin/top -l 1 -n 30 -o mem >"$dir/top.txt" 2>&1
  with_timeout 30 /usr/bin/zprint >"$dir/zprint.txt" 2>&1
  { echo "--- dscl"; with_timeout 15 /usr/bin/dscl . -read "/Users/$OWNER" UniqueID; echo "--- id"; with_timeout 15 /usr/bin/id "$OWNER"; echo "--- spawn"; with_timeout 20 ${LAUNCH[@]+"${LAUNCH[@]}"} /usr/bin/id -un; echo "--- metal"; with_timeout 30 ${LAUNCH[@]+"${LAUNCH[@]}"} /usr/bin/osascript -l JavaScript -e "$JXA"; } >"$dir/probes.txt" 2>&1
  with_timeout 30 /bin/launchctl print system 2>&1 | head -150 >"$dir/launchctl-system.txt"
  with_timeout 30 /bin/launchctl print "gui/$OWNER_UID" 2>&1 | head -150 >"$dir/launchctl-gui.txt"
  for p in $(/usr/bin/pgrep -x splash; /usr/bin/pgrep -x llama-server); do with_timeout 30 /usr/bin/footprint "$p" >>"$dir/footprint.txt" 2>&1; done
  [[ -z "${MAIPAI_HG_CAPTURE_LIGHT:-}" ]] && with_timeout 60 /usr/sbin/spindump opendirectoryd 3 -file "$dir/spindump-opendirectoryd.txt" >/dev/null 2>&1
  with_timeout 90 /usr/bin/log show --last 15m --style compact --predicate 'process == "launchd" OR process == "opendirectoryd" OR process == "MTLCompilerService" OR process == "kernel"' 2>&1 | grep -E ' (E|F) ' | head -3000 >"$dir/system-errors.txt"
  [[ -n "$sd" ]] && wait "$sd" 2>/dev/null
  echo "$(basename "$dir")" > "$STATE/last-capture"; chmod 644 "$STATE/last-capture"
  find "$STATE/captures" -mindepth 1 -maxdepth 1 -type d -mtime +14 -exec rm -rf {} + 2>/dev/null
  log "capture: done $dir"
}

do_reboot() { # reason
  echo "$(now) $1" >> "$STATE/reboots"
  { echo "$(stamp) $1"; echo "capture: $(cat "$STATE/last-capture" 2>/dev/null)"; } > "$STATE/last-reboot.txt"; chmod 644 "$STATE/last-reboot.txt" "$STATE/reboots"
  log "REBOOT: $1"
  "$SHUTDOWN_CMD" -r now "MaiPai host guard: $1" >>"$LOG" 2>&1
  # Foreground on purpose: launchd kills this job's process group when the script exits, so a background fallback would never run.
  sleep "$FORCE_DELAY"; log "graceful shutdown did not finish; forcing"; "$REBOOT_CMD" -q >>"$LOG" 2>&1
}
recent_reboots() {
  local cutoff=$(( $(now) - REBOOT_WINDOW )) n=0 t
  while read -r t _; do [[ "$t" =~ ^[0-9]+$ && $t -ge $cutoff ]] && n=$((n+1)); done < "$STATE/reboots" 2>/dev/null
  echo "$n"
}

cmd_run() {
  mkdir -p "$STATE/captures"; chmod 755 "$STATE"; touch "$STATE/reboots"; chmod 644 "$STATE/reboots"
  [[ -f "$LOG" ]] && [[ $(stat -f %z "$LOG" 2>/dev/null || echo 0) -gt 1048576 ]] && tail -n 2000 "$LOG" > "$LOG.tmp" && mv "$LOG.tmp" "$LOG"
  load_tuning
  if ! load_config; then MODE=off; write_status - - - 0 0 "config.json missing or invalid"; log "config.json missing or invalid"; return 0; fi
  if [[ "$MODE" == off ]]; then rm -f "$STATE/hard" "$STATE/metal" "$STATE/episode"; write_status - - - 0 0 "mode off"; return 0; fi
  local up; up="$(boot_age)"
  if (( up < MIN_UPTIME )); then rm -f "$STATE/hard" "$STATE/metal" "$STATE/episode"; write_status - - - 0 0 "settling after boot ($up s)"; return 0; fi

  local l=ok s=ok m=ok t0 t1 t2 t3 rc
  NOTE_L= NOTE_S= NOTE_M=
  t0="$(ms)"; probe_lookup || l=FAIL; t1="$(ms)"
  if has_session; then
    probe_spawn; rc=$?; if (( rc == 1 )); then s=FAIL; elif (( rc == 2 )); then s=skipped; fi
    t2="$(ms)"; if [[ $s == ok ]]; then probe_metal || m=FAIL; else m=skipped; fi; t3="$(ms)"
  else
    s=skipped; m=skipped; NOTE_S="the owner has no login session; not counted"; t2="$t1"; t3="$t1"
  fi

  local hard metal_fails
  hard="$(read_int "$STATE/hard")"; metal_fails="$(read_int "$STATE/metal")"
  if [[ $l == FAIL || $s == FAIL ]]; then hard=$((hard+1)); else hard=0; fi
  if [[ $m == FAIL ]]; then metal_fails=$((metal_fails+1)); elif [[ $m == ok ]]; then metal_fails=0; fi
  echo "$hard" > "$STATE/hard"; echo "$metal_fails" > "$STATE/metal"

  local note="" reason="" metal_only=0
  [[ $l == FAIL ]] && note="lookup: $NOTE_L;"
  [[ $s == FAIL ]] && note="$note spawn: $NOTE_S;"
  [[ $m == FAIL ]] && note="$note metal: $NOTE_M;"
  note="${note//\"/\'}"
  if (( hard > 0 || metal_fails > 0 )); then log "probe lookup=$l spawn=$s metal=$m hard=$hard metal_fails=$metal_fails $note"; fi

  if (( hard >= HARD_LIMIT )); then reason="user lookup or service start failed for $hard minutes"
  elif (( metal_fails >= METAL_LIMIT )); then reason="Metal shader compiler failed for $metal_fails minutes"; metal_only=1; fi
  if [[ -z "$reason" ]]; then
    rm -f "$STATE/episode"; write_status "$l" "$s" "$m" "$hard" "$metal_fails" "${note:-healthy}"
    # Trend numbers only on a healthy pass, in their own bounded process, so they can never hold up a decision.
    if (( hard == 0 && metal_fails == 0 )) && [[ -z "${MAIPAI_HG_NO_TELEMETRY:-}" ]]; then with_timeout 45 /bin/bash "$SELF" telemetry "$((t1-t0))" "$((t3-t2))" >/dev/null 2>&1; fi
    # The memory probe and its bounded repairs, after the reboot decision, in their own bounded process (an evidence capture can take
    # minutes; launchd starts the next pass when this one ends). Tests run it only against fake tools (MAIPAI_HG_BIN).
    if [[ "${MAIPAI_HG_TEST:-}" != 1 || -n "${MAIPAI_HG_BIN:-}" ]]; then with_timeout 900 /bin/bash "$SELF" memory >/dev/null 2>&1; fi
    return 0
  fi

  local ep; ep="$(read_int "$STATE/episode")"
  if (( ep == 0 )); then ep="$(now)"; echo "$ep" > "$STATE/episode"; capture; fi
  write_status "$l" "$s" "$m" "$hard" "$metal_fails" "TRIGGERED: $reason"

  if ship_running && (( $(now) - ep < DEFER_MAX )); then log "deferred: a ship or install is running ($reason)"; return 0; fi
  if (( metal_only )) && ! stack_quiet && (( $(now) - ep < QUIET_MAX )); then log "deferred: a chat turn or job is in flight ($reason)"; return 0; fi
  if (( $(recent_reboots) >= MAX_REBOOTS )); then log "NOT rebooting: $MAX_REBOOTS reboots in the last 12 hours already ($reason)"; return 0; fi
  if [[ "$MODE" != live ]]; then log "dry mode: WOULD REBOOT: $reason"; return 0; fi
  rm -f "$STATE/episode" "$STATE/hard" "$STATE/metal"
  do_reboot "$reason"
}

# ---------------------------------------------------------------------------------------------------------------------------------
# Memory probe and bounded self-repair (HOST-GUARD-07, -08, -09; 2026-11-12).
# Why: on 2026-11-12 fseventsd (the macOS file-event daemon) held 66 GB, 63 GB of it compressed or swapped, with a 3.4 GB resident size:
# about 955,000 Malloc Small buffers of about 121 KB that grew about 45 GB in two hours during a hung safety-test run and a ship.
# WHICH CODE PATH ALLOCATES THEM IS UNPROVEN (a per-lookup leak was tested and refuted). This guard is the instrument that will prove
# it: it captures root-only evidence while the daemon is still small (4 GB), then restarts it before it hurts (8 GB). Pressure sat at
# level 2 for hours; every guard that reads resident size missed it. Only a restart frees the memory, and that needs root, so this
# guard does it, within fixed bounds:
#   * Only actions in the allowlist (remedy_run) can run. Each is a function in this file with fixed arguments; nothing is read from a
#     file or the environment except clamped numbers (repair.json) and the existence of the kill switch file.
#   * Each has a trigger, a minimum time the trigger must hold, a cooldown and a daily cap; repair mode dry only logs; the kill switch
#     turns every action off. Every decision goes to repair-audit.log (counts and reasons, never file contents).
#   * Evidence first: the file-event daemon is never restarted without a complete evidence capture from the last 30 minutes, unless it is
#     above the emergency size (40 GB); then a quick capture (60 s, no heap or leaks walk) runs and the restart goes ahead.
# Thresholds (physical footprint, compressed and swapped included, same process; growth is measured over the last 10 minutes):
#   capture-fseventsd  footprint >= capture_gb (4 GB), or growth >= 1 GB in 10 min; once per 6 h, 3 a day. heap and leaks run only
#                      while the daemon is under 8 GB (on a huge daemon they would pull everything back from swap).
#   restart-fseventsd  footprint >= fsevents_compressed_gb (8 GB), or growth >= 2 GB in 10 min; once per 12 h, 2 a day; never during a
#                      ship or install; writes fsevents-restarted, which makes each dev hub restart itself in full.
#   source-throttle    growth >= 1 GB in 10 min: writes the source-throttle flag; the test sharder halves its worker cap while it is
#                      fresh; cleared after 10 minutes below that growth.
#   dev-shed           kernel pressure level 2 or more for shed_minutes (20); cleared after 5 calm minutes.
# Diagnostic only (never a trigger): "Resolve user group list" lines a minute, which approximate new FSEvents streams plus history
# replays by clients (not delivered events), in memory.json and memory.csv.
# ---------------------------------------------------------------------------------------------------------------------------------
REPAIR_DIR="$STATE/repair"
CAPS="$STATE/fsevents-captures"
NOTICE_TEXT="Chat is slower for a few minutes while the system tidies up."
GROUP_LIST_MSG="Resolve user group list"
GROWTH_WINDOW_S=600
THROTTLE_GROWTH_MB=1024
RESTART_GROWTH_MB=2048
WALK_MAX_MB=8192
SMALL_AFTER_MB=2048
DEV_DATA=""

# A system tool by absolute path; the test seam swaps the whole directory for fakes (only when MAIPAI_HG_TEST=1, see the top).
tp() { if [[ -n "${MAIPAI_HG_BIN:-}" ]]; then echo "$MAIPAI_HG_BIN/${1##*/}"; else echo "$1"; fi; }
clean() { printf '%s' "$1" | tr -d '\\"\000-\037' | cut -c1-"${2:-300}"; }

load_repair() {
  local r="$STATE/repair.json" m
  # A repair.json that root does not own is ignored (the defaults apply), so no user can loosen a bound.
  if [[ -f "$r" && "${MAIPAI_HG_TEST:-}" != 1 && "$(stat -f %u "$r" 2>/dev/null)" != 0 ]]; then r=/nonexistent; fi
  m="$(jget "$r" mode)"; case "$m" in off|dry|live) R_MODE="$m" ;; *) R_MODE=live ;; esac
  R_FSEV_MB=$(( $(clamp "$(jget "$r" fsevents_compressed_gb)" 4 256 8) * 1024 ))
  R_CAPT_MB=$(( $(clamp "$(jget "$r" capture_gb)" 1 64 4) * 1024 ))
  R_EMERG_MB=$(( $(clamp "$(jget "$r" emergency_gb)" 24 256 40) * 1024 ))
  R_SHED_S=$(( $(clamp "$(jget "$r" shed_minutes)" 10 240 20) * 60 ))
  R_OFF=0; if [[ -e "$DATA/host-guard/OFF" || -e "$STATE/repair-OFF" ]]; then R_OFF=1; fi
  local d; d="$(jget "$STATE/config.json" dev_data)"
  if [[ "$d" =~ ^/[A-Za-z0-9._/\ -]+$ && "$d" != *..* ]]; then DEV_DATA="$d"; fi
}

# top -stats pid,command,mem,cmprs: MEM is the footprint (compressed included), so a daemon with a tiny resident size is seen.
# Output: pid<TAB>name<TAB>footprint MB<TAB>compressed MB, names reduced to safe characters.
parse_top() {
  awk 'function mb(s,  u, n) { sub(/[+-]$/, "", s); u = substr(s, length(s)); n = substr(s, 1, length(s) - 1) + 0
         if (u == "T") return int(n * 1048576); if (u == "G") return int(n * 1024); if (u == "M") return int(n)
         if (u == "K") return int(n / 1024); if (u == "B") return 0; return int((s + 0) / 1048576) }
       /^PID[ \t]+COMMAND/ { on = 1; next }
       on && $1 ~ /^[0-9]+$/ && NF >= 4 { name = $2; for (i = 3; i <= NF - 2; i++) name = name " " $i
         gsub(/[^A-Za-z0-9 ._()-]/, "", name); printf "%s\t%s\t%d\t%d\n", $1, substr(name, 1, 40), mb($(NF - 1)), mb($NF) }'
}
swap_field() { printf '%s\n' "$1" | awk -v k="$2" '{ for (i = 1; i < NF - 1; i++) if ($i == k && $(i + 1) == "=") { v = $(i + 2); sub(/M$/, "", v); if (v ~ /^[0-9.]+$/) { printf "%d", v; f = 1 } } } END { if (!f) printf "-1" }'; }
compressor_mb() { awk '/page size of/ { for (i = 1; i <= NF; i++) if ($i == "of") ps = $(i + 1) } /occupied by compressor/ { c = $NF; gsub(/\./, "", c) } END { if (ps > 0 && c ~ /^[0-9]+$/) printf "%d", c * ps / 1048576; else printf "-1" }'; }

mem_probe() {
  local v sw pid name mb cmp
  v="$(with_timeout 10 "$(tp /usr/sbin/sysctl)" -n kern.memorystatus_vm_pressure_level 2>/dev/null)"; [[ "$v" =~ ^[0-9]$ ]] && M_LEVEL="$v" || M_LEVEL=-1
  v="$(with_timeout 10 "$(tp /usr/sbin/sysctl)" -n kern.memorystatus_level 2>/dev/null)"; [[ "$v" =~ ^[0-9]{1,3}$ ]] && M_FREE="$v" || M_FREE=-1
  sw="$(with_timeout 10 "$(tp /usr/sbin/sysctl)" -n vm.swapusage 2>/dev/null)"
  M_SWAP_TOTAL="$(swap_field "$sw" total)"; M_SWAP_USED="$(swap_field "$sw" used)"
  M_COMP="$(with_timeout 15 "$(tp /usr/bin/vm_stat)" 2>/dev/null | compressor_mb)"
  M_TOP="$(with_timeout 25 "$(tp /usr/bin/top)" -l 1 -o mem -n 8 -stats pid,command,mem,cmprs 2>/dev/null | parse_top)"
  M_FSEV_PID=""; M_FSEV_MB=0; M_FSEV_CMP=0
  while IFS=$'\t' read -r pid name mb cmp; do
    if [[ "$name" == fseventsd && "$mb" =~ ^[0-9]+$ && "$cmp" =~ ^[0-9]+$ ]]; then M_FSEV_PID="$pid"; M_FSEV_MB="$mb"; M_FSEV_CMP="$cmp"; break; fi
  done <<< "$M_TOP"
  # The leak's own signal: group-list calls by fseventsd in the last minute (one line each), and the MB that leaks with them.
  v="$(with_timeout 20 "$(tp /usr/bin/log)" show --last 1m --style compact --predicate "process == \"fseventsd\" AND eventMessage CONTAINS \"$GROUP_LIST_MSG\"" 2>/dev/null | grep -c "$GROUP_LIST_MSG")"
  [[ "$v" =~ ^[0-9]+$ ]] && M_CALLS="$v" || M_CALLS=-1
  # Footprint growth over the last 10 minutes for the same daemon process (a restart starts it over): against the newest sample
  # 10 to 15 minutes old; -1 when there is none yet.
  local h="$REPAIR_DIR/fseventsd-history" t mb p age
  M_GROWTH10=-1
  if [[ -n "$M_FSEV_PID" ]]; then
    while read -r t mb p; do
      [[ "$t" =~ ^[0-9]+$ && "$mb" =~ ^[0-9]+$ && "$p" == "$M_FSEV_PID" ]] || continue
      age=$(( $(now) - t ))
      if (( age >= GROWTH_WINDOW_S && age <= GROWTH_WINDOW_S + 300 )); then M_GROWTH10=$(( M_FSEV_MB - mb )); fi
    done < <(cat "$h" 2>/dev/null)
    echo "$(now) $M_FSEV_MB $M_FSEV_PID" >> "$h"; tail -n 30 "$h" > "$h.tmp" && mv "$h.tmp" "$h"
  fi
}

# held NAME TRUE|FALSE: seconds the signal has held (0 when it does not hold now).
held() {
  local f="$REPAIR_DIR/$1.since" s
  if [[ "$2" != true ]]; then rm -f "$f"; echo 0; return; fi
  s="$(read_int "$f")"; if (( s == 0 )); then s="$(now)"; echo "$s" > "$f"; fi
  echo $(( $(now) - s ))
}
signals() {
  local t=false
  (( M_LEVEL >= 2 )) && t=true; H_PRESS="$(held pressure "$t")"
  t=false; (( M_FSEV_MB >= R_FSEV_MB )) && t=true; H_SIZE="$(held fsevents-size "$t")"; S_SIZE="$t"
  t=false; (( M_GROWTH10 < THROTTLE_GROWTH_MB )) && t=true; H_SLOW="$(held fsevents-slow "$t")"
  t=false; (( M_LEVEL >= 0 && M_LEVEL < 2 )) && t=true; H_CALM="$(held calm "$t")"
}

audit() { # id decision detail
  local f="$STATE/repair-audit.log"
  printf '%s id=%s decision=%s %s\n' "$(date -u -r "$(now)" +%Y-%m-%dT%H:%M:%SZ)" "$1" "$2" "$(clean "$3" 400)" >> "$f"
  chmod 644 "$f"
  [[ $(stat -f %z "$f" 2>/dev/null || echo 0) -gt 1048576 ]] && { tail -n 3000 "$f" > "$f.tmp" && mv "$f.tmp" "$f"; chmod 644 "$f"; }
  log "repair: $1 $2 $(clean "$3" 400)"
}
runs_since() { local n=0 t; while read -r t _; do if [[ "$t" =~ ^[0-9]+$ ]] && (( t >= $2 )); then n=$((n+1)); fi; done 2>/dev/null < "$REPAIR_DIR/$1.runs"; echo "$n"; }
last_run() { local t; t="$(tail -n 1 "$REPAIR_DIR/$1.runs" 2>/dev/null | awk '{print $1}')"; [[ "$t" =~ ^[0-9]+$ ]] && echo "$t" || echo 0; }
record_run() { echo "$(now) $2" >> "$REPAIR_DIR/$1.runs"; tail -n 50 "$REPAIR_DIR/$1.runs" > "$REPAIR_DIR/$1.runs.tmp" && mv "$REPAIR_DIR/$1.runs.tmp" "$REPAIR_DIR/$1.runs"; }
mem_counts() { echo "pressure=$M_LEVEL fseventsd_mb=$M_FSEV_MB fseventsd_compressed_mb=$M_FSEV_CMP growth_10min_mb=$M_GROWTH10 group_list_per_min=$M_CALLS swap_used_mb=$M_SWAP_USED"; }

# The allowlist. To add an action: a name here, its limits and trigger in remedy_limits and remedy_due, and an act_ function.
REMEDIES="capture-fseventsd source-throttle restart-fseventsd dev-shed"
remedy_known() { case "$1" in capture-fseventsd|restart-fseventsd|source-throttle|dev-shed) return 0 ;; esac; return 1; }
remedy_limits() { # id -> L_COOL seconds between runs, L_CAP runs per 24 hours
  case "$1" in
    capture-fseventsd) L_COOL=21600; L_CAP=3 ;;
    restart-fseventsd) L_COOL=43200; L_CAP=2 ;;
    source-throttle) L_COOL=1800; L_CAP=12 ;;
    dev-shed) L_COOL=1800; L_CAP=6 ;;
  esac
}
remedy_due() { # id -> 0 when its trigger has held long enough; TRIGGER names it
  TRIGGER=""
  case "$1" in
    capture-fseventsd)
      if (( M_FSEV_MB >= R_CAPT_MB )); then TRIGGER="size ${M_FSEV_MB} MB >= $R_CAPT_MB MB"
      elif (( M_GROWTH10 >= THROTTLE_GROWTH_MB )); then TRIGGER="growth ${M_GROWTH10} MB in 10 min"; fi ;;
    restart-fseventsd)
      if [[ $S_SIZE == true ]]; then TRIGGER="size ${M_FSEV_MB} MB >= $R_FSEV_MB MB"
      elif (( M_GROWTH10 >= RESTART_GROWTH_MB )); then TRIGGER="growth ${M_GROWTH10} MB in 10 min"; fi ;;
    source-throttle)
      if [[ ! -f "$STATE/source-throttle" ]] && (( M_GROWTH10 >= THROTTLE_GROWTH_MB )); then TRIGGER="growth ${M_GROWTH10} MB in 10 min"; fi ;;
    dev-shed)
      if [[ ! -f "$STATE/dev-shed" ]] && (( H_PRESS >= R_SHED_S )); then TRIGGER="pressure level $M_LEVEL for ${H_PRESS}s"; fi ;;
  esac
  [[ -n "$TRIGGER" ]]
}
remedy_run() { # id: only these run; anything else is refused
  case "$1" in
    capture-fseventsd) act_capture full ;;
    restart-fseventsd) act_restart ;;
    source-throttle) act_source_throttle ;;
    dev-shed) act_dev_shed ;;
    *) audit "$1" refused "not on the allowlist"; return 64 ;;
  esac
}
remedy_consider() {
  local id="$1" why="" last
  if ! remedy_known "$id"; then audit "$id" refused "not on the allowlist"; return 64; fi
  remedy_limits "$id"
  if ! remedy_due "$id"; then rm -f "$REPAIR_DIR/$id.why"; [[ $id == restart-fseventsd ]] && rm -f "$REPAIR_DIR/restart-deferred"; return 0; fi
  last="$(last_run "$id")"
  if (( R_OFF )); then why="kill switch is set"
  elif [[ $R_MODE == off ]]; then why="repair mode is off"
  elif (( last > 0 && $(now) - last < L_COOL )); then why="cooldown ($(( L_COOL / 60 )) min)"
  elif (( $(runs_since "$id" $(( $(now) - 86400 ))) >= L_CAP )); then why="daily cap of $L_CAP reached"
  elif [[ $id == restart-fseventsd ]] && ship_running; then why="a ship or install is running"
  fi
  if [[ -n "$why" ]]; then
    if [[ "$(cat "$REPAIR_DIR/$id.why" 2>/dev/null)" != "$why" ]]; then echo "$why" > "$REPAIR_DIR/$id.why"; audit "$id" skipped "$why; trigger: $TRIGGER; $(mem_counts)"; fi
    # A restart that must wait (a ship or install, its cooldown or cap) while the daemon keeps growing pauses NEW heavy development
    # work (dev-shed) and raises an alert; the restart is retried every pass and runs as soon as the blocker clears.
    if [[ $id == restart-fseventsd ]] && (( ! R_OFF )) && [[ $R_MODE == live ]] && (( M_GROWTH10 > 0 )); then
      echo "$why" > "$REPAIR_DIR/restart-deferred"
      write_shed_flag "file-event service restart deferred ($why) while it grows"
    fi
    return 0
  fi
  rm -f "$REPAIR_DIR/$id.why"
  if [[ $R_MODE == dry ]]; then record_run "$id" dry; audit "$id" dry "would run; trigger: $TRIGGER; $(mem_counts)"; return 0; fi
  remedy_run "$id"
}

# Evidence capture in its own bounded process; 0 when it completed (the COMPLETE marker of a capture that started after us).
act_capture() { # full|quick
  local mode="$1" limit=660 start rc latest
  [[ $mode == quick ]] && limit=70
  start="$(now)"; record_run capture-fseventsd "started-$mode"
  with_timeout "$limit" /bin/bash "$SELF" capture-fsevents "${M_FSEV_PID:-0}" "$mode" >/dev/null 2>&1; rc=$?
  latest="$(read_int "$REPAIR_DIR/capture-ok")"
  if (( latest >= start )); then audit capture-fseventsd ran "complete ($mode); $(mem_counts)"; return 0; fi
  audit capture-fseventsd failed "incomplete ($mode, exit $rc); $(mem_counts)"; return 1
}

act_restart() {
  local before_mb="$M_FSEV_MB" before_cmp="$M_FSEV_CMP" pid0="$M_FSEV_PID" ok_at rc result pid1
  # Every restart attempt has a complete capture from the last 15 minutes behind it (the one this pass took counts), whatever tripped it.
  ok_at="$(read_int "$REPAIR_DIR/capture-ok")"
  if (( $(now) - ok_at > 900 )); then
    if (( M_FSEV_MB >= R_EMERG_MB )); then
      act_capture quick || audit restart-fseventsd note "above the emergency size; quick capture incomplete; restarting anyway"
    elif (( $(now) - $(last_run capture-fseventsd) < 7200 )); then
      audit restart-fseventsd refused "no complete evidence capture in the last 15 minutes and the last attempt failed; waiting; $(mem_counts)"; return 1
    elif ! act_capture full; then
      audit restart-fseventsd refused "the evidence capture did not complete; $(mem_counts)"; return 1
    fi
  fi
  record_run restart-fseventsd started
  with_timeout 30 "$(tp /bin/launchctl)" kickstart -k system/com.apple.fseventsd >>"$LOG" 2>&1; rc=$?
  sleep "${MAIPAI_HG_VERIFY_DELAY:-10}"
  mem_probe
  pid1="$M_FSEV_PID"; [[ -n "$pid1" ]] || pid1="$(with_timeout 5 "$(tp /usr/bin/pgrep)" -x fseventsd 2>/dev/null | head -n 1)"
  if (( rc != 0 )); then result="kickstart failed (exit $rc)"
  elif [[ ! "$pid1" =~ ^[0-9]+$ ]]; then result="fseventsd did not come back"
  elif (( M_FSEV_MB > SMALL_AFTER_MB )); then result="came back but is still large"
  else result=ok; fi
  printf '{"version":1,"restarted_at":%s,"before_mb":%s,"after_mb":%s,"result":"%s"}\n' "$(now)" "$before_mb" "$M_FSEV_MB" "$(clean "$result" 80)" > "$STATE/fsevents-restarted.tmp" \
    && mv "$STATE/fsevents-restarted.tmp" "$STATE/fsevents-restarted" && chmod 644 "$STATE/fsevents-restarted"
  # A fresh baseline: the next growth is measured from the new process.
  local rss; rss="$(/bin/ps -o rss= -p "${pid1:-0}" 2>/dev/null | tr -d ' ')"; [[ "$rss" =~ ^[0-9]+$ ]] && rss=$(( rss / 1024 )) || rss=-1
  printf '{"version":1,"at":%s,"pid":%s,"footprint_mb":%s,"compressed_mb":%s,"resident_mb":%s,"pressure":%s}\n' "$(now)" "${pid1:-0}" "$M_FSEV_MB" "$M_FSEV_CMP" "$rss" "$M_LEVEL" > "$STATE/fseventsd-baseline.json" && chmod 644 "$STATE/fseventsd-baseline.json"
  rm -f "$REPAIR_DIR/restart-deferred" "$REPAIR_DIR/recovery-failed"
  echo $(( $(now) + 600 )) > "$REPAIR_DIR/notice-until"
  echo "$(now) $(clean "$result" 80)" > "$REPAIR_DIR/last-restart"
  audit restart-fseventsd ran "result=$result trigger=$TRIGGER before_mb=$before_mb before_compressed_mb=$before_cmp after_mb=$M_FSEV_MB pid_before=$pid0 pid_after=${pid1:-none}"
}

write_shed_flag() { # reason
  local since; since="$(jget "$STATE/dev-shed" since)"; [[ "$since" =~ ^[0-9]+$ ]] || since="$(now)"
  printf '{"version":1,"since":%s,"updated_at":%s,"reason":"%s"}\n' "$since" "$(now)" "$(clean "$1" 200)" > "$STATE/dev-shed.tmp" && mv "$STATE/dev-shed.tmp" "$STATE/dev-shed" && chmod 644 "$STATE/dev-shed"
}
write_flag() { # name reason
  local since; since="$(jget "$STATE/$1" since)"; [[ "$since" =~ ^[0-9]+$ ]] || since="$(now)"
  printf '{"version":1,"since":%s,"updated_at":%s,"reason":"%s"}\n' "$since" "$(now)" "$(clean "$2" 200)" > "$STATE/$1.tmp" && mv "$STATE/$1.tmp" "$STATE/$1" && chmod 644 "$STATE/$1"
}
# The test sharder halves its worker cap while this flag is fresh (scripts/gate/shardTests.ts sourceThrottleCap).
act_source_throttle() { record_run source-throttle set; write_flag source-throttle "file-event service grew ${M_GROWTH10} MB in 10 min"; audit source-throttle ran "set; $(mem_counts)"; }
source_throttle_maintain() {
  [[ -f "$STATE/source-throttle" ]] || return 0
  if (( R_OFF )) || [[ $R_MODE != live ]]; then rm -f "$STATE/source-throttle"; audit source-throttle cleared "kill switch or repair mode $R_MODE"; return 0; fi
  if (( M_GROWTH10 >= THROTTLE_GROWTH_MB )); then write_flag source-throttle "file-event service grew ${M_GROWTH10} MB in 10 min"; return 0; fi
  if (( H_SLOW >= 600 )); then rm -f "$STATE/source-throttle"; audit source-throttle cleared "growth below 1 GB in 10 min for 10 minutes; $(mem_counts)"; fi
}
act_dev_shed() { record_run dev-shed set; write_shed_flag "pressure level $M_LEVEL for $(( H_PRESS / 60 )) min"; audit dev-shed ran "set; $(mem_counts)"; }
# A set flag is refreshed while the pressure lasts and cleared after 5 calm minutes, or at once by the kill switch or repair mode off.
dev_shed_maintain() {
  [[ -f "$STATE/dev-shed" ]] || return 0
  if (( R_OFF )) || [[ $R_MODE != live ]]; then rm -f "$STATE/dev-shed"; audit dev-shed cleared "kill switch or repair mode $R_MODE"; return 0; fi
  if [[ -f "$REPAIR_DIR/restart-deferred" ]]; then write_shed_flag "file-event service restart deferred ($(clean "$(cat "$REPAIR_DIR/restart-deferred")" 80))"; return 0; fi
  if [[ -f "$REPAIR_DIR/recovery-failed" ]]; then write_shed_flag "file watching did not recover in $R_FAIL dev hub(s) after the restart"; return 0; fi
  if (( M_LEVEL >= 2 )); then write_shed_flag "pressure level $M_LEVEL for $(( H_PRESS / 60 )) min"; return 0; fi
  if (( H_CALM >= 300 )); then rm -f "$STATE/dev-shed"; audit dev-shed cleared "pressure below 2 for 5 minutes; $(mem_counts)"; fi
}

# Recovery check results, written as the owner by each dev hub's checker (scripts/dev/fseventsRecovery.ts, run by dev.sh after its hub
# restarted) into <data_dir>/host-guard/recovery/. Only small validated fields are read: the restart they answer and pass or fail.
recovery_read() {
  local rs d f c r
  R_CHECKED=0; R_PASS=0; R_FAIL=0
  rs="$(jget "$STATE/fsevents-restarted" restarted_at)"; [[ "$rs" =~ ^[0-9]+$ ]] || return 0
  d="$DATA/host-guard/recovery"; [[ -d "$d" && ! -L "$d" ]] || return 0
  for f in "$d"/*.json; do
    [[ -f "$f" && ! -L "$f" ]] || continue
    (( R_CHECKED < 50 )) || break
    c="$(jget "$f" restarted_at)"; r="$(jget "$f" result)"
    [[ "$c" == "$rs" ]] || continue
    case "$r" in pass) R_PASS=$((R_PASS+1)) ;; fail) R_FAIL=$((R_FAIL+1)) ;; *) continue ;; esac
    R_CHECKED=$((R_CHECKED+1))
  done
  if (( R_FAIL > 0 )); then
    if [[ ! -f "$REPAIR_DIR/recovery-failed" ]]; then audit recovery failed "file watching did not recover in $R_FAIL of $R_CHECKED dev hubs after the restart at $rs"; fi
    echo "$rs" > "$REPAIR_DIR/recovery-failed"
    if (( ! R_OFF )) && [[ $R_MODE == live ]]; then write_shed_flag "file watching did not recover in $R_FAIL dev hub(s) after the restart"; fi
  elif [[ -f "$REPAIR_DIR/recovery-failed" ]]; then
    rm -f "$REPAIR_DIR/recovery-failed"; audit recovery passed "file watching recovered in $R_PASS dev hubs"
  fi
  printf '{"version":1,"restarted_at":%s,"checked_at":%s,"hubs":%s,"passed":%s,"failed":%s}\n' "$rs" "$(now)" "$R_CHECKED" "$R_PASS" "$R_FAIL" > "$STATE/fsevents-recovery.json" && chmod 644 "$STATE/fsevents-recovery.json"
}

# Landings and ships in the last hour from the development data folder (optional, config.json dev_data). Timestamps only are read.
dev_counts() {
  local d="$DEV_DATA" cut cut_iso f l=-1 s=-1
  if [[ -n "$d" ]]; then
    cut=$(( $(now) - 3600 )); cut_iso="$(date -u -r "$cut" +%Y-%m-%dT%H:%M:%SZ)"
    f="$d/land/landings.jsonl"; if [[ -f "$f" && ! -L "$f" ]]; then l="$(tail -n 400 "$f" | sed -n 's/^{"ts": *"\([0-9TZ:-]*\)".*/\1/p' | awk -v c="$cut_iso" '$1 >= c' | wc -l | tr -d ' ')"; fi
    f="$d/ship/shipped.jsonl"; if [[ -f "$f" && ! -L "$f" ]]; then s="$(tail -n 400 "$f" | sed -n 's/^{"ts":\([0-9]*\),.*/\1/p' | awk -v c="$cut" '$1 >= c' | wc -l | tr -d ' ')"; fi
  fi
  D_LAND="$l"; D_SHIP="$s"
}

gb() { awk -v m="$1" 'BEGIN { printf "%.1f", m / 1024 }'; }
write_memory_status() {
  local top="" pid name mb cmp n=0 summary="" notice="" nu shed=false big_name="" big_mb=0 rr last_restart
  while IFS=$'\t' read -r pid name mb cmp; do
    [[ "$pid" =~ ^[0-9]+$ && "$mb" =~ ^[0-9]+$ && "$cmp" =~ ^[0-9]+$ ]] || continue
    (( n == 0 )) && { big_name="$name"; big_mb="$mb"; }
    (( n < 5 )) && top+="${top:+,}{\"pid\":$pid,\"name\":\"$name\",\"footprint_mb\":$mb,\"compressed_mb\":$cmp}"
    n=$((n+1))
  done <<< "$M_TOP"
  nu="$(read_int "$REPAIR_DIR/notice-until")"; (( nu > $(now) )) && notice="$NOTICE_TEXT" || nu=0
  [[ -f "$STATE/dev-shed" ]] && shed=true
  rr="$(cat "$REPAIR_DIR/last-restart" 2>/dev/null)"; last_restart="$(clean "${rr#* }" 80)"; rr="${rr%% *}"; [[ "$rr" =~ ^[0-9]+$ ]] || rr=0
  if (( M_LEVEL >= 2 )); then summary="Memory pressure level $M_LEVEL for $(( H_PRESS / 60 )) min"; else summary="Memory pressure normal"; fi
  (( M_SWAP_TOTAL > 0 )) && summary+="; swap $(gb "$M_SWAP_USED") of $(gb "$M_SWAP_TOTAL") GB"
  (( M_COMP >= 0 )) && summary+="; compressed $(gb "$M_COMP") GB"
  [[ -n "$big_name" ]] && summary+="; biggest: $big_name $(gb "$big_mb") GB"
  (( M_FSEV_MB >= R_CAPT_MB )) && summary+="; file-event service $(gb "$M_FSEV_MB") GB ($(gb "$M_FSEV_CMP") GB compressed)"
  (( M_GROWTH10 >= THROTTLE_GROWTH_MB )) && summary+="; file-event service grew $(gb "$M_GROWTH10") GB in 10 min"
  [[ -f "$STATE/source-throttle" ]] && summary+="; test workers halved"
  [[ $shed == true ]] && summary+="; heavy development work paused"
  local alert="" bl_pid bl_mb since_bl=-1
  if [[ -f "$REPAIR_DIR/restart-deferred" ]]; then
    alert="File-event service at $(gb "$M_FSEV_MB") GB, grew $(gb "$M_GROWTH10") GB in 10 min; its restart waits: $(clean "$(cat "$REPAIR_DIR/restart-deferred")" 80). New builds and tests are paused."
  elif [[ -f "$REPAIR_DIR/recovery-failed" ]]; then
    alert="File watching did not recover in $R_FAIL dev hub(s) after the file-event service restart. New builds and tests stay paused until those hubs restart (bash scripts/dev.sh stop, then start)."
  fi
  bl_pid="$(jget "$STATE/fseventsd-baseline.json" pid)"; bl_mb="$(jget "$STATE/fseventsd-baseline.json" footprint_mb)"
  if [[ "$bl_pid" == "$M_FSEV_PID" && "$bl_mb" =~ ^[0-9]+$ ]]; then since_bl=$(( M_FSEV_MB - bl_mb )); fi
  printf '{"version":1,"checked_at":%s,"pressure":%s,"pressure_held_s":%s,"free_pct":%s,"swap_used_mb":%s,"swap_total_mb":%s,"compressor_mb":%s,"top":[%s],"fseventsd":{"pid":%s,"footprint_mb":%s,"compressed_mb":%s,"growth_10min_mb":%s,"group_list_per_min":%s,"growth_since_baseline_mb":%s},"source_throttle":%s,"alert":"%s","recovery":{"hubs":%s,"passed":%s,"failed":%s},"landings_1h":%s,"ships_1h":%s,"repair_mode":"%s","kill_switch":%s,"dev_shed":%s,"notice":"%s","notice_until":%s,"last_restart_at":%s,"last_restart_result":"%s","summary":"%s"}\n' \
    "$(now)" "$M_LEVEL" "$H_PRESS" "$M_FREE" "$M_SWAP_USED" "$M_SWAP_TOTAL" "$M_COMP" "$top" "${M_FSEV_PID:-0}" "$M_FSEV_MB" "$M_FSEV_CMP" "$M_GROWTH10" "$M_CALLS" "$since_bl" "$( [[ -f "$STATE/source-throttle" ]] && echo true || echo false)" "$(clean "$alert" 300)" "$R_CHECKED" "$R_PASS" "$R_FAIL" \
    "$D_LAND" "$D_SHIP" "$R_MODE" "$( ((R_OFF)) && echo true || echo false)" "$shed" "$notice" "$nu" "$rr" "$last_restart" "$(clean "$summary" 400)" > "$STATE/memory.json.tmp" \
    && mv "$STATE/memory.json.tmp" "$STATE/memory.json" && chmod 644 "$STATE/memory.json"
  local f="$STATE/memory.csv"
  [[ -s "$f" ]] || echo "ts,pressure,free_pct,swap_used_mb,swap_total_mb,compressor_mb,fseventsd_mb,fseventsd_compressed_mb,growth_10min_mb,group_list_per_min,top_name,top_mb,landings_1h,ships_1h" > "$f"
  echo "$(now),$M_LEVEL,$M_FREE,$M_SWAP_USED,$M_SWAP_TOTAL,$M_COMP,$M_FSEV_MB,$M_FSEV_CMP,$M_GROWTH10,$M_CALLS,${big_name// /_},$big_mb,$D_LAND,$D_SHIP" >> "$f"; chmod 644 "$f"
  [[ $(stat -f %z "$f" 2>/dev/null || echo 0) -gt 5000000 ]] && { tail -n 20000 "$f" > "$f.tmp"; head -1 "$f" | cat - "$f.tmp" > "$f.new"; mv "$f.new" "$f"; rm -f "$f.tmp"; chmod 644 "$f"; }
  return 0
}

cmd_memory() {
  mkdir -p "$REPAIR_DIR"; chmod 755 "$REPAIR_DIR"
  load_repair; mem_probe; signals; dev_counts; recovery_read
  local id
  for id in ${MAIPAI_HG_REMEDIES:-$REMEDIES}; do
    remedy_consider "$id"
    # A restart re-probed the Mac; the later actions see the new numbers.
    [[ $id == restart-fseventsd ]] && signals
  done
  source_throttle_maintain
  dev_shed_maintain
  write_memory_status
}

# --- evidence capture for the file-event daemon (root; raw output root-only, a world-readable digest of counts) ---
pairs_json() { tr -d '\\"\000-\011\013-\037' | awk 'BEGIN { printf "[" } NF >= 2 && $1 ~ /^[0-9]+$/ { n = $1; $1 = ""; sub(/^ /, ""); printf "%s[\"%s\",%d]", (c++ ? "," : ""), substr($0, 1, 80), n } END { printf "]" }'; }
lines_json() { tr -d '\\"\000-\011\013-\037' | awk 'BEGIN { printf "[" } { printf "%s\"%s\"", (c++ ? "," : ""), substr($0, 1, 160) } END { printf "]" }'; }
# fs_usage -w lines end in process.thread; the first field that starts with / is the path. Only counts leave this function:
# per process name, and per path bucket (a worktree folder name, node_modules, .git, or a broad area), never a full path.
agg_fs_usage() {
  awk '{ proc = $NF; sub(/\.[0-9]+$/, "", proc); gsub(/[^A-Za-z0-9 ._()-]/, "", proc); if (proc == "") next
         total++; pc[proc]++; path = ""
         for (i = 2; i < NF; i++) if (substr($i, 1, 1) == "/") { path = $i; break }
         if (path == "") next
         if (match(path, /\/wt\/[^\/]+/)) b = "wt/" substr(path, RSTART + 4, RLENGTH - 4)
         else if (path ~ /node_modules/) b = "node_modules"
         else if (path ~ /\/\.git(\/|$)/) b = ".git"
         else if (path ~ /^\/usr\/local\/maipai-home/) b = "maipai-home install"
         else if (path ~ /^\/Users\/[^\/]+\/Developer\//) b = "Developer (other)"
         else if (path ~ /^\/Users\//) b = "home folders (other)"
         else if (path ~ /^\/(private\/)?var\//) b = "var"
         else if (path ~ /^\/System\//) b = "System"
         else if (path ~ /^\/Library\//) b = "Library"
         else b = "other"
         gsub(/[^A-Za-z0-9 ._()\/-]/, "", b); bc[b]++ }
       END { printf "total %d\n", total; for (k in pc) printf "proc %d %s\n", pc[k], k; for (k in bc) printf "path %d %s\n", bc[k], k }'
}
rotate_caps() {
  local d n
  for d in $(ls -1 "$CAPS" 2>/dev/null | sort -r | tail -n +4); do [[ "$d" =~ ^[0-9]{8}-[0-9]{6}$ ]] && rm -rf "${CAPS:?}/$d"; done
  n=0
  while (( $(du -sk "$CAPS" 2>/dev/null | awk '{print $1}') > 307200 && n < 3 )); do
    d="$(ls -1 "$CAPS" | sort | head -n 1)"; [[ "$d" =~ ^[0-9]{8}-[0-9]{6}$ ]] || break
    (( $(ls -1 "$CAPS" | wc -l) > 1 )) || break
    rm -rf "${CAPS:?}/$d"; n=$((n+1))
  done
}
cmd_capture_fsevents() { # pid full|quick
  local pid="$1" quick=0 dir rc_vm rc_log rc_fp t fs_s
  [[ "${2:-}" == quick ]] && quick=1
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || pid="$(with_timeout 5 "$(tp /usr/bin/pgrep)" -x fseventsd 2>/dev/null | head -n 1)"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || { log "fsevents capture: no fseventsd process"; return 1; }
  load_repair; mkdir -p "$CAPS" "$REPAIR_DIR"; chmod 700 "$CAPS"
  umask 077
  dir="$CAPS/$(date -u -r "$(now)" +%Y%m%d-%H%M%S)"; mkdir -p "$dir"
  # Raw outputs, each with a hard limit; a file is cut at 100 MB.
  with_timeout $(( quick ? 15 : 60 )) "$(tp /usr/bin/vmmap)" -summary "$pid" 2>&1 | head -c 104857600 > "$dir/vmmap.txt"; rc_vm=${PIPESTATUS[0]}
  # The full region list too (it names where the leak sits); not in a quick capture.
  (( quick )) || { with_timeout 180 "$(tp /usr/bin/vmmap)" "$pid" 2>&1 | head -c 209715200 > "$dir/vmmap-full.txt"; }
  with_timeout $(( quick ? 25 : 120 )) "$(tp /usr/bin/log)" show --last "$( ((quick)) && echo 30m || echo 2h)" --style compact --predicate 'process == "fseventsd"' 2>&1 | head -c 104857600 > "$dir/log-fseventsd.txt"; rc_log=${PIPESTATUS[0]}
  # heap and leaks walk every allocation; only on a small daemon (on a huge one they pull everything back from swap).
  local fp_mb walked=false
  fp_mb="$(with_timeout 15 "$(tp /usr/bin/top)" -l 1 -pid "$pid" -stats pid,command,mem,cmprs 2>/dev/null | parse_top | awk -F'\t' 'NR == 1 { print $3 }')"
  if (( ! quick )) && [[ "$fp_mb" =~ ^[0-9]+$ ]] && (( fp_mb < WALK_MAX_MB )); then
    walked=true
    with_timeout 180 "$(tp /usr/bin/heap)" "$pid" 2>&1 | head -c 52428800 > "$dir/heap.txt"
    with_timeout 300 "$(tp /usr/bin/leaks)" --nostacks "$pid" 2>&1 | head -c 52428800 > "$dir/leaks.txt"
  fi
  with_timeout 20 "$(tp /usr/bin/footprint)" "$pid" > "$dir/footprint.txt" 2>&1; rc_fp=$?
  with_timeout 15 "$(tp /usr/bin/top)" -l 1 -o mem -n 15 -stats pid,command,mem,cmprs > "$dir/top.txt" 2>&1
  { with_timeout 5 "$(tp /usr/sbin/sysctl)" vm.swapusage kern.memorystatus_vm_pressure_level; with_timeout 10 "$(tp /usr/bin/vm_stat)"; } > "$dir/system.txt" 2>&1
  with_timeout 10 "$(tp /bin/launchctl)" print system/com.apple.fseventsd > "$dir/launchctl.txt" 2>&1
  if (( ! quick )); then
    with_timeout 60 "$(tp /usr/bin/log)" show --last 2h --style compact --predicate 'process == "mds"' 2>&1 | head -c 52428800 > "$dir/log-mds.txt"
    with_timeout 60 "$(tp /usr/bin/log)" show --last 2h --style compact --predicate 'subsystem == "com.apple.FSEvents"' 2>&1 | head -c 52428800 > "$dir/log-fsevents-subsystem.txt"
    fs_s="${MAIPAI_HG_FS_USAGE_SECONDS:-15}"; [[ "$fs_s" =~ ^[0-9]{1,2}$ ]] || fs_s=15
    # fs_usage runs until the limit ends it; only the counts are kept.
    with_timeout "$fs_s" "$(tp /usr/bin/fs_usage)" -w -f filesys 2>/dev/null | agg_fs_usage > "$dir/fs_usage-counts.txt"
    with_timeout 45 "$(tp /usr/sbin/lsof)" -n -P -w -F pcf 2>/dev/null | awk '/^c/ { c = substr($0, 2) } /^f/ { n[c]++ } END { for (k in n) print n[k], k }' | sort -rn | head -n 15 > "$dir/open-files-by-process.txt"
    with_timeout 20 "$(tp /usr/sbin/lsof)" -n -P -w -F c /dev/fsevents 2>/dev/null | sed -n 's/^c//p' | sort | uniq -c | sort -rn | head -n 15 > "$dir/fsevents-clients.txt"
    # The daemon's own open files, counted by type (no names). No tool lists the FSEvents streams per client without SIP changes.
    with_timeout 30 "$(tp /usr/sbin/lsof)" -n -P -w -p "$pid" -F t 2>/dev/null | sed -n 's/^t//p' | sort | uniq -c | sort -rn | head -n 15 > "$dir/fseventsd-open-files-by-type.txt"
  fi
  # Build activity: timestamps only, from the development data folder when one is configured.
  { if [[ -n "$DEV_DATA" && -f "$DEV_DATA/land/landings.jsonl" && ! -L "$DEV_DATA/land/landings.jsonl" ]]; then tail -n 200 "$DEV_DATA/land/landings.jsonl" | sed -n 's/^{"ts": *"\([0-9TZ:-]*\)".*/landing \1/p' | tail -n 40; fi
    if [[ -n "$DEV_DATA" && -f "$DEV_DATA/ship/shipped.jsonl" && ! -L "$DEV_DATA/ship/shipped.jsonl" ]]; then tail -n 100 "$DEV_DATA/ship/shipped.jsonl" | sed -n 's/^{"ts":\([0-9]*\),.*/ship \1/p' | tail -n 20; fi; } > "$dir/activity.txt"

  local fp_line top1 vm_lines logc errs faults drops calls mds fsub fs_total fs_proc fs_path openf clients state runs complete=false
  fp_line="$(grep -m1 '^Physical footprint:' "$dir/vmmap.txt" | awk '{print $3}')"
  top1="$(parse_top < "$dir/top.txt" | awk -F'\t' '$2 == "fseventsd" { print $3 "\t" $4; exit }')"
  vm_lines="$(grep -E '^(Physical footprint|Writable regions|Malloc Small|Malloc Tiny|Malloc Large|MALLOC_SMALL|MALLOC_TINY|DefaultMallocZone|TOTAL)' "$dir/vmmap.txt" | grep -v '/' | head -n 20 | lines_json)"
  logc="$(grep -c . "$dir/log-fseventsd.txt" 2>/dev/null)"; errs="$(awk '$3 ~ /^E/' "$dir/log-fseventsd.txt" | wc -l | tr -d ' ')"
  faults="$(awk '$3 ~ /^F/' "$dir/log-fseventsd.txt" | wc -l | tr -d ' ')"; calls="$(grep -c "$GROUP_LIST_MSG" "$dir/log-fseventsd.txt" 2>/dev/null)"
  drops="$(grep -ciE 'dropp|overflow|must ?scan' "$dir/log-fseventsd.txt" 2>/dev/null)"
  mds="$(grep -c . "$dir/log-mds.txt" 2>/dev/null)"; fsub="$(grep -c . "$dir/log-fsevents-subsystem.txt" 2>/dev/null)"
  fs_total="$(sed -n 's/^total //p' "$dir/fs_usage-counts.txt" 2>/dev/null)"
  fs_proc="$(sed -n 's/^proc //p' "$dir/fs_usage-counts.txt" 2>/dev/null | sort -rn | head -n 15 | pairs_json)"
  fs_path="$(sed -n 's/^path //p' "$dir/fs_usage-counts.txt" 2>/dev/null | sort -rn | head -n 20 | pairs_json)"
  openf="$(pairs_json < "$dir/open-files-by-process.txt" 2>/dev/null)"; clients="$(pairs_json < "$dir/fsevents-clients.txt" 2>/dev/null)"
  local leaks_line heap_lines ofiles
  leaks_line="$(grep -m1 -E 'leaks? for [0-9]+ total leaked bytes' "$dir/leaks.txt" 2>/dev/null | sed 's/^Process [0-9]*: //')"
  heap_lines="$(grep -E '^(All zones|Zone )' "$dir/heap.txt" 2>/dev/null | grep -v '/' | head -n 15 | lines_json)"
  ofiles="$(pairs_json < "$dir/fseventsd-open-files-by-type.txt" 2>/dev/null)"
  state="$(sed -n 's/^[[:space:]]*state = \([a-z ]*\)$/\1/p' "$dir/launchctl.txt" | head -n 1)"; runs="$(sed -n 's/^[[:space:]]*runs = \([0-9]*\)$/\1/p' "$dir/launchctl.txt" | head -n 1)"
  if (( rc_vm == 0 && rc_log == 0 )) && [[ -n "$fp_line" ]]; then complete=true; fi
  num() { [[ "$1" =~ ^[0-9]+$ ]] && echo "$1" || echo 0; }
  printf '{"version":1,"captured_at":%s,"mode":"%s","complete":%s,"pid":%s,"vmmap_footprint":"%s","top_footprint_mb":%s,"top_compressed_mb":%s,"vmmap":%s,"walked":%s,"leaks":"%s","heap":%s,"fseventsd_open_files_by_type":%s,"log_2h":{"fseventsd_lines":%s,"errors":%s,"faults":%s,"group_list_calls":%s,"dropped_or_rescan_lines":%s,"mds_lines_2h":%s,"fsevents_subsystem_lines_2h":%s},"fs_usage":{"seconds":%s,"events":%s,"by_process":%s,"by_path":%s},"open_files_by_process":%s,"fsevents_clients":%s,"launchd":{"state":"%s","runs":%s},"activity":%s,"steps":{"vmmap":%s,"log":%s,"footprint":%s}}\n' \
    "$(now)" "$( ((quick)) && echo quick || echo full)" "$complete" "$pid" "$(clean "$fp_line" 20)" "$(num "$(cut -f1 <<< "$top1")")" "$(num "$(cut -f2 <<< "$top1")")" "$vm_lines" \
    "$walked" "$(clean "$leaks_line" 160)" "${heap_lines:-[]}" "${ofiles:-[]}" "$(num "$logc")" "$(num "$errs")" "$(num "$faults")" "$(num "$calls")" "$(num "$drops")" "$(num "$mds")" "$(num "$fsub")" \
    "$( ((quick)) && echo 0 || echo "$fs_s")" "$(num "$fs_total")" "${fs_proc:-[]}" "${fs_path:-[]}" "${openf:-[]}" "${clients:-[]}" "$(clean "$state" 20)" "$(num "$runs")" \
    "$(lines_json < "$dir/activity.txt")" "$rc_vm" "$rc_log" "$rc_fp" > "$dir/digest.json"
  umask 022
  cp "$dir/digest.json" "$STATE/fsevents-digest.json.tmp" && mv "$STATE/fsevents-digest.json.tmp" "$STATE/fsevents-digest.json" && chmod 644 "$STATE/fsevents-digest.json"
  if [[ $complete == true ]]; then : > "$dir/COMPLETE"; now > "$REPAIR_DIR/capture-ok"; fi
  rotate_caps
  log "fsevents capture: $dir complete=$complete"
  [[ $complete == true ]]
}

cmd_mode() {
  case "${1:-}" in off|dry|live) ;; *) echo "usage: mode off|dry|live" >&2; exit 2 ;; esac
  mkdir -p "$STATE"
  local t="$STATE/tuning.json" h m x
  h="$(clamp "$(jget "$t" hard_minutes)" 2 30 3)"; m="$(clamp "$(jget "$t" metal_minutes)" 5 120 10)"; x="$(clamp "$(jget "$t" max_reboots_per_12h)" 0 3 2)"
  printf '{"mode":"%s","hard_minutes":%s,"metal_minutes":%s,"max_reboots_per_12h":%s}\n' "$1" "$h" "$m" "$x" > "$t.tmp" && mv "$t.tmp" "$t"
  chown root:admin "$t" 2>/dev/null; chmod 664 "$t"; log "mode set to $1"; echo "mode: $1"
}
cmd_uninstall() {
  /bin/launchctl bootout system/com.maipai.host-guard 2>/dev/null
  rm -f "$PLIST" "$SUDOERS" "$SELF_PATH"
  log "uninstalled (captures kept in $STATE/captures)"
}

case "${1:-}" in
  run) cmd_run ;;
  status) cat "$STATE/status.json" 2>/dev/null || echo '{"version":1,"note":"no run yet"}' ;;
  mode) cmd_mode "${2:-}" ;;
  telemetry) load_tuning; load_config && telemetry "${2:-0}" "${3:-0}" ;;
  memory) load_tuning; load_config && cmd_memory ;;
  capture-fsevents) load_tuning; load_config && cmd_capture_fsevents "${2:-0}" "${3:-full}" ;;
  memory-status) cat "$STATE/memory.json" 2>/dev/null || echo '{"version":1,"summary":"no memory probe yet"}' ;;
  capture) load_tuning; load_config || { echo "config.json missing or invalid" >&2; exit 1; }; mkdir -p "$STATE/captures"; capture ;;
  uninstall) cmd_uninstall ;;
  *) echo "usage: maipai-host-guard run|status|memory-status|mode off|dry|live|capture|uninstall" >&2; exit 2 ;;
esac
