{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-coder/local-coder",
  "agent": {
    "title": { "disable": true },
    "summary": { "disable": true },
    "compaction": { "disable": true }
  },
  "compaction": {
    "auto": false,
    "prune": false
  },
  "small_model": "local-coder/local-coder",
  "autoupdate": false,
  "enabled_providers": ["local-coder"],
  "provider": {
    "local-coder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local coder (llama.cpp)",
      "options": {
        "baseURL": "http://127.0.0.1:54800/v1",
        "apiKey": "not-needed"
      },
      "models": {
        "local-coder": {
          "name": "Local coder",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "*": "deny",
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow"
    },
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "bash": {
      "*": "deny",
      "pwd": "allow",
      "ls *": "allow",
      "rg *": "allow",
      "cat *": "allow",
      "sed *": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git push*": "deny",
      "git fetch*": "deny",
      "git pull*": "deny",
      "curl *": "deny",
      "wget *": "deny",
      "http *": "deny",
      "https *": "deny",
      "bun *": "allow",
      "npm *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "tmux *": "allow"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "external_directory": "deny"
  }
}
